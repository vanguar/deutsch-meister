      "s": [
        {
          "de": "Der Name kommt von einer Burg an der Havel: der Brandenburg.",
          "ru": "Название происходит от крепости на Хафеле — Бранденбург.",
          "g": {
            "1": "название",
            "2": "происходит",
            "3": "от",
            "5": "крепости",
            "6-8": "на Хафеле"
          }
        },
        {
          "de": "1157 eroberte Albrecht der Bär diese Burg.",
          "ru": "В 1157 году Альбрехт Медведь захватил эту крепость.",
          "g": {
            "0": "захватил",
            "1-3": "Альбрехт Медведь",
            "4": "эту",
            "5": "крепость"
          }
        },
        {
          "de": "Dieses Jahr gilt als Geburtsjahr der Mark Brandenburg.",
          "ru": "Этот год считается годом рождения Бранденбургской марки.",
          "g": {
            "0": "этот",
            "1": "год",
            "2+3": "считается",
            "4": "год рождения",
            "6": "марка (пограничная земля)"
          }
        },
        {
          "de": "Ab 1415 regierten hier die Hohenzollern.",
          "ru": "С 1415 года здесь правили Гогенцоллерны.",
          "g": {
            "0": "с",
            "1": "правили",
            "2": "здесь",
            "4": "Гогенцоллерны"
          }
        }
      ]
    },
    {
      "fig": {
        "w": 1200,
        "h": 846,
        "cap": "Собор Святых Петра и Павла в городе Бранденбург-на-Хафеле.",
        "credit": "Mathias Krumbholz / Wikimedia Commons · CC BY-SA 3.0",
        "src": "data/laender/brandenburg/img/dom.jpg"
      }
    },
    {
      "s": [
        {
          "de": "Später wurde Brandenburg das Kernland von Preußen.",
          "ru": "Позже Бранденбург стал ядром Пруссии.",
          "g": {
            "0": "позже",
            "1": "стал",
            "4": "ядро страны",
            "5-6": "Пруссии"
          }
        },
        {
          "de": "Nach dem Zweiten Weltkrieg kam das Gebiet östlich der Oder zu Polen.",
          "ru": "После Второй мировой войны территория к востоку от Одера отошла к Польше.",
          "g": {
            "0": "после",
            "2-3": "Второй мировой войны",
            "4": "пришла",
            "6": "территория",
            "7": "к востоку",
            "9": "Одера",
            "10-11": "к Польше"
          }
        },
        {
          "de": "In der DDR gab es kein Land Brandenburg mehr, nur drei Bezirke.",
          "ru": "В ГДР земли Бранденбург больше не было, только три округа.",
          "g": {
            "2": "ГДР",
            "3+4": "было",
            "5": "никакой",
            "6": "земли",
            "8": "больше",
            "9": "только",
            "10": "три",
            "11": "округа"
          }
        },
        {
          "de": "Am 3. Oktober 1990 wurde das Land neu gegründet.",
          "ru": "3 октября 1990 года земля была основана заново.",
          "g": {
            "1": "октября",
            "2+6": "была основана",
            "4": "земля",
            "5": "заново"
          }
        }
      ]
