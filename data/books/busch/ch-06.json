{
  "id": "ch-06",
  "title": "Fünfter Streich",
  "titleRu": "Проделка пятая",
  "paragraphs": [
    {
      "s": [
        {
          "de": "Wer in Dorfe oder Stadt",
          "ru": "У кого в деревне или в городе",
          "rv": "Если в городе, в селе"
        },
        {
          "de": "Einen Onkel wohnen hat,",
          "ru": "живёт дядюшка,",
          "rv": "дядя есть в твоей семье,"
        },
        {
          "de": "Der sei höflich und bescheiden,",
          "ru": "тот пусть будет вежлив и скромен,",
          "rv": "будь учтив и будь смирён —"
        },
        {
          "de": "Denn das mag der Onkel leiden. –",
          "ru": "ведь это дядюшке по нраву. –",
          "rv": "дядя тем и умилён. –"
        },
        {
          "de": "– Morgens sagt man: »Guten Morgen!",
          "ru": "– Утром говорят: «Доброе утро!",
          "rv": "– Утром скажешь: «Добрый день!"
        },
        {
          "de": "Haben Sie was zu besorgen?«",
          "ru": "Не нужно ли чего исполнить?»",
          "rv": "Есть ли дело? Мне не лень!»"
        }
      ]
    },
    {
      "s": [
        {
          "de": "Bringt ihm, was er haben muss:",
          "ru": "Приносят ему, что ему требуется:",
          "rv": "Принесёшь ему, дружок,"
        },
        {
          "de": "Zeitung, Pfeife, Fidibus. –",
          "ru": "газету, трубку, фидибус. –",
          "rv": "трубку, фидибус, листок. –"
        },
        {
          "de": "Oder sollt’ es wo im Rücken",
          "ru": "А если вдруг где-нибудь в спине",
          "rv": "А случись, в спине зудит,"
        },
        {
          "de": "Drücken, beißen oder zwicken,",
          "ru": "заломит, засвербит или защемит,",
          "rv": "щиплет, ноет и болит, —"
        },
        {
          "de": "Gleich ist man mit Freudigkeit",
          "ru": "тут же с готовностью",
          "rv": "тут же ты, душою мил,"
        },
        {
          "de": "Dienstbeflissen und bereit. –",
          "ru": "все услужливы и наготове. –",
          "rv": "услужить готов что сил. –"
        }
      ]
    },
    {
      "s": [
        {
          "de": "Oder sei’s nach einer Prise,",
          "ru": "Или если после понюшки табаку",
          "rv": "Иль понюшка табаку —"
        },
        {
          "de": "Dass der Onkel heftig niese,",
          "ru": "дядюшка громко чихнёт,",
          "rv": "дядя чихнёт: «Ап-чху!»,"
        },
        {
          "de": "Ruft man »Prosit!« alsogleich,",
          "ru": "тут же кричат: «Будьте здоровы!»",
          "rv": "тут же крикнешь: «Будь здоров!»"
        },
        {
          "de": "»Danke! wohl bekomm’ es Euch!!« –",
          "ru": "«Спасибо! и вам на здоровье!!» –",
          "rv": "— «Благодарствую, готов!!» –"
        },
        {
          "de": "Oder kommt er spät nach Haus,",
          "ru": "Или если он приходит домой поздно,",
          "rv": "Или поздно он вернётся —"
        },
        {
          "de": "Zieht man ihm die Stiefel aus,",
          "ru": "с него стягивают сапоги,",
          "rv": "сапоги стянуть придётся,"
        }
      ]
    },
    {
      "s": [
        {
          "de": "Holt Pantoffel, Schlafrock, Mütze,",
          "ru": "несут туфли, халат, колпак,",
          "rv": "туфли, шлафрок и колпак —"
        },
        {
          "de": "Dass er nicht im Kalten sitze –",
          "ru": "чтобы он не сидел в холоде –",
          "rv": "чтоб не мёрз он тут никак, —"
        },
        {
          "de": "Kurz, man ist darauf bedacht,",
          "ru": "словом, только и думают о том,",
          "rv": "словом, вся твоя забота —"
        },
        {
          "de": "Was dem Onkel Freude macht. –",
          "ru": "чем бы дядюшке угодить. –",
          "rv": "дяде в радость хоть бы что-то. –"
        },
        {
          "de": "– Max und Moritz ihrerseits",
          "ru": "– Макс и Мориц со своей стороны",
          "rv": "– Ну, а нашим-то двоим"
        },
        {
          "de": "Fanden darin keinen Reiz. –",
          "ru": "ничего заманчивого в этом не нашли. –",
          "rv": "не по нраву быть таким. –"
        }
      ]
    },
    {
      "s": [
        {
          "de": "Denkt euch nur, welch’ schlechten Witz",
          "ru": "Подумайте только, какую скверную шутку",
          "rv": "Вот ведь шутка — просто срам! —"
        },
        {
          "de": "Machten sie mit Onkel Fritz! –",
          "ru": "сыграли они с дядюшкой Фрицем! –",
          "rv": "удружили дяде там! –"
        },
        {
          "de": "Jeder weiß, was so ein Mai-",
          "ru": "Всякий знает, что такое май-",
          "rv": "Всякий знает, что за май-"
        },
        {
          "de": "Käfer für ein Vogel sei. –",
          "ru": "ский жук за птица. –",
          "rv": "ский жучок — ты так и знай. –"
        },
        {
          "de": "In den Bäumen hin und her",
          "ru": "По деревьям туда-сюда",
          "rv": "По деревьям он ползёт,"
        },
        {
          "de": "Fliegt und kriecht und krabbelt er.",
          "ru": "он летает, ползает и копошится.",
          "rv": "и летает, и снуёт."
        }
      ]
    },
    {
      "s": [
        {
          "de": "Max und Moritz, immer munter,",
          "ru": "Макс и Мориц, всегда бодрые,",
          "rv": "Макс и Мориц, весельчаки,"
        },
        {
          "de": "Schütteln sie vom Baum herunter.",
          "ru": "стряхивают их с дерева.",
          "rv": "с веток их трясут в кульки;"
        },
        {
          "de": "In die Tüte von Papiere",
          "ru": "В бумажный кулёк",
          "rv": "а в бумажный тот кулёк"
        },
        {
          "de": "Sperren sie die Krabbeltiere. –",
          "ru": "запирают они этих ползучих тварей. –",
          "rv": "загнан весь ползучий полк. –"
        },
        {
          "de": "Fort damit, und in die Ecke",
          "ru": "Прочь с ними — и в угол,",
          "rv": "Прочь его — и в уголок,"
        },
        {
          "de": "Unter Onkel Fritzens Decke!!",
          "ru": "под одеяло дядюшки Фрица!!",
          "rv": "дяде Фрицу под бочок!!"
        }
      ]
    },
    {
      "s": [
        {
          "de": "Bald zu Bett geht Onkel Fritze",
          "ru": "Скоро идёт спать дядюшка Фрице",
          "rv": "Скоро дядя Фриц в кровать"
        },
        {
          "de": "In der spitzen Zippelmütze;",
          "ru": "в остроконечном ночном колпаке;",
          "rv": "лёг в колпак, и — почивать;"
        },
        {
          "de": "Seine Augen macht er zu,",
          "ru": "глаза он закрывает,",
          "rv": "глазки он закрыл свои,"
        },
        {
          "de": "Hüllt sich ein und schläft in Ruh.",
          "ru": "укутывается и спит спокойно.",
          "rv": "и укутался в тиши."
        },
        {
          "de": "Doch die Käfer, kritze kratze!",
          "ru": "Но жуки — шур-шур, скрёб-скрёб! —",
          "rv": "Но жуки — скреби-скребись! —"
        },
        {
          "de": "Kommen schnell aus der Matratze.",
          "ru": "быстро выбираются из матраса.",
          "rv": "из матраса поднялись."
        }
      ]
    },
    {
      "s": [
        {
          "de": "Schon fasst einer, der voran,",
          "ru": "Вот один, что впереди, хватает",
          "rv": "Первый цап, что был бойчей,"
        },
        {
          "de": "Onkel Fritzens Nase an.",
          "ru": "дядюшку Фрица за нос.",
          "rv": "дядю за нос — хоть убей!"
        },
        {
          "de": "»Bau!!« – schreit er – »Was ist das hier?!!«",
          "ru": "«Ай!! – кричит он. – Что это тут?!!»",
          "rv": "«Ай!! — кричит он. — Что за гнёт?!!»"
        },
        {
          "de": "Und erfasst das Ungetier.",
          "ru": "И хватает чудище.",
          "rv": "И чудовище берёт."
        },
        {
          "de": "Und den Onkel, voller Grausen,",
          "ru": "И видно, как дядюшка, полный ужаса,",
          "rv": "И глядишь: в великом страхе"
        },
        {
          "de": "Sieht man aus dem Bette sausen.",
          "ru": "вылетает из постели.",
          "rv": "дядя вылетел в рубахе."
        }
      ]
    },
    {
      "s": [
        {
          "de": "»Autsch!!« – Schon wieder hat er einen",
          "ru": "«Ой!!» – Вот уже опять один у него",
          "rv": "«Ой!!» — и снова их не счесть:"
        },
        {
          "de": "Im Genicke, an den Beinen;",
          "ru": "на загривке, на ногах;",
          "rv": "на загривке, всюду есть;"
        },
        {
          "de": "Hin und her und rund herum",
          "ru": "туда-сюда и вокруг",
          "rv": "взад-вперёд, кругом, вокруг"
        },
        {
          "de": "Kriecht es, fliegt es mit Gebrumm.",
          "ru": "ползает, летает всё с гудением.",
          "rv": "и ползут, и вьются вдруг."
        },
        {
          "de": "Onkel Fritz, in dieser Not,",
          "ru": "Дядюшка Фриц в такой беде",
          "rv": "Дядя Фриц в такой беде"
        },
        {
          "de": "Haut und trampelt alles tot",
          "ru": "бьёт и топчет всех насмерть.",
          "rv": "бьёт и топчет их везде."
        }
      ]
    },
    {
      "s": [
        {
          "de": "Guckste wohl! Jetzt ist’s vorbei",
          "ru": "Видал! Теперь конец",
          "rv": "Видел? Кончена возня,"
        },
        {
          "de": "Mit der Käferkrabbelei!!",
          "ru": "жучиной возне!!",
          "rv": "нет жуков — и нет нытья!!"
        },
        {
          "de": "Onkel Fritz hat wieder Ruh’",
          "ru": "Дядюшка Фриц снова спокоен",
          "rv": "Дядя Фриц опять притих"
        },
        {
          "de": "Und macht seine Augen zu. –",
          "ru": "и закрывает глаза. –",
          "rv": "и закрыл глаза на миг. –"
        },
        {
          "de": "Dieses war der fünfte Streich,",
          "ru": "Это была пятая проделка,",
          "rv": "Вот и пятый вышел трюк,"
        },
        {
          "de": "Doch der sechste folgt sogleich.",
          "ru": "а шестая последует тотчас.",
          "rv": "а шестой поспеет вдруг."
        }
      ]
    }
  ]
}
