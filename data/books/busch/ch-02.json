{
  "id": "ch-02",
  "title": "Erster Streich",
  "titleRu": "Проделка первая",
  "paragraphs": [
    {
      "s": [
        {
          "de": "Mancher gibt sich viele Müh’",
          "ru": "Иной не жалеет трудов"
        },
        {
          "de": "Mit dem lieben Federvieh;",
          "ru": "ради милой домашней птицы;"
        },
        {
          "de": "Einesteils der Eier wegen,",
          "ru": "во-первых, ради яиц,"
        },
        {
          "de": "Welche diese Vögel legen,",
          "ru": "которые эти птицы несут,"
        },
        {
          "de": "Zweitens: weil man dann und wann",
          "ru": "во-вторых, потому что время от времени"
        },
        {
          "de": "Einen Braten essen kann;",
          "ru": "можно съесть жаркое;"
        }
      ]
    },
    {
      "s": [
        {
          "de": "Drittens aber nimmt man auch",
          "ru": "в-третьих же, идут в дело"
        },
        {
          "de": "Ihre Federn zum Gebrauch",
          "ru": "и перья их —"
        },
        {
          "de": "In die Kissen und die Pfühle,",
          "ru": "в подушки и перины,"
        },
        {
          "de": "Denn man liegt nicht gerne kühle. –",
          "ru": "ведь в холоде лежать никто не любит. –"
        },
        {
          "de": "Seht, da ist die Witwe Bolte,",
          "ru": "Глядите, вот вдова Больте,"
        },
        {
          "de": "Die das auch nicht gerne wollte.",
          "ru": "которая тоже этого не хотела."
        }
      ]
    },
    {
      "s": [
        {
          "de": "Ihrer Hühner waren drei",
          "ru": "Кур у неё было три"
        },
        {
          "de": "Und ein stolzer Hahn dabei. –",
          "ru": "да при них гордый петух. –"
        },
        {
          "de": "Max und Moritz dachten nun:",
          "ru": "И вот Макс и Мориц подумали:"
        },
        {
          "de": "Was ist hier jetzt wohl zu tun? –",
          "ru": "а что бы тут такое учинить? –"
        },
        {
          "de": "– Ganz geschwinde, eins, zwei, drei,",
          "ru": "– Живо, раз, два, три,"
        },
        {
          "de": "Schneiden sie sich Brot entzwei,",
          "ru": "режут они себе хлеб надвое,"
        }
      ]
    },
    {
      "s": [
        {
          "de": "In vier Teile, jedes Stück",
          "ru": "на четыре части, каждый кусок"
        },
        {
          "de": "Wie ein kleiner Finger dick.",
          "ru": "толщиной с мизинец."
        },
        {
          "de": "Diese binden sie an Fäden,",
          "ru": "Их привязывают они к ниткам,"
        },
        {
          "de": "Übers Kreuz, ein Stück an jeden,",
          "ru": "крест-накрест, по куску на каждую,"
        },
        {
          "de": "Und verlegen sie, genau",
          "ru": "и раскладывают аккурат"
        },
        {
          "de": "In den Hof der guten Frau. –",
          "ru": "во дворе доброй женщины. –"
        }
      ]
    },
    {
      "s": [
        {
          "de": "Kaum hat dies der Hahn gesehen,",
          "ru": "Едва петух это увидел,"
        },
        {
          "de": "Fängt er auch schon an zu krähen:",
          "ru": "как уже принимается кукарекать:"
        },
        {
          "de": "Kikeriki! Kikikerikih!! –",
          "ru": "Кукареку! Кукарекууу!! –"
        },
        {
          "de": "Tak tak tak! – da kommen sie.",
          "ru": "Ко-ко-ко! – вот они и бегут."
        },
        {
          "de": "Hahn und Hühner schlucken munter",
          "ru": "Петух и куры бодро глотают"
        },
        {
          "de": "Jedes ein Stück Brot hinunter;",
          "ru": "каждый по куску хлеба;"
        }
      ]
    },
    {
      "s": [
        {
          "de": "Aber als sie sich besinnen,",
          "ru": "но когда они опоминаются,"
        },
        {
          "de": "Konnte keines recht von hinnen.",
          "ru": "ни одна уже не может убраться прочь."
        },
        {
          "de": "In die Kreuz und in die Quer",
          "ru": "Вдоль и поперёк"
        },
        {
          "de": "Reißen sie sich hin und her,",
          "ru": "рвутся они туда-сюда,"
        },
        {
          "de": "Flattern auf und in die Höh’,",
          "ru": "взлетают, бьются вверх,"
        },
        {
          "de": "Ach herrje, herrjemine!",
          "ru": "ах ты господи, господи боже!"
        }
      ]
    },
    {
      "s": [
        {
          "de": "Ach, sie bleiben an dem langen",
          "ru": "Ах, они повисают на длинном"
        },
        {
          "de": "Dürren Ast des Baumes hangen. –",
          "ru": "сухом суку дерева. –"
        },
        {
          "de": "– Und ihr Hals wird lang und länger,",
          "ru": "– И шеи у них всё длиннее и длиннее,"
        },
        {
          "de": "Ihr Gesang wird bang und bänger;",
          "ru": "и пение всё тоскливее и тоскливее;"
        },
        {
          "de": "Jedes legt noch schnell ein Ei,",
          "ru": "каждая наспех несёт ещё яйцо,"
        },
        {
          "de": "Und dann kommt der Tod herbei. –",
          "ru": "а потом приходит смерть. –"
        }
      ]
    },
    {
      "s": [
        {
          "de": "Witwe Bolte, in der Kammer,",
          "ru": "Вдова Больте у себя в каморке"
        },
        {
          "de": "Hört im Bette diesen Jammer;",
          "ru": "слышит в постели этот плач;"
        },
        {
          "de": "Ahnungsvoll tritt sie heraus:",
          "ru": "с недобрым предчувствием выходит она:"
        },
        {
          "de": "Ach, was war das für ein Graus!",
          "ru": "ах, что за ужас ей открылся!"
        },
        {
          "de": "»Fließet aus dem Aug’, ihr Tränen!",
          "ru": "«Лейтесь из глаз, слёзы!"
        },
        {
          "de": "All mein Hoffen, all mein Sehnen,",
          "ru": "Всё, на что я надеялась, о чём тосковала,"
        },
        {
          "de": "Meines Lebens schönster Traum",
          "ru": "лучшая мечта моей жизни"
        },
        {
          "de": "Hängt an diesem Apfelbaum!!«",
          "ru": "висит на этой яблоне!!»"
        }
      ]
    },
    {
      "s": [
        {
          "de": "Tiefbetrübt und sorgenschwer",
          "ru": "Убитая горем и полная тягостных забот,"
        },
        {
          "de": "Kriegt sie jetzt das Messer her;",
          "ru": "достаёт она теперь нож;"
        },
        {
          "de": "Nimmt die Toten von den Strängen,",
          "ru": "снимает мёртвых с верёвок,"
        },
        {
          "de": "Dass sie so nicht länger hängen,",
          "ru": "чтобы они так больше не висели,"
        },
        {
          "de": "Und mit stummem Trauerblick",
          "ru": "и с немым скорбным взглядом"
        },
        {
          "de": "Kehrt sie in ihr Haus zurück. –",
          "ru": "возвращается к себе в дом. –"
        },
        {
          "de": "Dieses war der erste Streich,",
          "ru": "Это была первая проделка,"
        },
        {
          "de": "Doch der zweite folgt sogleich.",
          "ru": "а вторая последует тотчас."
        }
      ]
    }
  ]
}
