{
  "id": "ch-04",
  "title": "Dritter Streich",
  "titleRu": "Проделка третья",
  "paragraphs": [
    {
      "s": [
        {
          "de": "Jedermann im Dorfe kannte",
          "ru": "Всякий в деревне знал",
          "rv": "Всякий в деревеньке знал",
          "g": {
            "0": "всякий",
            "1-2": "в деревне",
            "3": "знал"
          }
        },
        {
          "de": "Einen, der sich Böck benannte. –",
          "ru": "одного, кто звался Бёк. –",
          "rv": "того, кто себя Бёк звал. –",
          "g": {
            "0": "одного",
            "1": "который",
            "2+4": "звался",
            "3": "Бёком"
          }
        },
        {
          "de": "– Alltagsröcke, Sonntagsröcke,",
          "ru": "– Будничные сюртуки, воскресные сюртуки,",
          "rv": "– Сюртуки на всякий день,",
          "g": {
            "0": "будничные сюртуки",
            "1": "воскресные сюртуки"
          }
        },
        {
          "de": "Lange Hosen, spitze Fräcke,",
          "ru": "длинные штаны, фраки с острыми фалдами,",
          "rv": "фраки, брюки — шить не лень,",
          "g": {
            "0": "длинные",
            "1": "штаны",
            "2": "остроконечные",
            "3": "фраки"
          }
        },
        {
          "de": "Westen mit bequemen Taschen,",
          "ru": "жилеты с удобными карманами,",
          "rv": "да жилетки с кошельком,",
          "g": {
            "0": "жилеты",
            "1-3": "с удобными карманами"
          }
        },
        {
          "de": "Warme Mäntel und Gamaschen –",
          "ru": "тёплые пальто и гамаши –",
          "rv": "да пальто, да всё при нём —",
          "g": {
            "0": "тёплые",
            "1": "плащи",
            "3": "гамаши"
          }
        },
        {
          "de": "Alle diese Kleidungssachen",
          "ru": "все эти предметы одежды",
          "rv": "словом, всё, что мы наденем,",
          "g": {
            "0": "все",
            "1": "эти",
            "2": "одёжки"
          }
        },
        {
          "de": "Wusste Schneider Böck zu machen. –",
          "ru": "портной Бёк умел шить. –",
          "rv": "Бёк-портной шьёт с настроеньем. –",
          "g": {
            "0": "умел",
            "1": "портной",
            "2": "Бёк",
            "3-4": "шить"
          }
        }
      ]
    },
    {
      "s": [
        {
          "de": "– Oder wäre was zu flicken,",
          "ru": "– А если надо было что-нибудь залатать,",
          "rv": "– А случись зашить, подшить,",
          "g": {
            "0": "или",
            "1": "было",
            "2": "что",
            "3-4": "залатать"
          }
        },
        {
          "de": "Abzuschneiden, anzustücken,",
          "ru": "обрезать, надставить,",
          "rv": "подрубить да надточить,",
          "g": {
            "0": "отрезать",
            "1": "надставить"
          }
        },
        {
          "de": "Oder gar ein Knopf der Hose",
          "ru": "или уж если пуговица на штанах",
          "rv": "иль на брюках пуговица",
          "g": {
            "0": "или",
            "1": "даже",
            "3": "пуговица",
            "4-5": "на штанах"
          }
        },
        {
          "de": "Abgerissen oder lose –",
          "ru": "оторвалась или болталась –",
          "rv": "оторвалась, не годится, —",
          "g": {
            "0": "оторвалась",
            "1": "или",
            "2": "болтается"
          }
        },
        {
          "de": "Wie und wo und was es sei,",
          "ru": "как, где и что бы там ни было,",
          "rv": "что, и где, и как — пустяк:",
          "g": {
            "0": "как",
            "2": "где",
            "4": "что",
            "5-6": "бы ни было"
          }
        },
        {
          "de": "Hinten, vorne, einerlei –",
          "ru": "сзади, спереди, всё равно –",
          "rv": "сзади, спереди — и так,",
          "g": {
            "0": "сзади",
            "1": "спереди",
            "2": "всё равно"
          }
        }
      ]
    },
    {
      "s": [
        {
          "de": "Alles macht der Meister Böck,",
          "ru": "всё сделает мастер Бёк,",
          "rv": "всё умеет мастер Бёк,",
          "g": {
            "0": "всё",
            "1": "делает",
            "3": "мастер",
            "4": "Бёк"
          }
        },
        {
          "de": "Denn das ist sein Lebenszweck. –",
          "ru": "ведь в этом смысл его жизни. –",
          "rv": "в этом весь его итог. –",
          "g": {
            "0": "ведь",
            "1": "это",
            "2": "",
            "3": "его",
            "4": "смысл жизни"
          }
        },
        {
          "de": "– Drum so hat in der Gemeinde",
          "ru": "– Оттого во всей общине",
          "rv": "– Оттого в родной общине",
          "g": {
            "0-1": "поэтому",
            "2": "",
            "3-5": "в общине"
          }
        },
        {
          "de": "Jedermann ihn gern zum Freunde. –",
          "ru": "всякий рад ему как другу. –",
          "rv": "всяк ему как друг доныне. –",
          "g": {
            "0": "всякий",
            "2-4": "охотно в друзьях"
          }
        },
        {
          "de": "– Aber Max und Moritz dachten,",
          "ru": "– Но Макс и Мориц придумывали,",
          "rv": "– Но у Макса с Морицем дума:",
          "g": {
            "0": "но",
            "1": "Макс",
            "3": "Мориц",
            "4": "думали"
          }
        },
        {
          "de": "Wie sie ihn verdrießlich machten. –",
          "ru": "как бы им его допечь. –",
          "rv": "как бы Бёку сделать шума? –",
          "g": {
            "0": "как",
            "3-4": "досадить"
          }
        }
      ]
    },
    {
      "s": [
        {
          "de": "Nämlich vor des Meisters Hause",
          "ru": "А именно: перед домом мастера",
          "rv": "Перед домом у портного",
          "g": {
            "0": "а именно",
            "1-4": "перед домом мастера"
          }
        },
        {
          "de": "Floß ein Wasser mit Gebrause.",
          "ru": "с шумом текла речка.",
          "rv": "речка бурная — не ново;",
          "g": {
            "0": "текла",
            "2": "вода",
            "3-4": "с шумом"
          }
        },
        {
          "de": "Übers Wasser führt ein Steg",
          "ru": "Через воду ведут мостки,",
          "rv": "через речку — узкий мост,",
          "g": {
            "0-1": "через воду",
            "2": "ведут",
            "4": "мостки"
          }
        },
        {
          "de": "Und darüber geht der Weg. –",
          "ru": "и по ним идёт дорога. –",
          "rv": "и дорога в полный рост. –",
          "g": {
            "1": "по ним",
            "2": "идёт",
            "4": "дорога"
          }
        }
      ]
    },
    {
      "s": [
        {
          "de": "Max und Moritz, gar nicht träge,",
          "ru": "Макс и Мориц, ничуть не ленясь,",
          "rv": "Макс и Мориц, не ленясь,",
          "g": {
            "0": "Макс",
            "2": "Мориц",
            "3-4": "вовсе не",
            "5": "ленивые"
          }
        },
        {
          "de": "Sägen heimlich mit der Säge,",
          "ru": "тайком пилят пилой,",
          "rv": "пилят тайно, притаясь,",
          "g": {
            "0": "пилят",
            "1": "тайком",
            "2-4": "пилой"
          }
        },
        {
          "de": "Ritzeratze! voller Tücke,",
          "ru": "вжик-вжик! полные коварства,",
          "rv": "вжик да вжик! — и вот уже",
          "g": {
            "0": "вжик-вжик",
            "1": "полные",
            "2": "коварства"
          }
        },
        {
          "de": "In die Brücke eine Lücke. –",
          "ru": "в мостках прорез. –",
          "rv": "щель в мосту на рубеже. –",
          "g": {
            "0-2": "в мосту",
            "4": "прореху"
          }
        },
        {
          "de": "Als nun diese Tat vorbei,",
          "ru": "Когда дело было сделано,",
          "rv": "Дело сделано, и вдруг",
          "g": {
            "0": "когда",
            "1": "теперь",
            "2": "это",
            "3": "дело",
            "4": "сделано"
          }
        },
        {
          "de": "Hört man plötzlich ein Geschrei:",
          "ru": "вдруг слышится крик:",
          "rv": "раздаётся крик вокруг:",
          "g": {
            "0": "слышно",
            "2": "вдруг",
            "4": "крик"
          }
        }
      ]
    },
    {
      "s": [
        {
          "de": "»He, heraus! du Ziegen-Böck!",
          "ru": "«Эй, выходи! ты, козёл Бёк!",
          "rv": "«Эй, наружу, Бёк-козёл!",
          "g": {
            "0": "эй",
            "1": "выходи",
            "3": "козёл-Бёк"
          }
        },
        {
          "de": "Schneider, Schneider, meck, meck, meck!!« –",
          "ru": "Портной, портной, ме-ке-ке!!» –",
          "rv": "Ме-ке-ке! Портной пришёл!!» –",
          "g": {
            "0": "портной",
            "1": "портной",
            "2": "ме",
            "3": "ме",
            "4": "ме"
          }
        },
        {
          "de": "– Alles konnte Böck ertragen,",
          "ru": "– Всё мог Бёк снести,",
          "rv": "– Всё портной стерпеть умел,",
          "g": {
            "0": "всё",
            "1": "мог",
            "2": "Бёк",
            "3": "вынести"
          }
        },
        {
          "de": "Ohne nur ein Wort zu sagen;",
          "ru": "не говоря ни слова;",
          "rv": "слова молвить не хотел;",
          "g": {
            "0": "не",
            "1": "даже",
            "3": "слова",
            "4-5": "сказав"
          }
        },
        {
          "de": "Aber wenn er dies erfuhr,",
          "ru": "но когда он слышал это,",
          "rv": "но такое услыхать —",
          "g": {
            "0": "но",
            "1": "когда",
            "3": "это",
            "4": "слышал"
          }
        },
        {
          "de": "Ging’s ihm wider die Natur. –",
          "ru": "было оно ему поперёк натуры. –",
          "rv": "против сердца, не сдержать. –",
          "g": {
            "0": "",
            "2-4": "было ему не по нутру"
          }
        }
      ]
    },
    {
      "s": [
        {
          "de": "Schnelle, springt er mit der Elle",
          "ru": "Живо выскакивает он с аршином",
          "rv": "Живо, с аршином в руке,",
          "g": {
            "0": "быстро",
            "1": "прыгает",
            "3-5": "с аршином"
          }
        },
        {
          "de": "Über seines Hauses Schwelle,",
          "ru": "за порог своего дома,",
          "rv": "он — через порог, к реке,",
          "g": {
            "0": "через",
            "1-2": "своего дома",
            "3": "порог"
          }
        },
        {
          "de": "Denn schon wieder ihm zum Schreck",
          "ru": "ведь снова, ему на страх,",
          "rv": "ведь опять, ему на страх,",
          "g": {
            "0": "ведь",
            "1": "уже",
            "2": "снова",
            "3-5": "ему на испуг"
          }
        },
        {
          "de": "Tönt ein lautes: »Meck, meck, meck!!«",
          "ru": "раздаётся громкое: «Ме-ке-ке!!»",
          "rv": "громко: «Ме-ке-ке!» в ушах.",
          "g": {
            "0": "звучит",
            "2": "громкое",
            "3": "ме",
            "4": "ме",
            "5": "ме"
          }
        },
        {
          "de": "Und schon ist er auf der Brücke,",
          "ru": "И вот он уже на мостках,",
          "rv": "Вот он на мосту, и — крак!",
          "g": {
            "1": "и вот",
            "2": "",
            "4-6": "на мосту"
          }
        },
        {
          "de": "Kracks! Die Brücke bricht in Stücke;",
          "ru": "крак! мостки разлетаются в куски;",
          "rv": "мост в куски, и всё не так;",
          "g": {
            "0": "трах",
            "2": "мост",
            "3": "разлетается",
            "4-5": "на куски"
          }
        }
      ]
    },
    {
      "s": [
        {
          "de": "Wieder tönt es: »Meck, meck, meck!«",
          "ru": "снова звучит: «Ме-ке-ке!»",
          "rv": "снова слышно: «Ме-ке-ке!»",
          "g": {
            "0": "снова",
            "1": "звучит",
            "3": "ме",
            "4": "ме",
            "5": "ме"
          }
        },
        {
          "de": "Plumps! da ist der Schneider weg!",
          "ru": "плюх! и портного нет!",
          "rv": "Плюх! — портной уже в реке!",
          "g": {
            "0": "бултых",
            "1": "вот",
            "2": "",
            "4": "портной",
            "5": "исчез"
          }
        },
        {
          "de": "Grad als dieses vorgekommen,",
          "ru": "Как раз когда это случилось,",
          "rv": "Только это приключилось —",
          "g": {
            "0": "как раз",
            "1": "когда",
            "2": "это",
            "3": "случилось"
          }
        },
        {
          "de": "Kommt ein Gänsepaar geschwommen,",
          "ru": "подплывает пара гусей,",
          "rv": "пара гусаков явилась,",
          "g": {
            "0+3": "подплывает",
            "2": "пара гусей"
          }
        },
        {
          "de": "Welches Böck in Todeshast",
          "ru": "и Бёк в смертельной спешке",
          "rv": "Бёк со страху, чуть дыша,",
          "g": {
            "0": "которую",
            "1": "Бёк",
            "2-3": "в смертельной спешке"
          }
        },
        {
          "de": "Krampfhaft bei den Beinen fasst.",
          "ru": "судорожно хватает их за ноги.",
          "rv": "их за ноги — цап, спеша.",
          "g": {
            "0": "судорожно",
            "1-3": "за ноги",
            "4": "хватает"
          }
        }
      ]
    },
    {
      "s": [
        {
          "de": "Beide Gänse in der Hand,",
          "ru": "С обоими гусями в руках",
          "rv": "Два гуся в руках — и вот",
          "g": {
            "0": "обоих",
            "1": "гусей",
            "2-4": "в руке"
          }
        },
        {
          "de": "Flattert er auf trocknes Land. –",
          "ru": "выпархивает он на сушу. –",
          "rv": "он на сушу упорхнёт. –",
          "g": {
            "0": "выпархивает",
            "2-4": "на сушу"
          }
        },
        {
          "de": "Übrigens bei alledem",
          "ru": "Впрочем, при всём при том",
          "rv": "Впрочем, что уж тут скрывать:",
          "g": {
            "0": "впрочем",
            "1-2": "при всём этом"
          }
        },
        {
          "de": "Ist so etwas nicht bequem;",
          "ru": "удовольствие это небольшое;",
          "rv": "мало радости хватать;",
          "g": {
            "0": "",
            "1": "такое",
            "2": "",
            "3": "не",
            "4": "удобно"
          }
        },
        {
          "de": "Wie denn Böck von der Geschichte",
          "ru": "оттого-то Бёк от этой истории",
          "rv": "оттого-то у портного",
          "g": {
            "0": "как",
            "1": "ведь",
            "2": "Бёк",
            "3-5": "от этой истории"
          }
        },
        {
          "de": "Auch das Magendrücken kriegte.",
          "ru": "и схватил резь в животе.",
          "rv": "резь в желудке — дело ново.",
          "g": {
            "0": "и",
            "2": "резь в животе",
            "3": "получил"
          }
        }
      ]
    },
    {
      "s": [
        {
          "de": "Hoch ist hier Frau Böck zu preisen!",
          "ru": "Тут впору восхвалять госпожу Бёк!",
          "rv": "Слава, слава фрау Бёк!",
          "g": {
            "0-2": "высоко здесь",
            "3": "фрау",
            "4": "Бёк",
            "5-6": "восхвалить"
          }
        },
        {
          "de": "Denn ein heißes Bügeleisen,",
          "ru": "Ведь горячий утюг,",
          "rv": "Ведь горячий утюжок,",
          "g": {
            "0": "ведь",
            "2": "горячий",
            "3": "утюг"
          }
        },
        {
          "de": "Auf den kalten Leib gebracht,",
          "ru": "приложенный к остывшему телу,",
          "rv": "приложённый к животу,",
          "g": {
            "0-3": "на холодный живот",
            "4": "положенный"
          }
        },
        {
          "de": "Hat es wieder gut gemacht. –",
          "ru": "всё поправил. –",
          "rv": "снял и хворь, и маету. –",
          "g": {
            "0": "",
            "2": "снова",
            "3-4": "всё исправил"
          }
        },
        {
          "de": "– Bald im Dorf hinauf, hinunter,",
          "ru": "– Скоро по всей деревне, вверх и вниз,",
          "rv": "– Скоро вся деревня знала:",
          "g": {
            "0": "вскоре",
            "1-2": "по деревне",
            "3": "вверх",
            "4": "вниз"
          }
        },
        {
          "de": "Hieß es Böck ist wieder munter!! –",
          "ru": "говорили: Бёк снова бодр!! –",
          "rv": "Бёку снова горя мало!! –",
          "g": {
            "0-1": "говорили",
            "2": "Бёк",
            "3": "",
            "4": "снова",
            "5": "бодр"
          }
        },
        {
          "de": "Dieses war der dritte Streich,",
          "ru": "Это была третья проделка,",
          "rv": "Вот и третий вышел трюк,",
          "g": {
            "0": "это",
            "1": "была",
            "3": "третья",
            "4": "проделка"
          }
        },
        {
          "de": "Doch der vierte folgt sogleich.",
          "ru": "а четвёртая последует тотчас.",
          "rv": "а четвёртый грянет вдруг.",
          "g": {
            "0": "но",
            "2": "четвёртая",
            "3": "следует",
            "4": "тотчас"
          }
        }
      ]
    }
  ]
}
