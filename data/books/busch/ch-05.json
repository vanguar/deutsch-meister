{
  "id": "ch-05",
  "title": "Vierter Streich",
  "titleRu": "Проделка четвёртая",
  "paragraphs": [
    {
      "s": [
        {
          "de": "Also lautet ein Beschluss:",
          "ru": "Итак, гласит решение:"
        },
        {
          "de": "Dass der Mensch was lernen muss. –",
          "ru": "человек должен чему-то учиться. –"
        },
        {
          "de": "– Nicht allein das A-B-C",
          "ru": "– Не одна только азбука"
        },
        {
          "de": "Bringt den Menschen in die Höh’;",
          "ru": "поднимает человека ввысь;"
        },
        {
          "de": "Nicht allein im Schreiben, Lesen",
          "ru": "не только в письме и чтении"
        },
        {
          "de": "Übt sich ein vernünftig Wesen;",
          "ru": "упражняется разумное существо;"
        }
      ]
    },
    {
      "s": [
        {
          "de": "Nicht allein in Rechnungssachen",
          "ru": "не только в счётных делах"
        },
        {
          "de": "Soll der Mensch sich Mühe machen;",
          "ru": "должен человек прилагать старание;"
        },
        {
          "de": "Sondern auch der Weisheit Lehren",
          "ru": "но и наставления мудрости"
        },
        {
          "de": "Muss man mit Vergnügen hören. –",
          "ru": "надо слушать с удовольствием. –"
        }
      ]
    },
    {
      "s": [
        {
          "de": "Dass dies mit Verstand geschah,",
          "ru": "А чтобы всё это шло с толком,"
        },
        {
          "de": "War Herr Lehrer Lämpel da. –",
          "ru": "на то был господин учитель Лемпель. –"
        },
        {
          "de": "– Max und Moritz, diese beiden,",
          "ru": "– Макс и Мориц, эти двое,"
        },
        {
          "de": "Mochten ihn darum nicht leiden;",
          "ru": "за это его терпеть не могли;"
        },
        {
          "de": "Denn wer böse Streiche macht,",
          "ru": "ведь кто устраивает злые проделки,"
        },
        {
          "de": "Gibt nicht auf den Lehrer acht. –",
          "ru": "тот на учителя не оглядывается. –"
        }
      ]
    },
    {
      "s": [
        {
          "de": "Nun war dieser brave Lehrer",
          "ru": "А был этот славный учитель"
        },
        {
          "de": "Von dem Tobak ein Verehrer,",
          "ru": "большим почитателем табака,"
        },
        {
          "de": "Was man ohne alle Frage",
          "ru": "чего, без всякого сомнения,"
        },
        {
          "de": "Nach des Tages Müh und Plage",
          "ru": "после дневных трудов и тягот"
        },
        {
          "de": "Einem guten, alten Mann",
          "ru": "доброму старику"
        },
        {
          "de": "Auch von Herzen gönnen kann. –",
          "ru": "от души можно пожелать. –"
        }
      ]
    },
    {
      "s": [
        {
          "de": "– Max und Moritz, unverdrossen,",
          "ru": "– Макс и Мориц, не унывая,"
        },
        {
          "de": "Sinnen aber schon auf Possen,",
          "ru": "уже замышляют новую каверзу:"
        },
        {
          "de": "Ob vermittelst seiner Pfeifen",
          "ru": "нельзя ли этого человека"
        },
        {
          "de": "Dieser Mann nicht anzugreifen. –",
          "ru": "подловить на его трубках. –"
        },
        {
          "de": "– Einstens, als es Sonntag wieder",
          "ru": "– Однажды, когда снова было воскресенье"
        },
        {
          "de": "Und Herr Lämpel brav und bieder",
          "ru": "и господин Лемпель, честный и добропорядочный,"
        }
      ]
    },
    {
      "s": [
        {
          "de": "In der Kirche mit Gefühle",
          "ru": "сидел в церкви с чувством"
        },
        {
          "de": "Saß vor seinem Orgelspiele,",
          "ru": "за своей игрой на органе,"
        },
        {
          "de": "Schlichen sich die bösen Buben",
          "ru": "прокрались злые мальчишки"
        },
        {
          "de": "In sein Haus und seine Stuben,",
          "ru": "в его дом и его комнаты,"
        },
        {
          "de": "Wo die Meerschaumpfeife stand;",
          "ru": "где стояла пенковая трубка;"
        },
        {
          "de": "Max hält sie in seiner Hand;",
          "ru": "Макс держит её в руке;"
        }
      ]
    },
    {
      "s": [
        {
          "de": "Aber Moritz aus der Tasche",
          "ru": "а Мориц из кармана"
        },
        {
          "de": "Zieht die Flintenpulverflasche,",
          "ru": "достаёт пороховницу,"
        },
        {
          "de": "Und geschwinde, stopf, stopf, stopf!",
          "ru": "и живо — суй, суй, суй! —"
        },
        {
          "de": "Pulver in den Pfeifenkopf. –",
          "ru": "порох в чашечку трубки. –"
        },
        {
          "de": "Jetzt nur still und schnell nach Haus,",
          "ru": "Теперь тихо и быстро домой,"
        },
        {
          "de": "Denn schon ist die Kirche aus. –",
          "ru": "ведь служба уже кончилась. –"
        }
      ]
    },
    {
      "s": [
        {
          "de": "– Eben schließt in sanfter Ruh’",
          "ru": "– Как раз в тихом покое"
        },
        {
          "de": "Lämpel seine Kirche zu;",
          "ru": "запирает Лемпель свою церковь;"
        },
        {
          "de": "Und mit Buch und Notenheften,",
          "ru": "и с книгой и нотными тетрадями,"
        },
        {
          "de": "Nach besorgten Amtsgeschäften,",
          "ru": "справив служебные дела,"
        },
        {
          "de": "Lenkt er freudig seine Schritte",
          "ru": "радостно направляет он шаги"
        },
        {
          "de": "Zu der heimatlichen Hütte,",
          "ru": "к родимому домику,"
        }
      ]
    },
    {
      "s": [
        {
          "de": "Und voll Dankbarkeit sodann,",
          "ru": "и затем, полный благодарности,"
        },
        {
          "de": "Zündet er sein Pfeifchen an.",
          "ru": "раскуривает свою трубочку."
        },
        {
          "de": "»Ach!« – spricht er – »die größte Freud’",
          "ru": "«Ах! – говорит он, – величайшая радость"
        },
        {
          "de": "Ist doch die Zufriedenheit!!!«",
          "ru": "это всё-таки довольство!!!»"
        }
      ]
    },
    {
      "s": [
        {
          "de": "Rums!! – da geht die Pfeife los",
          "ru": "Бум!! – тут трубка взрывается"
        },
        {
          "de": "Mit Getöse, schrecklich groß.",
          "ru": "с грохотом, страшно громким."
        },
        {
          "de": "Kaffeetopf und Wasserglas,",
          "ru": "Кофейник и стакан для воды,"
        },
        {
          "de": "Tobaksdose, Tintenfass,",
          "ru": "табакерка, чернильница,"
        },
        {
          "de": "Ofen, Tisch und Sorgensitz –",
          "ru": "печь, стол и насиженное кресло –"
        },
        {
          "de": "Alles fliegt im Pulverblitz. –",
          "ru": "всё летит в пороховой вспышке. –"
        }
      ]
    },
    {
      "s": [
        {
          "de": "Als der Dampf sich nun erhob,",
          "ru": "Когда дым рассеялся,"
        },
        {
          "de": "Sieht man Lämpel, der gottlob!",
          "ru": "видно Лемпеля, который, слава богу,"
        },
        {
          "de": "Lebend auf dem Rücken liegt;",
          "ru": "живой лежит на спине;"
        },
        {
          "de": "Doch er hat was abgekriegt.",
          "ru": "но досталось ему изрядно."
        },
        {
          "de": "Nase, Hand, Gesicht und Ohren",
          "ru": "Нос, рука, лицо и уши"
        },
        {
          "de": "Sind so schwarz als wie die Mohren,",
          "ru": "черны, точно мавры,"
        },
        {
          "de": "Und des Haares letzter Schopf",
          "ru": "и последний вихор волос"
        },
        {
          "de": "Ist verbrannt bis auf den Kopf. –",
          "ru": "сгорел до самой головы. –"
        }
      ]
    },
    {
      "s": [
        {
          "de": "Wer soll nun die Kinder lehren",
          "ru": "Кто же теперь будет учить детей"
        },
        {
          "de": "Und die Wissenschaft vermehren?",
          "ru": "и умножать науку?"
        },
        {
          "de": "Wer soll nun für Lämpel leiten",
          "ru": "Кто теперь будет за Лемпеля вести"
        },
        {
          "de": "Seine Amtestätigkeiten?",
          "ru": "его служебные занятия?"
        },
        {
          "de": "Woraus soll der Lehrer rauchen,",
          "ru": "Из чего теперь учителю курить,"
        },
        {
          "de": "Wenn die Pfeife nicht zu brauchen??",
          "ru": "если трубка никуда не годится??"
        },
        {
          "de": "Mit der Zeit wird alles heil,",
          "ru": "Со временем всё заживает,"
        },
        {
          "de": "Nur die Pfeife hat ihr Teil. –",
          "ru": "только трубке досталось своё. –"
        }
      ]
    },
    {
      "s": [
        {
          "de": "Dieses war der vierte Streich,",
          "ru": "Это была четвёртая проделка,"
        },
        {
          "de": "Doch der fünfte folgt sogleich.",
          "ru": "а пятая последует тотчас."
        }
      ]
    }
  ]
}
