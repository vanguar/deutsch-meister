{
  "id": "ch-07",
  "title": "Sechster Streich",
  "titleRu": "Проделка шестая",
  "paragraphs": [
    {
      "s": [
        {
          "de": "In der schönen Osterzeit,",
          "ru": "В прекрасную пасхальную пору,",
          "rv": "В пасху, в праздничные дни,"
        },
        {
          "de": "Wenn die frommen Bäckersleut’,",
          "ru": "когда благочестивые пекари",
          "rv": "как пекут нам искони"
        },
        {
          "de": "Viele süße Zuckersachen",
          "ru": "много сладких сахарных штук",
          "rv": "груды сахарных вещей —"
        },
        {
          "de": "Backen und zurechtemachen,",
          "ru": "пекут и готовят,",
          "rv": "всё пышней да всё свежей, —"
        },
        {
          "de": "Wünschten Max und Moritz auch",
          "ru": "захотелось и Максу с Морицем",
          "rv": "захотелось той порой"
        },
        {
          "de": "Sich so etwas zum Gebrauch. –",
          "ru": "раздобыть себе что-нибудь этакое. –",
          "rv": "и мальчишкам — по одной. –"
        }
      ]
    },
    {
      "s": [
        {
          "de": "Doch der Bäcker, mit Bedacht,",
          "ru": "Но пекарь предусмотрительно",
          "rv": "Но пекарь мудр: на все замки"
        },
        {
          "de": "Hat das Backhaus zugemacht.",
          "ru": "запер пекарню.",
          "rv": "закрыл пекарню от руки."
        },
        {
          "de": "Also, will hier einer stehlen,",
          "ru": "Стало быть, кто хочет тут украсть,",
          "rv": "Значит, красть коль хочешь ты,"
        },
        {
          "de": "Muss er durch den Schlot sich quälen. –",
          "ru": "тому надо лезть через дымоход. –",
          "rv": "лезь в трубу до черноты. –"
        },
        {
          "de": "Ratsch!! – Da kommen die zwei Knaben",
          "ru": "Шарк!! – вот лезут два мальчишки",
          "rv": "Шарк!! — и лезут два юнца"
        },
        {
          "de": "Durch den Schornstein, schwarz wie Raben.",
          "ru": "через трубу, чёрные, как вороны.",
          "rv": "сквозь трубу, черней грача."
        }
      ]
    },
    {
      "s": [
        {
          "de": "Puff!! – Sie fallen in die Kist’,",
          "ru": "Пуф!! – они падают в ларь,",
          "rv": "Пуф!! — и падают в сундук,"
        },
        {
          "de": "Wo das Mehl darinnen ist.",
          "ru": "в котором мука.",
          "rv": "где мука лежит вокруг."
        },
        {
          "de": "Da! Nun sind sie alle beide",
          "ru": "Вот! Теперь они оба",
          "rv": "Вот! Теперь они белы,"
        },
        {
          "de": "Rund herum so weiß wie Kreide.",
          "ru": "кругом белые, как мел.",
          "rv": "точно мел, и не милы."
        },
        {
          "de": "Aber schon mit viel Vergnügen",
          "ru": "Но уже с большим удовольствием",
          "rv": "Но уже с большой отрадой"
        },
        {
          "de": "Sehen sie die Brezeln liegen.",
          "ru": "видят они, как лежат крендели.",
          "rv": "крендели узрели рядом."
        }
      ]
    },
    {
      "s": [
        {
          "de": "Knacks!! – Da bricht der Stuhl entzwei;",
          "ru": "Хрусть!! – тут стул ломается надвое;",
          "rv": "Хрусть!! — и стул сломался вдруг;"
        },
        {
          "de": "Schwapp!! – Da liegen sie im Brei.",
          "ru": "шлёп!! – и вот они в тесте.",
          "rv": "шлёп!! — и в тесте оба, друг."
        },
        {
          "de": "Ganz von Kuchenteig umhüllt",
          "ru": "Совсем облепленные сдобным тестом,",
          "rv": "Всё в сдобе, с ног до головы,"
        },
        {
          "de": "Stehn sie da als Jammerbild. –",
          "ru": "стоят они, жалкое зрелище. –",
          "rv": "стоят, как жалкие столбы. –"
        },
        {
          "de": "Gleich erscheint der Meister Bäcker",
          "ru": "Тут же появляется мастер пекарь",
          "rv": "Тут и мастер-хлебопёк"
        },
        {
          "de": "Und bemerkt die Zuckerlecker.",
          "ru": "и замечает сластён.",
          "rv": "сластолюбцев подстерёг."
        }
      ]
    },
    {
      "s": [
        {
          "de": "Eins, zwei, drei! – Eh’ man’s gedacht,",
          "ru": "Раз, два, три! – не успели и подумать,",
          "rv": "Раз, два, три! — и в тот же час"
        },
        {
          "de": "Sind zwei Brote draus gemacht.",
          "ru": "как из них вышло два хлеба.",
          "rv": "два хлебца из них как раз."
        },
        {
          "de": "In dem Ofen glüht es noch –",
          "ru": "В печи ещё пышет жар –",
          "rv": "В печке жар ещё не стих —"
        },
        {
          "de": "Ruff!! – damit ins Ofenloch!",
          "ru": "шасть!! – и их в устье печи!",
          "rv": "шасть!! — и в устье их двоих!"
        },
        {
          "de": "Ruff!! – man zieht sie aus der Glut –",
          "ru": "Шасть!! – их вытаскивают из жара –",
          "rv": "Шасть!! — и вынуты на свет,"
        },
        {
          "de": "Denn nun sind sie braun und gut. –",
          "ru": "ведь теперь они румяные и готовые. –",
          "rv": "подрумянены — обед! –"
        }
      ]
    },
    {
      "s": [
        {
          "de": "– Jeder denkt: »Die sind perdü!«",
          "ru": "– Всякий думает: «Им конец!»",
          "rv": "– Всякий мыслит: «Им конец!»"
        },
        {
          "de": "Aber nein! – noch leben sie! –",
          "ru": "Но нет! – они ещё живы! –",
          "rv": "Но не тут-то — жив малец! –"
        },
        {
          "de": "Knusper, knasper! – wie zwei Mäuse",
          "ru": "Хрусть-хрусть! – как две мыши",
          "rv": "Хрусть да хрусть! — мышами прямо"
        },
        {
          "de": "Fressen sie durch das Gehäuse;",
          "ru": "прогрызают они себе выход из корки;",
          "rv": "корку грызть взялись упрямо;"
        },
        {
          "de": "Und der Meister Bäcker schrie:",
          "ru": "а мастер пекарь закричал:",
          "rv": "и вскричал тут хлебопёк:"
        },
        {
          "de": "»Ach herrje! da laufen sie!!« –",
          "ru": "«Ах ты господи! вон они бегут!!» –",
          "rv": "«Ах ты господи! Утёк!!» –"
        },
        {
          "de": "Dieses war der sechste Streich,",
          "ru": "Это была шестая проделка,",
          "rv": "Вот шестой закончен трюк,"
        },
        {
          "de": "Doch der letzte folgt sogleich.",
          "ru": "а последняя последует тотчас.",
          "rv": "а последний грянет вдруг."
        }
      ]
    }
  ]
}
