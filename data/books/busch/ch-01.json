{
  "id": "ch-01",
  "title": "Vorwort",
  "titleRu": "Предисловие",
  "paragraphs": [
    {
      "s": [
        {
          "de": "Ach, was muss man oft von bösen",
          "ru": "Ах, сколько же приходится о злых",
          "rv": "Ах, о детях, что дурны,"
        },
        {
          "de": "Kindern hören oder lesen!!",
          "ru": "детях слышать или читать!!",
          "rv": "сколько сплетен и молвы!"
        },
        {
          "de": "Wie zum Beispiel hier von diesen,",
          "ru": "Вот, к примеру, об этих двоих,",
          "rv": "Вот, к примеру, эти двое —"
        },
        {
          "de": "Welche Max und Moritz hießen;",
          "ru": "которых звали Макс и Мориц;",
          "rv": "Макс и Мориц. Дело злое:"
        }
      ]
    },
    {
      "s": [
        {
          "de": "Die, anstatt durch weise Lehren",
          "ru": "которые, вместо того чтобы мудрым наставлениям",
          "rv": "вместо мудрого ученья,"
        },
        {
          "de": "Sich zum Guten zu bekehren,",
          "ru": "внять и обратиться к добру,",
          "rv": "вместо доброго смиренья"
        },
        {
          "de": "Oftmals noch darüber lachten",
          "ru": "частенько ещё и смеялись над ними",
          "rv": "те над ними — только в смех"
        },
        {
          "de": "Und sich heimlich lustig machten. –",
          "ru": "и втихомолку потешались. –",
          "rv": "да тайком дразнили всех. –"
        },
        {
          "de": "– Ja, zur Übeltätigkeit,",
          "ru": "– Да, на злодейство,",
          "rv": "– Да, на пакость и разбой"
        },
        {
          "de": "Ja, dazu ist man bereit! –",
          "ru": "да, на него-то всякий готов! –",
          "rv": "человек всегда лихой! –"
        }
      ]
    },
    {
      "s": [
        {
          "de": "– Menschen necken, Tiere quälen,",
          "ru": "– Людей дразнить, животных мучить,",
          "rv": "– Люд дразнить, зверьё терзать,"
        },
        {
          "de": "Äpfel, Birnen, Zwetschen stehlen – –",
          "ru": "яблоки, груши, сливы воровать – –",
          "rv": "груши, сливы воровать – –"
        },
        {
          "de": "Das ist freilich angenehmer",
          "ru": "это, конечно, приятнее",
          "rv": "это, ясно, всё милее"
        },
        {
          "de": "Und dazu auch viel bequemer,",
          "ru": "да и куда удобнее,",
          "rv": "и куда как веселее,"
        },
        {
          "de": "Als in Kirche oder Schule",
          "ru": "чем в церкви или в школе",
          "rv": "чем торчать в церквах и в школе,"
        },
        {
          "de": "Festzusitzen auf dem Stuhle. –",
          "ru": "сиднем сидеть на стуле. –",
          "rv": "на скамье сидеть в неволе. –"
        }
      ]
    },
    {
      "s": [
        {
          "de": "– Aber wehe, wehe, wehe!",
          "ru": "– Но горе, горе, горе!",
          "rv": "– Только горе, горе, горе,"
        },
        {
          "de": "Wenn ich, auf das Ende sehe!! –",
          "ru": "когда я смотрю, чем всё кончилось!! –",
          "rv": "если знать, что будет вскоре! –"
        },
        {
          "de": "– Ach, das war ein schlimmes Ding,",
          "ru": "– Ах, скверное вышло дело,",
          "rv": "– Ах, с мальчишками стряслось"
        },
        {
          "de": "Wie es Max und Moritz ging.",
          "ru": "то, как обернулось для Макса и Морица.",
          "rv": "то, что худо обошлось."
        },
        {
          "de": "– Drum ist hier, was sie getrieben,",
          "ru": "– Потому здесь всё, что они натворили,",
          "rv": "– Оттого всё, что творили,"
        },
        {
          "de": "Abgemalt und aufgeschrieben.",
          "ru": "нарисовано и записано.",
          "rv": "здесь в картинках начертили."
        }
      ]
    }
  ]
}
