{
  "id": "ch-03",
  "title": "Zweiter Streich",
  "titleRu": "Проделка вторая",
  "paragraphs": [
    {
      "s": [
        {
          "de": "Als die gute Witwe Bolte",
          "ru": "Когда добрая вдова Больте",
          "rv": "Чуть вдова пришла в себя,"
        },
        {
          "de": "Sich von ihrem Schmerz erholte,",
          "ru": "оправилась от своего горя,",
          "rv": "горевать да плакать зря"
        },
        {
          "de": "Dachte sie so hin und her,",
          "ru": "принялась она прикидывать так и сяк,",
          "rv": "перестала — так и сяк"
        },
        {
          "de": "Dass es wohl das Beste wär’,",
          "ru": "что лучше всего, пожалуй, будет",
          "rv": "думать стала: сделать как?"
        },
        {
          "de": "Die Verstorb’nen, die hienieden",
          "ru": "покойниц, что здесь, на земле,",
          "rv": "Тех, что рано так почили,"
        },
        {
          "de": "Schon so frühe abgeschieden,",
          "ru": "отошли так рано,",
          "rv": "что при жизни в доме были,"
        }
      ]
    },
    {
      "s": [
        {
          "de": "Ganz im Stillen und in Ehren",
          "ru": "тихо и честь по чести",
          "rv": "тихо, честь по чести, в срок"
        },
        {
          "de": "Gut gebraten zu verzehren. –",
          "ru": "хорошенько зажарить и съесть. –",
          "rv": "съесть, поджарив, — вот и прок. –"
        },
        {
          "de": "– Freilich war die Trauer groß,",
          "ru": "– Конечно, скорбь была велика,",
          "rv": "– Впрочем, горе велико:"
        },
        {
          "de": "Als sie nun so nackt und bloß",
          "ru": "когда они, голые и ощипанные,",
          "rv": "их, ощипанных легко,"
        },
        {
          "de": "Abgerupft am Herde lagen,",
          "ru": "лежали у очага,",
          "rv": "голых, возле очага, —"
        },
        {
          "de": "Sie, die einst in schönen Tagen",
          "ru": "они, что когда-то в прекрасные дни",
          "rv": "а была им жизнь долга:"
        }
      ]
    },
    {
      "s": [
        {
          "de": "Bald im Hofe, bald im Garten",
          "ru": "то во дворе, то в саду",
          "rv": "то во дворике, то в саду"
        },
        {
          "de": "Lebensfroh im Sande scharrten. –",
          "ru": "весело рылись в песке. –",
          "rv": "рылись весело в песку. –"
        },
        {
          "de": "Ach, Frau Bolte weint aufs neu,",
          "ru": "Ах, госпожа Больте плачет снова,",
          "rv": "Ах, вдова в слезах опять,"
        },
        {
          "de": "Und der Spitz steht auch dabei.",
          "ru": "и шпиц стоит тут же рядом.",
          "rv": "Шпиц при ней — и рад бы спать."
        },
        {
          "de": "Max und Moritz rochen dieses;",
          "ru": "Макс и Мориц это унюхали;",
          "rv": "Чуют оба сорванца:"
        },
        {
          "de": "»Schnell aufs Dach gekrochen!« hieß es.",
          "ru": "«Живо лезем на крышу!» – решили они.",
          "rv": "«Живо на крышу, с крыльца!»"
        }
      ]
    },
    {
      "s": [
        {
          "de": "Durch den Schornstein mit Vergnügen",
          "ru": "Через дымоход они с удовольствием",
          "rv": "Сквозь трубу глядят с высот:"
        },
        {
          "de": "Sehen sie die Hühner liegen,",
          "ru": "видят, как лежат куры,",
          "rv": "курочки — румяный плод,"
        },
        {
          "de": "Die schon ohne Kopf und Gurgeln",
          "ru": "которые уже без голов и глоток",
          "rv": "без голов и без гортаней"
        },
        {
          "de": "Lieblich in der Pfanne schmurgeln. –",
          "ru": "премило шкворчат на сковороде. –",
          "rv": "сладко шкворчат, будто в бане. –"
        },
        {
          "de": "Eben geht mit einem Teller",
          "ru": "Как раз идёт с тарелкой",
          "rv": "А вдова, тарелку взяв,"
        },
        {
          "de": "Witwe Bolte in den Keller,",
          "ru": "вдова Больте в погреб,",
          "rv": "вниз, в подвал, спешит стремглав:"
        }
      ]
    },
    {
      "s": [
        {
          "de": "Dass sie von dem Sauerkohle",
          "ru": "чтобы кислой капусты",
          "rv": "ей капустки бы кислей"
        },
        {
          "de": "Eine Portion sich hole,",
          "ru": "взять себе порцию,",
          "rv": "положить себе скорей,"
        },
        {
          "de": "Wofür sie besonders schwärmt,",
          "ru": "до которой она особенно охоча,",
          "rv": "до которой, грех сказать,"
        },
        {
          "de": "Wenn er wieder aufgewärmt. –",
          "ru": "когда та снова разогрета. –",
          "rv": "разогретой — благодать. –"
        },
        {
          "de": "– Unterdessen auf dem Dache",
          "ru": "– Тем временем на крыше",
          "rv": "– А на крыше между тем"
        },
        {
          "de": "Ist man tätig bei der Sache.",
          "ru": "дело идёт полным ходом.",
          "rv": "дело спорится совсем."
        },
        {
          "de": "Max hat schon mit Vorbedacht",
          "ru": "Макс заранее, с умыслом,",
          "rv": "Макс задумал всё вперёд:"
        },
        {
          "de": "Eine Angel mitgebracht. –",
          "ru": "прихватил с собой удочку. –",
          "rv": "удочку с собой берёт. –"
        }
      ]
    },
    {
      "s": [
        {
          "de": "Schnupdiwup! da wird nach oben",
          "ru": "Шнупдивуп! вот уже наверх",
          "rv": "Шнупдивуп! — пошла наверх"
        },
        {
          "de": "Schon ein Huhn heraufgehoben.",
          "ru": "поднята первая курица.",
          "rv": "курица под общий смех."
        },
        {
          "de": "Schnupdiwup! jetzt Numro zwei;",
          "ru": "Шнупдивуп! теперь номер второй;",
          "rv": "Шнупдивуп! — за ней вторая;"
        },
        {
          "de": "Schnupdiwup! jetzt Numro drei;",
          "ru": "Шнупдивуп! теперь номер третий;",
          "rv": "Шнупдивуп! — и третья с краю;"
        },
        {
          "de": "Und jetzt kommt noch Numro vier:",
          "ru": "а вот подходит и номер четвёртый:",
          "rv": "а четвёртая — сюда:"
        },
        {
          "de": "Schnupdiwup! dich haben wir!! –",
          "ru": "Шнупдивуп! попалась и ты!! –",
          "rv": "Шнупдивуп! — попалась, да!! –"
        },
        {
          "de": "– Zwar der Spitz sah es genau,",
          "ru": "– Правда, шпиц всё прекрасно видел",
          "rv": "– Шпиц-то видел всё как есть"
        },
        {
          "de": "Und er bellt: Rawau! Rawau!",
          "ru": "и лает: Гав-гав! Гав-гав!",
          "rv": "и залаял: «Гав! Гав! Здесь!»"
        }
      ]
    },
    {
      "s": [
        {
          "de": "Aber schon sind sie ganz munter",
          "ru": "Но они уже преспокойно",
          "rv": "Но мальчишки тут как тут:"
        },
        {
          "de": "Fort und von dem Dach herunter. –",
          "ru": "убрались прочь и долой с крыши. –",
          "rv": "с крыши вниз — и удерут. –"
        },
        {
          "de": "– Na! Das wird Spektakel geben,",
          "ru": "– Ну! То-то будет переполох,",
          "rv": "– Ну! Тут будет переполох,"
        },
        {
          "de": "Denn Frau Bolte kommt soeben;",
          "ru": "ведь госпожа Больте как раз идёт;",
          "rv": "ведь вдова идёт, и — ох!"
        },
        {
          "de": "Angewurzelt stand sie da,",
          "ru": "как вкопанная встала она,",
          "rv": "Как вкопанная стоит,"
        },
        {
          "de": "Als sie nach der Pfanne sah.",
          "ru": "когда заглянула в сковороду.",
          "rv": "лишь в сковороду глядит."
        }
      ]
    },
    {
      "s": [
        {
          "de": "Alle Hühner waren fort –",
          "ru": "Все куры пропали –",
          "rv": "Кур как не было — и вот:"
        },
        {
          "de": "»Spitz!!« – das war ihr erstes Wort. –",
          "ru": "«Шпиц!!» – вот было её первое слово. –",
          "rv": "«Шпиц!!» — и голос вопиёт. –"
        },
        {
          "de": "»Oh, du Spitz, du Ungetüm!! –",
          "ru": "«Ах ты, шпиц, ах ты, чудовище!! –",
          "rv": "«Ах ты, Шпиц, разбойник злой!! –"
        },
        {
          "de": "Aber wart! ich komme ihm!!!«",
          "ru": "Но погоди! я до него доберусь!!!»",
          "rv": "Погоди-ка, вот я, стой!!!»"
        },
        {
          "de": "Mit dem Löffel groß und schwer,",
          "ru": "Ложкой, большой и тяжёлой,",
          "rv": "Ложка тяжкая в руках —"
        },
        {
          "de": "Geht es über Spitzen her;",
          "ru": "принимается она за Шпица;",
          "rv": "Шпицу нынче полный крах;"
        },
        {
          "de": "Laut ertönt sein Wehgeschrei,",
          "ru": "громко раздаётся его вопль,",
          "rv": "громко взвыл бедняга пёс,"
        },
        {
          "de": "Denn er fühlt sich schuldenfrei. –",
          "ru": "ведь он-то чувствует себя невиновным. –",
          "rv": "хоть вины и не принёс. –"
        }
      ]
    },
    {
      "s": [
        {
          "de": "– Max und Moritz, im Verstecke,",
          "ru": "– А Макс и Мориц в укрытии",
          "rv": "– Макс и Мориц под забором"
        },
        {
          "de": "Schnarchen aber an der Hecke,",
          "ru": "знай себе похрапывают у изгороди,",
          "rv": "спят-храпят, довольны сбором,"
        },
        {
          "de": "Und vom ganzen Hühnerschmaus",
          "ru": "и от всего куриного пира",
          "rv": "а от пира одного"
        },
        {
          "de": "Guckt nur noch ein Bein heraus. –",
          "ru": "торчит наружу одна только ножка. –",
          "rv": "ножка — больше ничего. –"
        },
        {
          "de": "Dieses war der zweite Streich,",
          "ru": "Это была вторая проделка,",
          "rv": "Вот и второй вышел трюк,"
        },
        {
          "de": "Doch der dritte folgt sogleich.",
          "ru": "а третья последует тотчас.",
          "rv": "а третий поспеет вдруг."
        }
      ]
    }
  ]
}
