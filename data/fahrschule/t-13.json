{
 "id": "t-13",
 "kind": "theory",
 "emoji": "🌱",
 "level": "B1",
 "title": "Umweltbewusst und sparsam fahren",
 "titleTr": "Экономичная и экологичная езда",
 "intro": "Как тратить меньше топлива: заранее переключаться вверх, катиться накатом, глушить мотор при долгом ожидании — и что такое экологическая зона с наклейкой.",
 "sections": [
  {
   "title": "Спокойно и экономно",
   "lines": [
    {
     "de": "Wer vorausschauend fährt, bremst weniger und spart Kraftstoff.",
     "tr": "Кто едет с предвидением, меньше тормозит и экономит топливо."
    },
    {
     "de": "Schalten Sie früh hoch, etwa bei 2000 Umdrehungen pro Minute.",
     "tr": "Переключайтесь вверх рано, примерно при 2000 оборотах в минуту.",
     "o": {
      "hoch": "hoch>hochschalten",
      "schalten": "schalten>hochschalten"
     }
    },
    {
     "de": "Fahren Sie im höchsten möglichen Gang mit niedriger Drehzahl.",
     "tr": "Езжайте на самой высокой возможной передаче с низкими оборотами."
    },
    {
     "de": "Vor einer roten Ampel lassen Sie das Auto einfach ausrollen.",
     "tr": "Перед красным светофором просто дайте машине катиться накатом."
    },
    {
     "de": "Bei 130 km/h braucht ein Auto viel mehr Kraftstoff als bei 100 km/h.",
     "tr": "При 130 км/ч машина расходует намного больше топлива, чем при 100 км/ч."
    }
   ]
  },
  {
   "title": "Мотор на стоянке",
   "lines": [
    {
     "de": "Lassen Sie den Motor nicht im Stand warmlaufen. Das ist sogar verboten.",
     "tr": "Не прогревайте мотор на месте. Это даже запрещено."
    },
    {
     "de": "Ab etwa 20 Sekunden Wartezeit lohnt es sich, den Motor auszuschalten.",
     "tr": "Уже примерно с 20 секунд ожидания стоит заглушить мотор."
    },
    {
     "de": "Zum Beispiel an einer geschlossenen Bahnschranke oder im Stau.",
     "tr": "Например, у закрытого шлагбаума на переезде или в пробке."
    },
    {
     "de": "Die Start-Stopp-Automatik macht das an der Ampel von selbst.",
     "tr": "Система старт-стоп делает это у светофора сама."
    }
   ]
  },
  {
   "title": "Шины, груз, кондиционер",
   "lines": [
    {
     "de": "Wenig Luft in den Reifen erhöht den Verbrauch. Prüfen Sie den Reifendruck.",
     "tr": "Мало воздуха в шинах — выше расход. Проверяйте давление в шинах."
    },
    {
     "de": "Ein leerer Dachträger kostet viel Kraftstoff. Nehmen Sie ihn ab.",
     "tr": "Пустой багажник на крыше тратит много топлива. Снимите его.",
     "o": {
      "ab": "ab>abnehmen",
      "nehmen": "nehmen>abnehmen"
     }
    },
    {
     "de": "Nehmen Sie kein schweres Gepäck mit, das Sie nicht brauchen.",
     "tr": "Не возите с собой тяжёлый багаж, который вам не нужен.",
     "o": {
      "mit": "mit>mitnehmen",
      "nehmen": "nehmen>mitnehmen"
     }
    },
    {
     "de": "Die Klimaanlage braucht Energie. Nutzen Sie sie nur, wenn es nötig ist.",
     "tr": "Кондиционер расходует энергию. Включайте его, только когда нужно."
    }
   ]
  },
  {
   "title": "Экологическая зона",
   "lines": [
    {
     "de": "In eine Umweltzone dürfen Sie nur mit einer grünen Plakette fahren.",
     "tr": "В экологическую зону можно въезжать только с зелёной наклейкой.",
     "sign": "z2701"
    },
    {
     "de": "Die Plakette klebt innen an der Windschutzscheibe.",
     "tr": "Наклейка клеится изнутри на лобовое стекло."
    },
    {
     "de": "Wer ohne Plakette in die Umweltzone fährt, zahlt 100 Euro.",
     "tr": "Кто въезжает в экологическую зону без наклейки, платит 100 евро."
    },
    {
     "de": "Hier endet die Umweltzone.",
     "tr": "Здесь экологическая зона заканчивается.",
     "sign": "z2702"
    }
   ]
  },
  {
   "title": "Шум",
   "lines": [
    {
     "de": "Unnötiger Lärm ist verboten, zum Beispiel lautes Türenschlagen oder Hupen ohne Grund.",
     "tr": "Ненужный шум запрещён, например громкое хлопанье дверями или сигнал без причины."
    },
    {
     "de": "Kurze Wege schaffen Sie oft auch mit dem Fahrrad.",
     "tr": "Короткие расстояния часто можно проехать и на велосипеде."
    }
   ]
  }
 ],
