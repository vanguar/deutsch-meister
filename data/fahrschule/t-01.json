{
 "id": "t-01",
 "kind": "theory",
 "emoji": "🚦",
 "level": "A2–B1",
 "title": "Vorfahrt: Wer fährt zuerst?",
 "titleTr": "Преимущество: кто едет первым?",
 "intro": "Главная тема теории: кто проезжает перекрёсток первым. Слушайте правила, нажимайте на слова и проверьте себя по знакам в конце.",
 "sections": [
  {
   "title": "Правый перед левым",
   "lines": [
    {
     "de": "An einer Kreuzung ohne Ampel und ohne Schilder gilt: rechts vor links.",
     "tr": "На перекрёстке без светофора и без знаков действует правило: правый перед левым."
    },
    {
     "de": "Wer von rechts kommt, darf zuerst fahren.",
     "tr": "Кто едет справа, тот проезжает первым."
    },
    {
     "de": "Kommt ein Fahrzeug von rechts, müssen Sie warten.",
     "tr": "Если справа едет машина, вы должны подождать."
    },
    {
     "de": "Dieses Schild warnt: An der nächsten Kreuzung gilt rechts vor links.",
     "tr": "Этот знак предупреждает: на ближайшем перекрёстке действует правило «правый перед левым».",
     "sign": "z102"
    }
   ]
  },
  {
   "title": "Знаки приоритета",
   "lines": [
    {
     "de": "Dieses Schild bedeutet: Vorfahrt gewähren. Lassen Sie die Fahrzeuge auf der anderen Straße zuerst fahren.",
     "tr": "Этот знак означает: уступите дорогу. Сначала пропустите машины на другой дороге.",
     "sign": "z205"
    },
    {
     "de": "Am Stoppschild müssen Sie immer anhalten, auch wenn die Straße frei ist.",
     "tr": "У знака «Стоп» нужно всегда останавливаться, даже если дорога свободна.",
     "sign": "z206"
    },
    {
     "de": "Dieses Schild gilt nur an der nächsten Kreuzung. Dort haben Sie Vorfahrt.",
     "tr": "Этот знак действует только на ближайшем перекрёстке. Там у вас преимущество.",
     "sign": "z301"
    },
    {
     "de": "Auf einer Vorfahrtstraße haben Sie an allen Kreuzungen Vorfahrt.",
     "tr": "На главной дороге у вас преимущество на всех перекрёстках.",
     "sign": "z306"
    },
    {
     "de": "Hier endet die Vorfahrtstraße. Danach gilt wieder rechts vor links, wenn kein anderes Schild steht.",
     "tr": "Здесь главная дорога заканчивается. Дальше снова действует «правый перед левым», если нет другого знака.",
     "sign": "z307"
    }
   ]
  },
  {
   "title": "Что главнее",
   "lines": [
    {
     "de": "Die Zeichen der Polizei sind wichtiger als die Ampel.",
     "tr": "Сигналы полиции важнее светофора."
    },
    {
     "de": "Die Ampel ist wichtiger als die Verkehrszeichen.",
     "tr": "Светофор важнее дорожных знаков."
    },
    {
     "de": "Die Verkehrszeichen sind wichtiger als die Regel rechts vor links.",
     "tr": "Дорожные знаки важнее правила «правый перед левым»."
    }
   ]
  },
  {
   "title": "Поворот налево",
   "lines": [
    {
     "de": "Wer links abbiegt, muss den Gegenverkehr zuerst durchfahren lassen.",
     "tr": "Кто поворачивает налево, должен сначала пропустить встречный транспорт."
    },
    {
     "de": "Blinken Sie rechtzeitig, damit die anderen wissen, wohin Sie fahren.",
     "tr": "Включайте поворотник заранее, чтобы другие знали, куда вы едете."
    }
   ]
  }
 ],
