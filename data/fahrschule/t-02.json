{
 "id": "t-02",
 "kind": "theory",
 "emoji": "🚸",
 "level": "A2–B1",
 "title": "Verkehrszeichen und Ampeln",
 "titleTr": "Дорожные знаки и светофоры",
 "intro": "Какие бывают знаки, что запрещено, как меняется скорость в населённом пункте и что значат сигналы светофора в Германии — включая красный с жёлтым и табличку с зелёной стрелкой.",
 "sections": [
  {
   "title": "Три вида знаков",
   "lines": [
    {
     "de": "Gefahrzeichen sind Dreiecke mit rotem Rand. Sie warnen vor einer Gefahr.",
     "tr": "Предупреждающие знаки — треугольники с красной каймой. Они предупреждают об опасности.",
     "sign": "z101"
    },
    {
     "de": "Vorschriftzeichen sind meistens rund. Sie verbieten oder erlauben etwas.",
     "tr": "Предписывающие и запрещающие знаки чаще всего круглые. Они что-то запрещают или разрешают.",
     "sign": "z267"
    },
    {
     "de": "Richtzeichen sind meistens eckig. Sie geben Hinweise, zum Beispiel zum Zebrastreifen.",
     "tr": "Информационные знаки чаще всего прямоугольные. Они подсказывают, например, где пешеходный переход.",
     "sign": "z350"
    }
   ]
  },
  {
   "title": "Запреты",
   "lines": [
    {
     "de": "In diese Straße dürfen Sie nicht hineinfahren.",
     "tr": "На эту улицу въезжать нельзя.",
     "sign": "z267"
    },
    {
     "de": "Hier dürfen Sie höchstens dreißig Kilometer pro Stunde fahren.",
     "tr": "Здесь можно ехать не быстрее тридцати километров в час.",
     "sign": "z274"
    },
    {
     "de": "Hier dürfen Sie keine anderen Autos überholen.",
     "tr": "Здесь нельзя обгонять другие машины.",
     "sign": "z276"
    },
    {
     "de": "Absolutes Haltverbot: Hier dürfen Sie nicht einmal kurz halten.",
     "tr": "Остановка запрещена полностью: здесь нельзя остановиться даже на минуту.",
     "sign": "z283"
    },
    {
     "de": "Eingeschränktes Haltverbot: Sie dürfen höchstens drei Minuten halten oder kurz zum Ein- und Aussteigen.",
     "tr": "Стоянка запрещена: остановиться можно не больше чем на три минуты или ненадолго, чтобы сесть или выйти.",
     "o": {
      "ein": "ein>einsteigen"
     },
     "sign": "z286"
    }
   ]
  },
  {
   "title": "В населённом пункте",
   "lines": [
    {
     "de": "Ab dem gelben Ortsschild gilt innerorts fünfzig Kilometer pro Stunde.",
     "tr": "С жёлтой таблички с названием населённого пункта действует ограничение пятьдесят километров в час.",
     "o": {
      "ab": "ab>ab"
     },
     "sign": "z310"
    },
    {
     "de": "Am Ortsende gilt außerorts höchstens hundert Kilometer pro Stunde.",
     "tr": "После таблички конца населённого пункта — не больше ста километров в час.",
     "sign": "z311"
    },
    {
     "de": "In einer Tempo-30-Zone gilt überall höchstens dreißig. Meistens gilt dort rechts vor links.",
     "tr": "В зоне Tempo 30 везде не больше тридцати. Обычно там действует «правый перед левым».",
     "sign": "z2741"
    },
    {
     "de": "Im verkehrsberuhigten Bereich fahren Sie Schrittgeschwindigkeit. Kinder dürfen überall spielen.",
     "tr": "В жилой зоне ездят со скоростью пешехода. Дети могут играть везде.",
     "sign": "z3251"
    },
    {
     "de": "Am Zebrastreifen haben Fußgänger Vorrang. Halten Sie an, wenn jemand über die Straße gehen will.",
     "tr": "На «зебре» у пешеходов преимущество. Остановитесь, если кто-то хочет перейти дорогу.",
     "o": {
      "an": "an>anhalten",
      "halten": "halten>anhalten"
     },
     "sign": "z350"
    },
    {
     "de": "Achtung, Kinder! Fahren Sie hier besonders langsam und vorsichtig.",
     "tr": "Внимание, дети! Здесь едьте особенно медленно и осторожно.",
     "sign": "z136"
    }
   ]
  },
  {
   "title": "Светофор",
   "lines": [
    {
     "de": "Rot bedeutet: Halten Sie vor der Haltlinie an.",
     "tr": "Красный означает: остановитесь перед стоп-линией.",
     "o": {
      "an": "an>anhalten",
      "halten": "halten>anhalten"
     }
    },
    {
     "de": "Rot und Gelb zusammen bedeutet: Gleich kommt Grün, aber Sie dürfen noch nicht fahren.",
     "tr": "Красный и жёлтый вместе означают: сейчас будет зелёный, но ехать ещё нельзя."
    },
    {
     "de": "Gelb bedeutet: Halten Sie an, wenn das noch sicher möglich ist.",
     "tr": "Жёлтый означает: остановитесь, если это ещё можно сделать безопасно.",
     "o": {
      "an": "an>anhalten",
      "halten": "halten>anhalten"
     }
    },
    {
     "de": "Bei Grün dürfen Sie fahren, aber achten Sie auf Fußgänger und Radfahrer.",
     "tr": "На зелёный можно ехать, но следите за пешеходами и велосипедистами."
    },
    {
     "de": "Wer bei Rot fährt, zahlt mindestens neunzig Euro und bekommt einen Punkt in Flensburg.",
     "tr": "Кто едет на красный, платит не меньше девяноста евро и получает штрафной балл во Фленсбурге."
    },
    {
     "de": "Ist die Ampel ausgefallen, gelten die Verkehrszeichen.",
     "tr": "Если светофор не работает, действуют дорожные знаки."
    }
   ]
  },
  {
   "title": "Зелёная стрелка",
   "lines": [
    {
     "de": "Der grüne Pfeil neben der Ampel ist ein Schild aus Metall, kein Licht.",
     "tr": "Зелёная стрелка рядом со светофором — металлическая табличка, а не сигнал.",
     "sign": "z720"
    },
    {
     "de": "Mit diesem Schild dürfen Sie bei Rot rechts abbiegen, aber nur nach einem vollständigen Halt.",
     "tr": "С этой табличкой на красный можно повернуть направо, но только после полной остановки."
    },
    {
     "de": "Fußgänger und Radfahrer mit Grün dürfen Sie dabei nicht behindern.",
     "tr": "Пешеходам и велосипедистам, у которых зелёный, мешать при этом нельзя."
    }
   ]
  }
 ],
