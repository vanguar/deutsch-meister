{
 "id": "t-09",
 "kind": "theory",
 "emoji": "🔧",
 "level": "B1",
 "title": "Technik und Fahrzeugkontrolle",
 "titleTr": "Техника и проверка машины",
 "intro": "Что проверить перед поездкой: шины, свет, масло, жидкости; что обязательно должно быть в машине; что значат контрольные лампы и как часто нужен техосмотр (HU).",
 "sections": [
  {
   "title": "Шины",
   "lines": [
    {
     "de": "Das Reifenprofil muss mindestens 1,6 Millimeter tief sein.",
     "tr": "Глубина протектора должна быть не меньше 1,6 миллиметра."
    },
    {
     "de": "Sicherer sind 3 Millimeter im Sommer und 4 Millimeter im Winter.",
     "tr": "Безопаснее 3 миллиметра летом и 4 миллиметра зимой."
    },
    {
     "de": "Prüfen Sie den Reifendruck alle zwei Wochen und vor langen Fahrten.",
     "tr": "Проверяйте давление в шинах каждые две недели и перед долгими поездками."
    }
   ]
  },
  {
   "title": "Свет, масло и жидкости",
   "lines": [
    {
     "de": "Vor der Fahrt kontrollieren Sie Licht, Blinker und Bremslicht.",
     "tr": "Перед поездкой вы проверяете фары, поворотники и стоп-сигналы."
    },
    {
     "de": "Den Ölstand prüfen Sie mit dem Ölmessstab, bei kaltem Motor und auf ebener Straße.",
     "tr": "Уровень масла проверяют щупом, на холодном двигателе и на ровной дороге."
    },
    {
     "de": "Kontrollieren Sie auch Kühlwasser, Bremsflüssigkeit und Scheibenwaschwasser.",
     "tr": "Проверяйте также охлаждающую жидкость, тормозную жидкость и воду омывателя."
    },
    {
     "de": "Im Winter braucht das Scheibenwaschwasser Frostschutz.",
     "tr": "Зимой в воду омывателя нужен антифриз."
    }
   ]
  },
  {
   "title": "Контрольные лампы",
   "lines": [
    {
     "de": "Leuchtet eine rote Kontrollleuchte, halten Sie sofort an einer sicheren Stelle an.",
     "tr": "Если горит красная контрольная лампа, сразу остановитесь в безопасном месте.",
     "o": {
      "an": "an>anhalten",
      "halten": "halten>anhalten"
     }
    },
    {
     "de": "Eine gelbe Kontrollleuchte bedeutet: Bald in die Werkstatt fahren.",
     "tr": "Жёлтая контрольная лампа означает: скоро нужно в мастерскую."
    },
    {
     "de": "Rot sind zum Beispiel Öldruck, Bremsanlage und Batterie.",
     "tr": "Красные — например, давление масла, тормоз и аккумулятор."
    }
   ]
  },
  {
   "title": "Обязательно в машине",
   "lines": [
    {
     "de": "Im Auto müssen ein Warndreieck, ein Verbandkasten und eine Warnweste sein.",
     "tr": "В машине должны быть знак аварийной остановки, аптечка и светоотражающий жилет."
    },
    {
     "de": "Die Warnweste liegt am besten griffbereit neben dem Fahrersitz.",
     "tr": "Жилет лучше держать под рукой рядом с водительским сиденьем."
    },
    {
     "de": "Ladung im Auto müssen Sie sichern, damit sie beim Bremsen nicht nach vorne fliegt.",
     "tr": "Груз в машине нужно закрепить, чтобы при торможении он не полетел вперёд."
    }
   ]
  },
  {
   "title": "Техосмотр",
   "lines": [
    {
     "de": "Alle zwei Jahre muss das Auto zur Hauptuntersuchung, kurz HU.",
     "tr": "Каждые два года машина должна проходить техосмотр, сокращённо HU."
    },
    {
     "de": "Ein neues Auto muss erst nach drei Jahren zur HU.",
     "tr": "Новая машина впервые идёт на HU только через три года."
    },
    {
     "de": "Die Plakette auf dem hinteren Kennzeichen zeigt, wann die nächste HU fällig ist.",
     "tr": "Наклейка на заднем номере показывает, когда следующий техосмотр."
    }
   ]
  }
 ],
