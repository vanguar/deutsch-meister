{
 "id": "t-14",
 "kind": "theory",
 "emoji": "🎓",
 "level": "B1",
 "title": "Die Fahrprüfung",
 "titleTr": "Экзамен на права",
 "intro": "Как устроен путь к правам в Германии: обязательные поездки в автошколе, теоретический и практический экзамен, типичные ошибки и испытательный срок после экзамена.",
 "sections": [
  {
   "title": "Путь к правам",
   "lines": [
    {
     "de": "Für den Führerschein der Klasse B brauchen Sie einen Sehtest und einen Kurs in Erster Hilfe.",
     "tr": "Для прав категории B вам нужны проверка зрения и курс первой помощи."
    },
    {
     "de": "Mit dem Antrag gehen Sie zur Führerscheinstelle Ihrer Stadt.",
     "tr": "С заявлением вы идёте в отдел водительских удостоверений своего города."
    },
    {
     "de": "In der Fahrschule lernen Sie die Theorie und machen Fahrstunden.",
     "tr": "В автошколе вы учите теорию и берёте уроки вождения."
    },
    {
     "de": "Pflicht sind zwölf besondere Fahrten: fünf auf der Landstraße, vier auf der Autobahn und drei bei Dunkelheit.",
     "tr": "Обязательны двенадцать особых поездок: пять по загородной дороге, четыре по автобану и три в темноте."
    },
    {
     "de": "Jede dieser Fahrten dauert 45 Minuten.",
     "tr": "Каждая из этих поездок длится 45 минут."
    }
   ]
  },
  {
   "title": "Теоретический экзамен",
   "lines": [
    {
     "de": "Die Theorieprüfung machen Sie am Computer, zum Beispiel beim TÜV oder bei der DEKRA.",
     "tr": "Теоретический экзамен вы сдаёте на компьютере, например в TÜV или DEKRA."
    },
    {
     "de": "Sie bekommen 30 Fragen. Jede Frage hat zwei bis fünf Fehlerpunkte.",
     "tr": "Вы получаете 30 вопросов. Каждый вопрос стоит от двух до пяти штрафных баллов."
    },
    {
     "de": "Mit höchstens zehn Fehlerpunkten haben Sie bestanden.",
     "tr": "Если штрафных баллов не больше десяти, экзамен сдан."
    },
    {
     "de": "Aber zwei falsche Antworten mit fünf Fehlerpunkten bedeuten: nicht bestanden.",
     "tr": "Но два неверных ответа по пять штрафных баллов означают: не сдано."
    },
    {
     "de": "Nach der Theorieprüfung haben Sie zwölf Monate Zeit für die praktische Prüfung.",
     "tr": "После теоретического экзамена у вас есть двенадцать месяцев на практический."
    }
   ]
  },
  {
   "title": "Практический экзамен",
   "lines": [
    {
     "de": "Die praktische Prüfung dauert etwa 55 Minuten.",
     "tr": "Практический экзамен длится около 55 минут."
    },
    {
     "de": "Hinten sitzt der Prüfer, neben Ihnen sitzt Ihr Fahrlehrer.",
     "tr": "Сзади сидит экзаменатор, рядом с вами — ваш инструктор."
    },
    {
     "de": "Am Anfang zeigen Sie bei der Sicherheitskontrolle, wo Licht, Öl und Bremsanlage zu prüfen sind.",
     "tr": "Вначале на проверке безопасности вы показываете, где проверяют свет, масло и тормозную систему."
    },
    {
     "de": "Typische Aufgaben sind rückwärts Einparken, Umkehren und eine Gefahrbremsung.",
     "tr": "Типичные задания — парковка задним ходом, разворот и экстренное торможение."
    },
    {
     "de": "Einen Teil der Strecke fahren Sie selbstständig nach Schildern oder nach dem Navi.",
     "tr": "Часть маршрута вы едете самостоятельно — по указателям или по навигатору."
    },
    {
     "de": "Haben Sie eine Anweisung nicht verstanden, fragen Sie einfach nach.",
     "tr": "Если вы не поняли указание, просто переспросите.",
     "o": {
      "fragen": "fragen>nachfragen",
      "nach": "nach>nachfragen"
     }
    }
   ]
  },
  {
   "title": "Типичные ошибки",
   "lines": [
    {
     "de": "Am Stoppschild halten Sie immer ganz an, auch wenn niemand kommt.",
     "tr": "У знака «Стоп» всегда останавливайтесь полностью, даже если никто не едет.",
     "o": {
      "an": "an>anhalten",
      "halten": "halten>anhalten"
     },
     "sign": "z206"
    },
    {
     "de": "Bei diesem Schild lassen Sie die anderen zuerst fahren.",
     "tr": "При этом знаке вы сначала пропускаете других.",
     "sign": "z205"
    },
    {
     "de": "Wer schneller als erlaubt fährt, fällt oft durch.",
     "tr": "Кто едет быстрее разрешённого, часто проваливает экзамен.",
     "o": {
      "durch": "durch>durchfallen",
      "fällt": "fällt>durchfallen"
     },
     "sign": "z274"
    },
    {
     "de": "Im verkehrsberuhigten Bereich fahren Sie nur Schrittgeschwindigkeit.",
     "tr": "В жилой зоне вы едете только со скоростью пешехода.",
     "sign": "z3251"
    },
    {
     "de": "Vergessen Sie den Schulterblick nicht: beim Abbiegen und beim Spurwechsel.",
     "tr": "Не забывайте смотреть через плечо: при повороте и при смене полосы."
    }
   ]
  },
  {
   "title": "После экзамена",
   "lines": [
    {
     "de": "Nach der Prüfung bekommen Sie den Führerschein auf Probe.",
     "tr": "После экзамена вы получаете права с испытательным сроком."
    },
    {
     "de": "Die Probezeit dauert zwei Jahre.",
     "tr": "Испытательный срок длится два года."
    },
    {
     "de": "In der Probezeit und unter 21 Jahren gilt 0,0 Promille.",
     "tr": "В испытательный срок и до 21 года действует 0,0 промилле."
    },
    {
     "de": "Nach einem schweren Verstoß dauert die Probezeit vier Jahre, und Sie müssen ein Aufbauseminar machen.",
     "tr": "После серьёзного нарушения испытательный срок длится четыре года, и вы должны пройти специальный семинар."
    },
    {
     "de": "Sind Sie durchgefallen, können Sie die Prüfung meistens nach zwei Wochen wiederholen.",
     "tr": "Если вы провалились, пересдать экзамен обычно можно через две недели."
    }
   ]
  }
 ],
