{
 "id": "t-03",
 "kind": "theory",
 "emoji": "⏱️",
 "level": "A2–B1",
 "title": "Geschwindigkeit und Abstand",
 "titleTr": "Скорость и дистанция",
 "intro": "Сколько можно ехать в городе, за городом и на автобане, как считать тормозной путь и дистанцию и почему в испытательный срок превышение обходится особенно дорого.",
 "sections": [
  {
   "title": "Ограничения скорости",
   "lines": [
    {
     "de": "Innerorts gilt für Autos höchstens fünfzig Kilometer pro Stunde.",
     "tr": "В населённом пункте для легковых — не больше пятидесяти километров в час."
    },
    {
     "de": "Außerorts gilt höchstens hundert Kilometer pro Stunde.",
     "tr": "Вне населённого пункта — не больше ста километров в час."
    },
    {
     "de": "Auf der Autobahn gibt es für Autos kein allgemeines Tempolimit.",
     "tr": "На автобане для легковых нет общего ограничения скорости.",
     "o": {
      "es": "es>es gibt"
     },
     "sign": "z3301"
    },
    {
     "de": "Empfohlen sind aber höchstens hundertdreißig. Das ist die Richtgeschwindigkeit.",
     "tr": "Но рекомендуется не больше ста тридцати. Это рекомендуемая скорость."
    },
    {
     "de": "Ein blaues eckiges Schild mit einer Zahl ist eine Richtgeschwindigkeit: eine Empfehlung, kein Verbot.",
     "tr": "Синий прямоугольный знак с числом — рекомендуемая скорость: совет, а не запрет.",
     "sign": "z380"
    },
    {
     "de": "Ein Verkehrszeichen kann eine andere Höchstgeschwindigkeit vorschreiben. Dann gilt das Schild.",
     "tr": "Знак может установить другую максимальную скорость. Тогда действует знак.",
     "sign": "z274"
    },
    {
     "de": "Dieses Schild hebt alle Verbote auf, zum Beispiel ein Tempolimit oder ein Überholverbot.",
     "tr": "Этот знак отменяет все запреты, например ограничение скорости или запрет обгона.",
     "o": {
      "auf": "auf>aufheben",
      "hebt": "hebt>aufheben"
     },
     "sign": "z282"
    }
   ]
  },
  {
   "title": "Скорость по обстановке",
   "lines": [
    {
     "de": "Sie müssen immer innerhalb der Strecke anhalten können, die Sie überblicken.",
     "tr": "Вы всегда должны успеть остановиться в пределах участка, который видите."
    },
    {
     "de": "Bei Nebel mit Sicht unter fünfzig Metern dürfen Sie höchstens fünfzig fahren.",
     "tr": "В тумане при видимости меньше пятидесяти метров можно ехать не быстрее пятидесяти."
    },
    {
     "de": "Bei Regen, Schnee und Glätte ist der Bremsweg viel länger.",
     "tr": "В дождь, снег и гололёд тормозной путь намного длиннее."
    }
   ]
  },
  {
   "title": "Тормозной путь",
   "lines": [
    {
     "de": "Reaktionsweg in Metern: Geschwindigkeit geteilt durch zehn, mal drei.",
     "tr": "Путь реакции в метрах: скорость разделить на десять и умножить на три.",
     "o": {
      "durch": "durch>geteilt durch",
      "geteilt": "geteilt>geteilt durch"
     }
    },
    {
     "de": "Bremsweg in Metern: Geschwindigkeit geteilt durch zehn, und das Ergebnis mal sich selbst.",
     "tr": "Тормозной путь в метрах: скорость разделить на десять и результат умножить сам на себя.",
     "o": {
      "durch": "durch>geteilt durch",
      "geteilt": "geteilt>geteilt durch"
     }
    },
    {
     "de": "Der Anhalteweg ist Reaktionsweg plus Bremsweg.",
     "tr": "Остановочный путь — это путь реакции плюс тормозной путь."
    },
    {
     "de": "Bei einer Gefahrbremsung ist der Bremsweg nur halb so lang.",
     "tr": "При экстренном торможении тормозной путь вдвое короче."
    }
   ]
  },
  {
   "title": "Дистанция",
   "lines": [
    {
     "de": "Außerorts gilt: Abstand in Metern ist gleich halber Tacho.",
     "tr": "Вне населённого пункта: дистанция в метрах — половина показаний спидометра."
    },
    {
     "de": "Einfacher ist die Zwei-Sekunden-Regel: Zählen Sie „einundzwanzig, zweiundzwanzig“.",
     "tr": "Проще правило двух секунд: считайте «двадцать один, двадцать два»."
    },
    {
     "de": "Wer den Abstand nicht einhält, riskiert Bußgeld, Punkte und Fahrverbot.",
     "tr": "Кто не соблюдает дистанцию, рискует штрафом, баллами и лишением прав."
    }
   ]
  },
  {
   "title": "Штрафы и испытательный срок",
   "lines": [
    {
     "de": "Wer innerorts mehr als dreißig Kilometer pro Stunde schneller fährt als erlaubt, bekommt ein Fahrverbot.",
     "tr": "Кто превышает скорость в населённом пункте больше чем на тридцать километров в час, лишается прав на время."
    },
    {
     "de": "In der Probezeit ist schon eine Überschreitung ab einundzwanzig Kilometern pro Stunde ein schwerer Verstoß.",
     "tr": "В испытательный срок уже превышение от двадцати одного километра в час — серьёзное нарушение."
    },
    {
     "de": "Dann müssen Sie ein Aufbauseminar machen, und die Probezeit verlängert sich auf vier Jahre.",
     "tr": "Тогда нужно пройти курс Aufbauseminar, а испытательный срок продлевается до четырёх лет."
    },
    {
     "de": "Apps, die vor Blitzern warnen, sind beim Fahren verboten.",
     "tr": "Приложения, которые предупреждают о камерах контроля скорости, за рулём запрещены."
    }
   ]
  }
 ],
