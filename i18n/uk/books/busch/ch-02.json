{"id":"ch-02","title":"Erster Streich","titleRu":"Витівка перша","paragraphs":[{"s":[{"de":"Mancher gibt sich viele Müh’","ru":"Дехто не шкодує праці","rv":"Багато сил кладе інший"},{"de":"Mit dem lieben Federvieh;","ru":"заради милої домашньої птиці;","rv":"ради птахи наймиліший:"},{"de":"Einesteils der Eier wegen,","ru":"по-перше, заради яєць,","rv":"перше — птаха нам несе"},{"de":"Welche diese Vögel legen,","ru":"які ці птахи несуть,","rv":"яйця, і на рік усе;"},{"de":"Zweitens: weil man dann und wann","ru":"по-друге, тому що час від часу","rv":"справа друга: інколи"},{"de":"Einen Braten essen kann;","ru":"можна з'їсти печеню;","rv":"пахне печеня з плити;"}]},{"s":[{"de":"Drittens aber nimmt man auch","ru":"по-третє ж, ідуть у діло","rv":"третє — пух, і пух хороший:"},{"de":"Ihre Federn zum Gebrauch","ru":"і їхнє пір'я —","rv":"з нього подушка, як грошик,"},{"de":"In die Kissen und die Pfühle,","ru":"у подушки й перини,","rv":"у перині ляжеш сам —"},{"de":"Denn man liegt nicht gerne kühle. –","ru":"бо в холоді лежати ніхто не любить. –","rv":"не до вподоби холод нам. –"},{"de":"Seht, da ist die Witwe Bolte,","ru":"Гляньте, ось удова Больте,","rv":"Ось удова, звуть Больте,"},{"de":"Die das auch nicht gerne wollte.","ru":"яка теж цього не хотіла.","rv":"їй мила затишна хата."}]},{"s":[{"de":"Ihrer Hühner waren drei","ru":"Курей у неї було три","rv":"Курей мала вона три"},{"de":"Und ein stolzer Hahn dabei. –","ru":"та при них гордий півень. –","rv":"й півень з ними, подивись. –"},{"de":"Max und Moritz dachten nun:","ru":"І от Макс і Моріц подумали:","rv":"Макс і Моріц мислять так:"},{"de":"Was ist hier jetzt wohl zu tun? –","ru":"а що б тут таке утнути? –","rv":"що б утнути, та ще й як? –"},{"de":"– Ganz geschwinde, eins, zwei, drei,","ru":"– Хутко, раз, два, три,","rv":"– Швидко, швидко: раз, два, три! —"},{"de":"Schneiden sie sich Brot entzwei,","ru":"ріжуть вони собі хліб навпіл,","rv":"хліб розрізано, дивись:"}]},{"s":[{"de":"In vier Teile, jedes Stück","ru":"на чотири частини, кожен шматок","rv":"на чотири — і всякий"},{"de":"Wie ein kleiner Finger dick.","ru":"завтовшки з мізинець.","rv":"з пальчик завтовшки такий."},{"de":"Diese binden sie an Fäden,","ru":"Їх прив'язують вони до ниток,","rv":"До ниток прив'язав їх кожен,"},{"de":"Übers Kreuz, ein Stück an jeden,","ru":"навхрест, по шматку на кожну,","rv":"навхрест, шматок — отак, можна,"},{"de":"Und verlegen sie, genau","ru":"і розкладають акуратно","rv":"і розкладено зрання"},{"de":"In den Hof der guten Frau. –","ru":"на подвір'ї доброї жінки. –","rv":"в удови серед подвір'я. –"}]},{"s":[{"de":"Kaum hat dies der Hahn gesehen,","ru":"Тільки-но півень це побачив,","rv":"Щойно вгледів півник те,"},{"de":"Fängt er auch schon an zu krähen:","ru":"як уже починає кукурікати:","rv":"як заспівав він на все:"},{"de":"Kikeriki! Kikikerikih!! –","ru":"Кукуріку! Кукурікууу!! –","rv":"«Кукуріку! Кукуріку!» –"},{"de":"Tak tak tak! – da kommen sie.","ru":"Ко-ко-ко! – ось вони й біжать.","rv":"Ко-ко-ко! — і всі до шматку."},{"de":"Hahn und Hühner schlucken munter","ru":"Півень і кури жваво ковтають","rv":"Півник з курками, як треба,"},{"de":"Jedes ein Stück Brot hinunter;","ru":"кожен по шматку хліба;","rv":"хліб ковтають, мов із неба;"}]},{"s":[{"de":"Aber als sie sich besinnen,","ru":"але коли вони схаменулися,","rv":"та отямились — та де:"},{"de":"Konnte keines recht von hinnen.","ru":"жодна вже не може втекти геть.","rv":"жодна вже не відійде."},{"de":"In die Kreuz und in die Quer","ru":"Вздовж і впоперек","rv":"Вздовж і впоперек, стогнучи,"},{"de":"Reißen sie sich hin und her,","ru":"рвуться вони туди-сюди,","rv":"рвуться, б'ються, тріпочучи,"},{"de":"Flattern auf und in die Höh’,","ru":"злітають, б'ються вгору,","rv":"вгору злітають поспіхом —"},{"de":"Ach herrje, herrjemine!","ru":"ах ти господи, господи боже!","rv":"ах ти господи, ах-ах!"}]},{"s":[{"de":"Ach, sie bleiben an dem langen","ru":"Ах, вони повисають на довгому","rv":"Ах, повисли, бідолахи,"},{"de":"Dürren Ast des Baumes hangen. –","ru":"сухому суку дерева. –","rv":"на суку сухої дровиняки. –"},{"de":"– Und ihr Hals wird lang und länger,","ru":"– І шиї в них дедалі довшають,","rv":"– Шиї тягнуться все довше,"},{"de":"Ihr Gesang wird bang und bänger;","ru":"і спів дедалі тужливіший;","rv":"пісня — глухіша й моторошніша;"},{"de":"Jedes legt noch schnell ein Ei,","ru":"кожна похапцем несе ще яйце,","rv":"кожна знесе яйце —"},{"de":"Und dann kommt der Tod herbei. –","ru":"а потім приходить смерть. –","rv":"і приходить смерть за те. –"}]},{"s":[{"de":"Witwe Bolte, in der Kammer,","ru":"Удова Больте у своїй комірчині","rv":"А вдова, лежачи в ліжку,"},{"de":"Hört im Bette diesen Jammer;","ru":"чує в ліжку цей плач;","rv":"чує зойки й тихий плач;"},{"de":"Ahnungsvoll tritt sie heraus:","ru":"із недобрим передчуттям виходить вона:","rv":"чує лихо, йде у сад:"},{"de":"Ach, was war das für ein Graus!","ru":"ах, який жах їй відкрився!","rv":"ах, що бачить її погляд!"},{"de":"»Fließet aus dem Aug’, ihr Tränen!","ru":"«Лийтеся з очей, сльози!","rv":"«Лийтеся, сльози, лийтеся сміло!"},{"de":"All mein Hoffen, all mein Sehnen,","ru":"Усе, на що я сподівалася, за чим тужила,","rv":"Усе, за чим душа боліла,"},{"de":"Meines Lebens schönster Traum","ru":"найкраща мрія мого життя","rv":"найкращий сон і найкращий час"},{"de":"Hängt an diesem Apfelbaum!!«","ru":"висить на цій яблуні!!»","rv":"на суку висить у нас!!»"}]},{"s":[{"de":"Tiefbetrübt und sorgenschwer","ru":"Убита горем і сповнена тяжких турбот,","rv":"Уся в печалі й у тузі,"},{"de":"Kriegt sie jetzt das Messer her;","ru":"дістає вона тепер ніж;","rv":"ніж несе вона в руці;"},{"de":"Nimmt die Toten von den Strängen,","ru":"знімає мертвих із мотузок,","rv":"мертвих зніме з мотузка,"},{"de":"Dass sie so nicht länger hängen,","ru":"щоб вони так більше не висіли,","rv":"щоб не висли там, гірка,"},{"de":"Und mit stummem Trauerblick","ru":"і з німим скорботним поглядом","rv":"і з німою тугою в очах"},{"de":"Kehrt sie in ihr Haus zurück. –","ru":"повертається до себе в дім. –","rv":"в дім іде, вся у сльозах. –"},{"de":"Dieses war der erste Streich,","ru":"Це була перша витівка,","rv":"От і перша вийшла штука,"},{"de":"Doch der zweite folgt sogleich.","ru":"а друга настане негайно.","rv":"а друга вже стука."}]}]}