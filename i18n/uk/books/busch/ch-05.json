{"id":"ch-05","title":"Vierter Streich","titleRu":"Витівка четверта","paragraphs":[{"s":[{"de":"Also lautet ein Beschluss:","ru":"Отже, говорить рішення:","rv":"Так уже велить нам доля:"},{"de":"Dass der Mensch was lernen muss. –","ru":"людина має чогось учитися. –","rv":"вчись, людино, — твоя воля. –"},{"de":"– Nicht allein das A-B-C","ru":"– Не сама лише абетка","rv":"– Не одна лише азбука"},{"de":"Bringt den Menschen in die Höh’;","ru":"підносить людину вгору;","rv":"нас підносить, як наука;"},{"de":"Nicht allein im Schreiben, Lesen","ru":"не лише в письмі й читанні","rv":"не в письмі лише й читанні"},{"de":"Übt sich ein vernünftig Wesen;","ru":"вправляється розумна істота;","rv":"розум прагне вправляння;"}]},{"s":[{"de":"Nicht allein in Rechnungssachen","ru":"не лише в лічильних справах","rv":"і не лише в рахунку строгім"},{"de":"Soll der Mensch sich Mühe machen;","ru":"повинна людина докладати старання;","rv":"треба битися над підсумком;"},{"de":"Sondern auch der Weisheit Lehren","ru":"але й настанови мудрості","rv":"але й мудрі науки"},{"de":"Muss man mit Vergnügen hören. –","ru":"треба слухати із задоволенням. –","rv":"слухати треба без нудьги. –"}]},{"s":[{"de":"Dass dies mit Verstand geschah,","ru":"А щоб усе це йшло з толком,","rv":"А щоб з толком йшло навчання,"},{"de":"War Herr Lehrer Lämpel da. –","ru":"на те був пан учитель Лемпель. –","rv":"Лемпель був там, без вагання. –"},{"de":"– Max und Moritz, diese beiden,","ru":"– Макс і Моріц, ці двоє,","rv":"– Лемпеля хлопчаків пара"},{"de":"Mochten ihn darum nicht leiden;","ru":"за це його терпіти не могли;","rv":"не терпіла, наче кара;"},{"de":"Denn wer böse Streiche macht,","ru":"бо хто влаштовує злі витівки,","rv":"бо хто капостить зрання,"},{"de":"Gibt nicht auf den Lehrer acht. –","ru":"той на вчителя не зважає. –","rv":"тим учитель — не рідня. –"}]},{"s":[{"de":"Nun war dieser brave Lehrer","ru":"А був цей славний учитель","rv":"А учитель той зразковий"},{"de":"Von dem Tobak ein Verehrer,","ru":"великим шанувальником тютюну,","rv":"був шанувальник люльки вірний,"},{"de":"Was man ohne alle Frage","ru":"чого, без жодного сумніву,","rv":"і ніхто б не дорікав"},{"de":"Nach des Tages Müh und Plage","ru":"після денних праць і тягот","rv":"старому, що закурював,"},{"de":"Einem guten, alten Mann","ru":"доброму старому","rv":"бо за день праць і бід"},{"de":"Auch von Herzen gönnen kann. –","ru":"від душі можна побажати. –","rv":"чом би й не взяти кисет. –"}]},{"s":[{"de":"– Max und Moritz, unverdrossen,","ru":"– Макс і Моріц, не сумуючи,","rv":"– Макс і Моріц, не боячись,"},{"de":"Sinnen aber schon auf Possen,","ru":"уже замишляють нову капость:","rv":"мислять капость, причаївшись:"},{"de":"Ob vermittelst seiner Pfeifen","ru":"чи не можна цього чоловіка","rv":"чи нема до старого шляху"},{"de":"Dieser Mann nicht anzugreifen. –","ru":"підловити на його люльках. –","rv":"через люльку, без страху? –"},{"de":"– Einstens, als es Sonntag wieder","ru":"– Одного разу, коли знову була неділя","rv":"– Якось раз, у день недільний,"},{"de":"Und Herr Lämpel brav und bieder","ru":"і пан Лемпель, чесний і порядний,","rv":"Лемпель — чесний і сумлінний —"}]},{"s":[{"de":"In der Kirche mit Gefühle","ru":"сидів у церкві з почуттям","rv":"у церкві, почуттям горя,"},{"de":"Saß vor seinem Orgelspiele,","ru":"за своєю грою на органі,","rv":"за орган сів, молячись щиро,"},{"de":"Schlichen sich die bösen Buben","ru":"прокралися злі хлопчаки","rv":"а хлопчаки тієї пори"},{"de":"In sein Haus und seine Stuben,","ru":"до його дому і його кімнат,","rv":"шусть до нього у покої,"},{"de":"Wo die Meerschaumpfeife stand;","ru":"де стояла пінкова люлька;","rv":"люлька пінкова — ось вона;"},{"de":"Max hält sie in seiner Hand;","ru":"Макс тримає її в руці;","rv":"Макс її бере до рук;"}]},{"s":[{"de":"Aber Moritz aus der Tasche","ru":"а Моріц із кишені","rv":"Моріц витяг, наче звук,"},{"de":"Zieht die Flintenpulverflasche,","ru":"дістає порохівницю,","rv":"порохівницю якраз,"},{"de":"Und geschwinde, stopf, stopf, stopf!","ru":"і хутко — сип, сип, сип! —","rv":"і хутчіш: ширк, ширк, ширк! —"},{"de":"Pulver in den Pfeifenkopf. –","ru":"порох у чашечку люльки. –","rv":"порох в люльку — наче вир. –"},{"de":"Jetzt nur still und schnell nach Haus,","ru":"Тепер тихо й швидко додому,","rv":"А тепер нишком — додому:"},{"de":"Denn schon ist die Kirche aus. –","ru":"бо служба вже скінчилася. –","rv":"в церкві вже кінець усьому. –"}]},{"s":[{"de":"– Eben schließt in sanfter Ruh’","ru":"– Якраз у тихому спокої","rv":"– От і Лемпель, тихий, радий,"},{"de":"Lämpel seine Kirche zu;","ru":"замикає Лемпель свою церкву;","rv":"церкву замкнув — усе в ладі;"},{"de":"Und mit Buch und Notenheften,","ru":"і з книжкою та нотними зошитами,","rv":"з нотною текою, з трудами,"},{"de":"Nach besorgten Amtsgeschäften,","ru":"справивши службові справи,","rv":"зі службовими справами,"},{"de":"Lenkt er freudig seine Schritte","ru":"радісно спрямовує він кроки","rv":"він крокує веселіш"},{"de":"Zu der heimatlichen Hütte,","ru":"до рідного будиночка,","rv":"до хатинки, де миліш,"}]},{"s":[{"de":"Und voll Dankbarkeit sodann,","ru":"і потім, сповнений вдячності,","rv":"і, вдячний своїй долі,"},{"de":"Zündet er sein Pfeifchen an.","ru":"розкурює свою люлечку.","rv":"люльку курить у спокої."},{"de":"»Ach!« – spricht er – »die größte Freud’","ru":"«Ах! – каже він, – найбільша радість","rv":"«Ах! — він мовить. — Із відрад"},{"de":"Ist doch die Zufriedenheit!!!«","ru":"це все-таки вдоволення!!!»","rv":"понад усе — сердечний лад!!!»"}]},{"s":[{"de":"Rums!! – da geht die Pfeife los","ru":"Бум!! – тут люлька вибухає","rv":"Бум!! — і люлька рознеслась"},{"de":"Mit Getöse, schrecklich groß.","ru":"з гуркотом, страшенно гучним.","rv":"з диким громом, в той же час."},{"de":"Kaffeetopf und Wasserglas,","ru":"Кавник і склянка для води,","rv":"Кавник, чайник і флакон,"},{"de":"Tobaksdose, Tintenfass,","ru":"табакерка, чорнильниця,","rv":"тютюн, чорнило — все на кін,"},{"de":"Ofen, Tisch und Sorgensitz –","ru":"піч, стіл і насиджене крісло –","rv":"піч і стіл, і крісло теж —"},{"de":"Alles fliegt im Pulverblitz. –","ru":"усе летить у пороховому спалаху. –","rv":"все в огні, і не втечеш. –"}]},{"s":[{"de":"Als der Dampf sich nun erhob,","ru":"Коли дим розвіявся,","rv":"Дим розвіявся, і ось:"},{"de":"Sieht man Lämpel, der gottlob!","ru":"видно Лемпеля, який, слава богу,","rv":"Лемпель, слава богу, — хтось"},{"de":"Lebend auf dem Rücken liegt;","ru":"живий лежить на спині;","rv":"живий лежить собі на спинці,"},{"de":"Doch er hat was abgekriegt.","ru":"але дісталося йому чимало.","rv":"та дісталось всій начинці."},{"de":"Nase, Hand, Gesicht und Ohren","ru":"Ніс, рука, обличчя й вуха","rv":"Ніс, і руки, і виски"},{"de":"Sind so schwarz als wie die Mohren,","ru":"чорні, наче маври;","rv":"чорні, наче вуглики;"},{"de":"Und des Haares letzter Schopf","ru":"і останній чубчик волосся","rv":"а останнє пасмо в нього"},{"de":"Ist verbrannt bis auf den Kopf. –","ru":"згорів до самої голови. –","rv":"геть згоріло до живого. –"}]},{"s":[{"de":"Wer soll nun die Kinder lehren","ru":"Хто ж тепер учитиме дітей","rv":"Хто тепер навчить дітей?"},{"de":"Und die Wissenschaft vermehren?","ru":"і множитиме науку?","rv":"Хто примножить скарб ідей?"},{"de":"Wer soll nun für Lämpel leiten","ru":"Хто тепер за Лемпеля вестиме","rv":"Хто за Лемпеля почне"},{"de":"Seine Amtestätigkeiten?","ru":"його службові заняття?","rv":"все службове, головне?"},{"de":"Woraus soll der Lehrer rauchen,","ru":"З чого тепер учителеві курити,","rv":"І з чого курить йому,"},{"de":"Wenn die Pfeife nicht zu brauchen??","ru":"якщо люлька ні на що не годиться??","rv":"коли люлька — вся в диму??"},{"de":"Mit der Zeit wird alles heil,","ru":"З часом усе загоюється,","rv":"Час лікує все довкола,"},{"de":"Nur die Pfeife hat ihr Teil. –","ru":"лише люльці дісталося своє. –","rv":"тільки люльці — вже ніколи. –"}]},{"s":[{"de":"Dieses war der vierte Streich,","ru":"Це була четверта витівка,","rv":"От четверта вийшла штука,"},{"de":"Doch der fünfte folgt sogleich.","ru":"а п'ята настане негайно.","rv":"а п'ята вже стука."}]}]}