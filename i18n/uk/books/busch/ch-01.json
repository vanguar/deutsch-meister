{"id":"ch-01","title":"Vorwort","titleRu":"Передмова","paragraphs":[{"s":[{"de":"Ach, was muss man oft von bösen","ru":"Ах, скільки ж доводиться про злих","rv":"Ах, про діток, що лихі,"},{"de":"Kindern hören oder lesen!!","ru":"дітей чути або читати!!","rv":"скільки чуток і плітки!"},{"de":"Wie zum Beispiel hier von diesen,","ru":"Ось, наприклад, про цих двох,","rv":"Ось, наприклад, ці обидва —"},{"de":"Welche Max und Moritz hießen;","ru":"яких звали Макс і Моріц;","rv":"Макс і Моріц. Справа кривда:"}]},{"s":[{"de":"Die, anstatt durch weise Lehren","ru":"які, замість того щоб мудрих настанов","rv":"замість мудрого навчання,"},{"de":"Sich zum Guten zu bekehren,","ru":"послухати й навернутися до добра,","rv":"замість доброго старання"},{"de":"Oftmals noch darüber lachten","ru":"частенько ще й сміялися з них","rv":"ті із них — лише на сміх"},{"de":"Und sich heimlich lustig machten. –","ru":"і нишком потішалися. –","rv":"та нишком дражнили всіх. –"},{"de":"– Ja, zur Übeltätigkeit,","ru":"– Так, на лиходійство,","rv":"– Так, на капость і розбій"},{"de":"Ja, dazu ist man bereit! –","ru":"так, на нього-то кожен готовий! –","rv":"кожен ласий, кожен свій! –"}]},{"s":[{"de":"– Menschen necken, Tiere quälen,","ru":"– Людей дражнити, тварин мучити,","rv":"– Люд дражнити, звірів бити,"},{"de":"Äpfel, Birnen, Zwetschen stehlen – –","ru":"яблука, груші, сливи красти – –","rv":"груші, сливи пощупити – –"},{"de":"Das ist freilich angenehmer","ru":"це, звісно, приємніше","rv":"це, ясна річ, миліше"},{"de":"Und dazu auch viel bequemer,","ru":"та й куди зручніше,","rv":"і куди як веселіше,"},{"de":"Als in Kirche oder Schule","ru":"ніж у церкві чи в школі","rv":"ніж у церкві та у школі"},{"de":"Festzusitzen auf dem Stuhle. –","ru":"сидіти сиднем на стільці. –","rv":"на лаві сидіти в неволі. –"}]},{"s":[{"de":"– Aber wehe, wehe, wehe!","ru":"– Але горе, горе, горе!","rv":"– Тільки горе, горе, горе,"},{"de":"Wenn ich, auf das Ende sehe!! –","ru":"коли я дивлюся, чим усе скінчилося!! –","rv":"як дізнаєшся, що скоро! –"},{"de":"– Ach, das war ein schlimmes Ding,","ru":"– Ах, погано вийшла справа,","rv":"– Ах, з хлопчаками сталось"},{"de":"Wie es Max und Moritz ging.","ru":"те, як обернулося для Макса й Моріца.","rv":"те, що зле їм відгукнулось."},{"de":"– Drum ist hier, was sie getrieben,","ru":"– Тому тут усе, що вони накоїли,","rv":"– Тож усе, що наробили,"},{"de":"Abgemalt und aufgeschrieben.","ru":"намальовано й записано.","rv":"у картинках змалювали."}]}]}