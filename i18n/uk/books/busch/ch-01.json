{"id":"ch-01","title":"Vorwort","titleRu":"Передмова","paragraphs":[{"s":[{"de":"Ach, was muss man oft von bösen","ru":"Ах, скільки ж доводиться про злих","rv":"Ах, про діток, що лихі,","g":{"0":"ах","1":"скільки","2":"доводиться","4":"часто","5-6":"про злих"}},{"de":"Kindern hören oder lesen!!","ru":"дітей чути або читати!!","rv":"скільки чуток і плітки!","g":{"0":"дітей","1":"чути","2":"або","3":"читати"}},{"de":"Wie zum Beispiel hier von diesen,","ru":"Ось, наприклад, про цих двох,","rv":"Ось, наприклад, ці обидва —","g":{"3":"тут","0-2":"як-от","4-5":"про цих"}},{"de":"Welche Max und Moritz hießen;","ru":"яких звали Макс і Моріц;","rv":"Макс і Моріц. Справа кривда:","g":{"0":"яких","1":"Макс","3":"Моріц","4":"звали"}}]},{"s":[{"de":"Die, anstatt durch weise Lehren","ru":"які, замість того щоб мудрих настанов","rv":"замість мудрого навчання,","g":{"0":"які","1":"замість того","2-4":"мудрими повчаннями"}},{"de":"Sich zum Guten zu bekehren,","ru":"послухати й навернутися до добра,","rv":"замість доброго старання","g":{"0-2":"до добра","3-4":"навернутися"}},{"de":"Oftmals noch darüber lachten","ru":"частенько ще й сміялися з них","rv":"ті із них — лише на сміх","g":{"0":"частенько","1":"ще","2":"з цього","3":"сміялися"}},{"de":"Und sich heimlich lustig machten. –","ru":"і нишком потішалися. –","rv":"та нишком дражнили всіх. –","g":{"1-4":"нишком кепкували"}},{"de":"– Ja, zur Übeltätigkeit,","ru":"– Так, на лиходійство,","rv":"– Так, на капость і розбій","g":{"0":"так","1-2":"до лихих справ"}},{"de":"Ja, dazu ist man bereit! –","ru":"так, на нього-то кожен готовий! –","rv":"кожен ласий, кожен свій! –","g":{"0":"так","1":"до цього","2":"","4":"готові"}}]},{"s":[{"de":"– Menschen necken, Tiere quälen,","ru":"– Людей дражнити, тварин мучити,","rv":"– Люд дражнити, звірів бити,","g":{"0":"людей","1":"дражнити","2":"звірів","3":"мучити"}},{"de":"Äpfel, Birnen, Zwetschen stehlen – –","ru":"яблука, груші, сливи красти – –","rv":"груші, сливи пощупити – –","g":{"0":"яблука","1":"груші","2":"сливи","3":"красти"}},{"de":"Das ist freilich angenehmer","ru":"це, звісно, приємніше","rv":"це, ясна річ, миліше","g":{"0":"це","1":"","2":"звісно","3":"приємніше"}},{"de":"Und dazu auch viel bequemer,","ru":"та й куди зручніше,","rv":"і куди як веселіше,","g":{"1":"до того ж","2":"і","3":"куди","4":"зручніше"}},{"de":"Als in Kirche oder Schule","ru":"ніж у церкві чи в школі","rv":"ніж у церкві та у школі","g":{"0":"ніж","3":"або","4":"у школі","1-2":"у церкві"}},{"de":"Festzusitzen auf dem Stuhle. –","ru":"сидіти сиднем на стільці. –","rv":"на лаві сидіти в неволі. –","g":{"0":"сиднем сидіти","1-3":"на стільці"}}]},{"s":[{"de":"– Aber wehe, wehe, wehe!","ru":"– Але горе, горе, горе!","rv":"– Тільки горе, горе, горе,","g":{"0":"але","1":"горе","2":"горе","3":"горе"}},{"de":"Wenn ich, auf das Ende sehe!! –","ru":"коли я дивлюся, чим усе скінчилося!! –","rv":"як дізнаєшся, що скоро! –","g":{"0":"коли","5":"дивлюся","2-4":"на кінець"}},{"de":"– Ach, das war ein schlimmes Ding,","ru":"– Ах, погано вийшла справа,","rv":"– Ах, з хлопчаками сталось","g":{"0":"ах","1":"це","2":"було","4":"погана","5":"справу"}},{"de":"Wie es Max und Moritz ging.","ru":"те, як обернулося для Макса й Моріца.","rv":"те, що зле їм відгукнулось.","g":{"0":"як","1":"","2":"Максові","4":"Морицові","5":"довелося"}},{"de":"– Drum ist hier, was sie getrieben,","ru":"– Тому тут усе, що вони накоїли,","rv":"– Тож усе, що наробили,","g":{"0":"тому","1":"","2":"тут","3":"що","5":"накоїли"}},{"de":"Abgemalt und aufgeschrieben.","ru":"намальовано й записано.","rv":"у картинках змалювали.","g":{"0":"намальовано","2":"записано"}}]}]}