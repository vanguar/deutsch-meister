{"id":"ch-03","title":"Zweiter Streich","titleRu":"Витівка друга","paragraphs":[{"s":[{"de":"Als die gute Witwe Bolte","ru":"Коли добра вдова Больте","rv":"Щойно вдова прийшла до тями,","g":{"0":"коли","2":"добра","3":"удова","4":"Больте"}},{"de":"Sich von ihrem Schmerz erholte,","ru":"оговталася від свого горя,","rv":"перестала вбиватися словами","g":{"0+4":"оговталася","1-3":"від свого болю"}},{"de":"Dachte sie so hin und her,","ru":"почала вона прикидати так і сяк,","rv":"і задумалась — так і сяк,","g":{"0":"думала","2-5":"так і сяк"}},{"de":"Dass es wohl das Beste wär’,","ru":"що найкраще, мабуть, буде","rv":"що зробити їй і як?","g":{"0":"що","2":"мабуть","4":"найкраще","5":"було б"}},{"de":"Die Verstorb’nen, die hienieden","ru":"небіжчиць, що тут, на землі,","rv":"Тих, що рано так спочили,","g":{"1":"покійних","2":"які","3":"на землі"}},{"de":"Schon so frühe abgeschieden,","ru":"відійшли так рано,","rv":"що за життя в дворі жили,","g":{"0":"вже","1":"так","2":"рано","3":"упокоїлися"}}]},{"s":[{"de":"Ganz im Stillen und in Ehren","ru":"тихо й чесно, як годиться,","rv":"тихо, чесно, в певний строк","g":{"0-2":"у цілковитій тиші","4-5":"з почестями"}},{"de":"Gut gebraten zu verzehren. –","ru":"добре засмажити й з'їсти. –","rv":"з'їсти, підсмаживши, — от і прок. –","g":{"0":"гарненько","1":"засмаживши","2-3":"з'їсти"}},{"de":"– Freilich war die Trauer groß,","ru":"– Звісно, скорбота була велика,","rv":"– Утім, горе велике:","g":{"0":"звісно","1":"була","3":"скорбота","4":"велика"}},{"de":"Als sie nun so nackt und bloß","ru":"коли вони, голі й обскубані,","rv":"їх, обскубаних, ото,","g":{"0":"коли","2":"тепер","3":"так","4":"голі","6":"нагі"}},{"de":"Abgerupft am Herde lagen,","ru":"лежали біля вогнища,","rv":"голих, біля вогнища, —","g":{"0":"обскубані","3":"лежали","1-2":"біля вогнища"}},{"de":"Sie, die einst in schönen Tagen","ru":"вони, що колись у прекрасні дні","rv":"а життя ж було в них ще:","g":{"1":"ті, що","2":"колись","3-5":"у прекрасні дні"}}]},{"s":[{"de":"Bald im Hofe, bald im Garten","ru":"то на подвір'ї, то в саду","rv":"то в дворі, то в саду","g":{"0":"то","3":"то","1-2":"у дворі","4-5":"у саду"}},{"de":"Lebensfroh im Sande scharrten. –","ru":"весело порпалися в піску. –","rv":"порпались весело в піску. –","g":{"0":"життєрадісно","3":"порпалися","1-2":"у піску"}},{"de":"Ach, Frau Bolte weint aufs neu,","ru":"Ах, пані Больте плаче знову,","rv":"Ах, удова знов у сльозах,","g":{"0":"ах","1":"фрау","2":"Больте","3":"плаче","4-5":"знову"}},{"de":"Und der Spitz steht auch dabei.","ru":"і шпіц стоїть тут-таки поруч.","rv":"шпіц при ній — і весь у снах.","g":{"2":"шпіц","3":"стоїть","4":"теж","5":"поруч"}},{"de":"Max und Moritz rochen dieses;","ru":"Макс і Моріц це занюхали;","rv":"Чують обидва шибеники:","g":{"0":"Макс","2":"Моріц","3":"зачули","4":"це"}},{"de":"»Schnell aufs Dach gekrochen!« hieß es.","ru":"«Хутко лізьмо на дах!» – вирішили вони.","rv":"«Хутко на дах, чоловіче!»","g":{"0":"швидко","3":"залізти","1-2":"на дах","4-5":"вирішено"}}]},{"s":[{"de":"Durch den Schornstein mit Vergnügen","ru":"Крізь димар вони із задоволенням","rv":"Крізь димар глядять згори:","g":{"0-2":"через димар","3-4":"із задоволенням"}},{"de":"Sehen sie die Hühner liegen,","ru":"бачать, як лежать кури,","rv":"курочки — рум'яні дари,","g":{"0":"бачать","3":"курей","4":"що лежать"}},{"de":"Die schon ohne Kopf und Gurgeln","ru":"які вже без голів і горлянок","rv":"без голів і без горлянок","g":{"0":"які","1":"вже","2":"без","3":"голови","5":"горла"}},{"de":"Lieblich in der Pfanne schmurgeln. –","ru":"премило шкварчать на сковороді. –","rv":"шкварчать солодко, як зранку. –","g":{"0":"премило","4":"шкварчать","1-3":"на сковороді"}},{"de":"Eben geht mit einem Teller","ru":"Якраз іде з тарілкою","rv":"А вдова, тарілку взявши,","g":{"0":"якраз","1":"іде","2-4":"з тарілкою"}},{"de":"Witwe Bolte in den Keller,","ru":"удова Больте до льоху,","rv":"вниз, у льох, біжить, сказавши:","g":{"0":"удова","1":"Больте","2-4":"до льоху"}}]},{"s":[{"de":"Dass sie von dem Sauerkohle","ru":"щоб кислої капусти","rv":"мені б капустки кислої","g":{"0":"щоб","2-4":"квашеної капусти"}},{"de":"Eine Portion sich hole,","ru":"взяти собі порцію,","rv":"покласти мерщій, смачної,","g":{"1":"порцію","2-3":"принести собі"}},{"de":"Wofür sie besonders schwärmt,","ru":"до якої вона особливо охоча,","rv":"до якої, гріх сказати,","g":{"0":"від якої","2":"особливо","3":"без тями"}},{"de":"Wenn er wieder aufgewärmt. –","ru":"коли та знову розігріта. –","rv":"розігрітої — благодать. –","g":{"0":"коли","2":"знову","3":"розігріта"}},{"de":"– Unterdessen auf dem Dache","ru":"– Тим часом на даху","rv":"– А на даху між тим","g":{"0":"тим часом","1-3":"на даху"}},{"de":"Ist man tätig bei der Sache.","ru":"справа йде повним ходом.","rv":"справа йде, як грім.","g":{"0":"","2-5":"працюють щосили"}},{"de":"Max hat schon mit Vorbedacht","ru":"Макс заздалегідь, із наміром,","rv":"Макс задумав усе наперед:","g":{"0":"Макс","1":"","2":"вже","3-4":"завбачливо"}},{"de":"Eine Angel mitgebracht. –","ru":"прихопив із собою вудку. –","rv":"вудку з собою бере вперед. –","g":{"1":"вудку","2":"приніс"}}]},{"s":[{"de":"Schnupdiwup! da wird nach oben","ru":"Шнупдівуп! ось уже нагору","rv":"Шнупдівуп! — пішла нагору","g":{"0":"раз — і готово","1":"ось","2":"","3-4":"нагору"}},{"de":"Schon ein Huhn heraufgehoben.","ru":"піднято першу курку.","rv":"курка під регіт у пору.","g":{"0":"вже","2":"курка","3":"піднята"}},{"de":"Schnupdiwup! jetzt Numro zwei;","ru":"Шнупдівуп! тепер номер другий;","rv":"Шнупдівуп! — за нею друга;","g":{"0":"раз — і готово","1":"тепер","2":"номер","3":"два"}},{"de":"Schnupdiwup! jetzt Numro drei;","ru":"Шнупдівуп! тепер номер третій;","rv":"Шнупдівуп! — і третя з кругу;","g":{"0":"раз — і готово","1":"тепер","2":"номер","3":"три"}},{"de":"Und jetzt kommt noch Numro vier:","ru":"а ось підходить і номер четвертий:","rv":"а четверта — сюди, гей:","g":{"1":"тепер","2":"іде","3":"ще","4":"номер","5":"чотири"}},{"de":"Schnupdiwup! dich haben wir!! –","ru":"Шнупдівуп! попалася й ти!! –","rv":"Шнупдівуп! — попалась, ей!! –","g":{"0":"раз — і готово","1-3":"попалася"}},{"de":"– Zwar der Spitz sah es genau,","ru":"– Щоправда, шпіц усе чудово бачив","rv":"– Шпіц-то бачив усе, як є,","g":{"0":"щоправда","2":"шпіц","3":"бачив","4":"це","5":"ясно"}},{"de":"Und er bellt: Rawau! Rawau!","ru":"і гавкає: Гав-гав! Гав-гав!","rv":"і загавкав: «Гав! Гав-гав!»","g":{"2":"гавкає","3":"гав-гав","4":"гав-гав"}}]},{"s":[{"de":"Aber schon sind sie ganz munter","ru":"Але вони вже преспокійно","rv":"Та хлопчаки тут як тут:","g":{"0":"але","1":"вже","2":"","4":"зовсім","5":"жваво"}},{"de":"Fort und von dem Dach herunter. –","ru":"забралися геть і геть із даху. –","rv":"з даху вниз — і втечуть. –","g":{"0":"геть","5":"униз","2-4":"з даху"}},{"de":"– Na! Das wird Spektakel geben,","ru":"– Ну! То-то буде переполох,","rv":"– Ну! Тут буде переполох,","g":{"0":"ну","1-4":"буде переполох"}},{"de":"Denn Frau Bolte kommt soeben;","ru":"адже пані Больте якраз іде;","rv":"бо вдова іде, і — ох!","g":{"0":"адже","1":"фрау","2":"Больте","3":"іде","4":"якраз"}},{"de":"Angewurzelt stand sie da,","ru":"мов укопана стала вона,","rv":"Мов укопана стоїть,","g":{"0":"як укопана","1-3":"заклякла"}},{"de":"Als sie nach der Pfanne sah.","ru":"коли зазирнула в сковороду.","rv":"лиш у сковороду глядить.","g":{"0":"коли","5":"глянула","2-4":"на сковороду"}}]},{"s":[{"de":"Alle Hühner waren fort –","ru":"Усі кури зникли –","rv":"Курей наче не було — і от:","g":{"0":"усі","1":"кури","2-3":"зникли"}},{"de":"»Spitz!!« – das war ihr erstes Wort. –","ru":"«Шпіц!!» – ось було її перше слово. –","rv":"«Шпіц!!» — і крик на весь народ. –","g":{"0":"шпіц","1":"це","2":"було","4":"перше","5":"слово"}},{"de":"»Oh, du Spitz, du Ungetüm!! –","ru":"«Ах ти, шпіце, ах ти, страховисько!! –","rv":"«Ах ти, Шпіце, розбійник злий!! –","g":{"0":"о","2":"шпіц","4":"чудовисько"}},{"de":"Aber wart! ich komme ihm!!!«","ru":"Але стривай! я до нього доберуся!!!»","rv":"Ну, стривай-но, стій-но, стій!!!»","g":{"0":"але","1":"стривай","3-4":"я тобі покажу"}},{"de":"Mit dem Löffel groß und schwer,","ru":"Ложкою, великою і важкою,","rv":"Ложка важка у руках —","g":{"3":"великий","5":"важкою","0-2":"ложкою"}},{"de":"Geht es über Spitzen her;","ru":"береться вона за Шпіца;","rv":"Шпіцові нині повний крах;","g":{"0-4":"дістається шпіцові"}},{"de":"Laut ertönt sein Wehgeschrei,","ru":"голосно лунає його виття,","rv":"голосно завив бідний пес,","g":{"0":"голосно","1":"лунає","2":"його","3":"зойк"}},{"de":"Denn er fühlt sich schuldenfrei. –","ru":"бо він же почувається невинним. –","rv":"хоч і вини не приніс. –","g":{"0":"адже","2-4":"почувається невинним"}}]},{"s":[{"de":"– Max und Moritz, im Verstecke,","ru":"– А Макс і Моріц у схованці","rv":"– Макс і Моріц під парканом","g":{"0":"Макс","2":"Моріц","3-4":"у схованці"}},{"de":"Schnarchen aber an der Hecke,","ru":"знай собі похропують біля огорожі,","rv":"сплять-хроплять, задоволені планом,","g":{"0":"хропуть","1":"ж","2-4":"біля живоплоту"}},{"de":"Und vom ganzen Hühnerschmaus","ru":"і від усього курячого бенкету","rv":"а від бенкету одного","g":{"1-3":"від усього курячого бенкету"}},{"de":"Guckt nur noch ein Bein heraus. –","ru":"стирчить назовні тільки одна ніжка. –","rv":"ніжка — більше нічого. –","g":{"4":"ніжка","0+5":"стирчить","1-2":"тільки"}},{"de":"Dieses war der zweite Streich,","ru":"Це була друга витівка,","rv":"От і друга вийшла штука,","g":{"0":"це","1":"була","3":"друга","4":"витівка"}},{"de":"Doch der dritte folgt sogleich.","ru":"а третя настане негайно.","rv":"а третя вже стука.","g":{"0":"але","2":"третя","3":"іде","4":"одразу"}}]}]}