{"id":"ch-03","title":"Zweiter Streich","titleRu":"Витівка друга","paragraphs":[{"s":[{"de":"Als die gute Witwe Bolte","ru":"Коли добра вдова Больте","rv":"Щойно вдова прийшла до тями,"},{"de":"Sich von ihrem Schmerz erholte,","ru":"оговталася від свого горя,","rv":"перестала вбиватися словами"},{"de":"Dachte sie so hin und her,","ru":"почала вона прикидати так і сяк,","rv":"і задумалась — так і сяк,"},{"de":"Dass es wohl das Beste wär’,","ru":"що найкраще, мабуть, буде","rv":"що зробити їй і як?"},{"de":"Die Verstorb’nen, die hienieden","ru":"небіжчиць, що тут, на землі,","rv":"Тих, що рано так спочили,"},{"de":"Schon so frühe abgeschieden,","ru":"відійшли так рано,","rv":"що за життя в дворі жили,"}]},{"s":[{"de":"Ganz im Stillen und in Ehren","ru":"тихо й чесно, як годиться,","rv":"тихо, чесно, в певний строк"},{"de":"Gut gebraten zu verzehren. –","ru":"добре засмажити й з'їсти. –","rv":"з'їсти, підсмаживши, — от і прок. –"},{"de":"– Freilich war die Trauer groß,","ru":"– Звісно, скорбота була велика,","rv":"– Утім, горе велике:"},{"de":"Als sie nun so nackt und bloß","ru":"коли вони, голі й обскубані,","rv":"їх, обскубаних, ото,"},{"de":"Abgerupft am Herde lagen,","ru":"лежали біля вогнища,","rv":"голих, біля вогнища, —"},{"de":"Sie, die einst in schönen Tagen","ru":"вони, що колись у прекрасні дні","rv":"а життя ж було в них ще:"}]},{"s":[{"de":"Bald im Hofe, bald im Garten","ru":"то на подвір'ї, то в саду","rv":"то в дворі, то в саду"},{"de":"Lebensfroh im Sande scharrten. –","ru":"весело порпалися в піску. –","rv":"порпались весело в піску. –"},{"de":"Ach, Frau Bolte weint aufs neu,","ru":"Ах, пані Больте плаче знову,","rv":"Ах, удова знов у сльозах,"},{"de":"Und der Spitz steht auch dabei.","ru":"і шпіц стоїть тут-таки поруч.","rv":"шпіц при ній — і весь у снах."},{"de":"Max und Moritz rochen dieses;","ru":"Макс і Моріц це занюхали;","rv":"Чують обидва шибеники:"},{"de":"»Schnell aufs Dach gekrochen!« hieß es.","ru":"«Хутко лізьмо на дах!» – вирішили вони.","rv":"«Хутко на дах, чоловіче!»"}]},{"s":[{"de":"Durch den Schornstein mit Vergnügen","ru":"Крізь димар вони із задоволенням","rv":"Крізь димар глядять згори:"},{"de":"Sehen sie die Hühner liegen,","ru":"бачать, як лежать кури,","rv":"курочки — рум'яні дари,"},{"de":"Die schon ohne Kopf und Gurgeln","ru":"які вже без голів і горлянок","rv":"без голів і без горлянок"},{"de":"Lieblich in der Pfanne schmurgeln. –","ru":"премило шкварчать на сковороді. –","rv":"шкварчать солодко, як зранку. –"},{"de":"Eben geht mit einem Teller","ru":"Якраз іде з тарілкою","rv":"А вдова, тарілку взявши,"},{"de":"Witwe Bolte in den Keller,","ru":"удова Больте до льоху,","rv":"вниз, у льох, біжить, сказавши:"}]},{"s":[{"de":"Dass sie von dem Sauerkohle","ru":"щоб кислої капусти","rv":"мені б капустки кислої"},{"de":"Eine Portion sich hole,","ru":"взяти собі порцію,","rv":"покласти мерщій, смачної,"},{"de":"Wofür sie besonders schwärmt,","ru":"до якої вона особливо охоча,","rv":"до якої, гріх сказати,"},{"de":"Wenn er wieder aufgewärmt. –","ru":"коли та знову розігріта. –","rv":"розігрітої — благодать. –"},{"de":"– Unterdessen auf dem Dache","ru":"– Тим часом на даху","rv":"– А на даху між тим"},{"de":"Ist man tätig bei der Sache.","ru":"справа йде повним ходом.","rv":"справа йде, як грім."},{"de":"Max hat schon mit Vorbedacht","ru":"Макс заздалегідь, із наміром,","rv":"Макс задумав усе наперед:"},{"de":"Eine Angel mitgebracht. –","ru":"прихопив із собою вудку. –","rv":"вудку з собою бере вперед. –"}]},{"s":[{"de":"Schnupdiwup! da wird nach oben","ru":"Шнупдівуп! ось уже нагору","rv":"Шнупдівуп! — пішла нагору"},{"de":"Schon ein Huhn heraufgehoben.","ru":"піднято першу курку.","rv":"курка під регіт у пору."},{"de":"Schnupdiwup! jetzt Numro zwei;","ru":"Шнупдівуп! тепер номер другий;","rv":"Шнупдівуп! — за нею друга;"},{"de":"Schnupdiwup! jetzt Numro drei;","ru":"Шнупдівуп! тепер номер третій;","rv":"Шнупдівуп! — і третя з кругу;"},{"de":"Und jetzt kommt noch Numro vier:","ru":"а ось підходить і номер четвертий:","rv":"а четверта — сюди, гей:"},{"de":"Schnupdiwup! dich haben wir!! –","ru":"Шнупдівуп! попалася й ти!! –","rv":"Шнупдівуп! — попалась, ей!! –"},{"de":"– Zwar der Spitz sah es genau,","ru":"– Щоправда, шпіц усе чудово бачив","rv":"– Шпіц-то бачив усе, як є,"},{"de":"Und er bellt: Rawau! Rawau!","ru":"і гавкає: Гав-гав! Гав-гав!","rv":"і загавкав: «Гав! Гав-гав!»"}]},{"s":[{"de":"Aber schon sind sie ganz munter","ru":"Але вони вже преспокійно","rv":"Та хлопчаки тут як тут:"},{"de":"Fort und von dem Dach herunter. –","ru":"забралися геть і геть із даху. –","rv":"з даху вниз — і втечуть. –"},{"de":"– Na! Das wird Spektakel geben,","ru":"– Ну! То-то буде переполох,","rv":"– Ну! Тут буде переполох,"},{"de":"Denn Frau Bolte kommt soeben;","ru":"адже пані Больте якраз іде;","rv":"бо вдова іде, і — ох!"},{"de":"Angewurzelt stand sie da,","ru":"мов укопана стала вона,","rv":"Мов укопана стоїть,"},{"de":"Als sie nach der Pfanne sah.","ru":"коли зазирнула в сковороду.","rv":"лиш у сковороду глядить."}]},{"s":[{"de":"Alle Hühner waren fort –","ru":"Усі кури зникли –","rv":"Курей наче не було — і от:"},{"de":"»Spitz!!« – das war ihr erstes Wort. –","ru":"«Шпіц!!» – ось було її перше слово. –","rv":"«Шпіц!!» — і крик на весь народ. –"},{"de":"»Oh, du Spitz, du Ungetüm!! –","ru":"«Ах ти, шпіце, ах ти, страховисько!! –","rv":"«Ах ти, Шпіце, розбійник злий!! –"},{"de":"Aber wart! ich komme ihm!!!«","ru":"Але стривай! я до нього доберуся!!!»","rv":"Ну, стривай-но, стій-но, стій!!!»"},{"de":"Mit dem Löffel groß und schwer,","ru":"Ложкою, великою і важкою,","rv":"Ложка важка у руках —"},{"de":"Geht es über Spitzen her;","ru":"береться вона за Шпіца;","rv":"Шпіцові нині повний крах;"},{"de":"Laut ertönt sein Wehgeschrei,","ru":"голосно лунає його виття,","rv":"голосно завив бідний пес,"},{"de":"Denn er fühlt sich schuldenfrei. –","ru":"бо він же почувається невинним. –","rv":"хоч і вини не приніс. –"}]},{"s":[{"de":"– Max und Moritz, im Verstecke,","ru":"– А Макс і Моріц у схованці","rv":"– Макс і Моріц під парканом"},{"de":"Schnarchen aber an der Hecke,","ru":"знай собі похропують біля огорожі,","rv":"сплять-хроплять, задоволені планом,"},{"de":"Und vom ganzen Hühnerschmaus","ru":"і від усього курячого бенкету","rv":"а від бенкету одного"},{"de":"Guckt nur noch ein Bein heraus. –","ru":"стирчить назовні тільки одна ніжка. –","rv":"ніжка — більше нічого. –"},{"de":"Dieses war der zweite Streich,","ru":"Це була друга витівка,","rv":"От і друга вийшла штука,"},{"de":"Doch der dritte folgt sogleich.","ru":"а третя настане негайно.","rv":"а третя вже стука."}]}]}