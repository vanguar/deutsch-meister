 "level": "A2–B1",
 "title": "Geschwindigkeit und Abstand",
 "titleTr": "Швидкість і дистанція",
 "intro": "Скільки можна їхати в місті, за містом і на автобані, як рахувати гальмівний шлях і дистанцію та чому у випробувальний термін перевищення коштує особливо дорого.",
 "sections": [
  {
   "title": "Обмеження швидкості",
   "lines": [
    {
     "de": "Innerorts gilt für Autos höchstens fünfzig Kilometer pro Stunde.",
     "tr": "У населеному пункті для легкових — не більше п'ятдесяти кілометрів на годину."
    },
    {
     "de": "Außerorts gilt höchstens hundert Kilometer pro Stunde.",
     "tr": "Поза населеним пунктом — не більше ста кілометрів на годину."
    },
    {
     "de": "Auf der Autobahn gibt es für Autos kein allgemeines Tempolimit.",
     "tr": "На автобані для легкових немає загального обмеження швидкості.",
     "o": {
      "es": "es>es gibt"
     },
     "sign": "z3301"
    },
    {
     "de": "Empfohlen sind aber höchstens hundertdreißig. Das ist die Richtgeschwindigkeit.",
     "tr": "Але рекомендовано не більше ста тридцяти. Це рекомендована швидкість."
    },
    {
     "de": "Ein blaues eckiges Schild mit einer Zahl ist eine Richtgeschwindigkeit: eine Empfehlung, kein Verbot.",
     "tr": "Синій прямокутний знак із числом — рекомендована швидкість: порада, а не заборона.",
     "sign": "z380"
    },
    {
     "de": "Ein Verkehrszeichen kann eine andere Höchstgeschwindigkeit vorschreiben. Dann gilt das Schild.",
     "tr": "Знак може встановити іншу максимальну швидкість. Тоді діє знак.",
     "sign": "z274"
    },
    {
     "de": "Dieses Schild hebt alle Verbote auf, zum Beispiel ein Tempolimit oder ein Überholverbot.",
     "tr": "Цей знак скасовує всі заборони, наприклад обмеження швидкості чи заборону обгону.",
     "o": {
      "auf": "auf>aufheben",
      "hebt": "hebt>aufheben"
     },
     "sign": "z282"
    }
   ]
  },
  {
   "title": "Швидкість за обставинами",
   "lines": [
    {
     "de": "Sie müssen immer innerhalb der Strecke anhalten können, die Sie überblicken.",
     "tr": "Ви завжди маєте встигнути зупинитися в межах ділянки, яку бачите."
    },
    {
     "de": "Bei Nebel mit Sicht unter fünfzig Metern dürfen Sie höchstens fünfzig fahren.",
     "tr": "У тумані за видимості менше п'ятдесяти метрів можна їхати не швидше п'ятдесяти."
    },
    {
     "de": "Bei Regen, Schnee und Glätte ist der Bremsweg viel länger.",
     "tr": "У дощ, сніг і ожеледицю гальмівний шлях набагато довший."
    }
   ]
  },
  {
   "title": "Гальмівний шлях",
   "lines": [
    {
     "de": "Reaktionsweg in Metern: Geschwindigkeit geteilt durch zehn, mal drei.",
     "tr": "Шлях реакції в метрах: швидкість поділити на десять і помножити на три.",
     "o": {
      "durch": "durch>geteilt durch",
      "geteilt": "geteilt>geteilt durch"
     }
    },
    {
     "de": "Bremsweg in Metern: Geschwindigkeit geteilt durch zehn, und das Ergebnis mal sich selbst.",
     "tr": "Гальмівний шлях у метрах: швидкість поділити на десять і результат помножити сам на себе.",
     "o": {
      "durch": "durch>geteilt durch",
      "geteilt": "geteilt>geteilt durch"
     }
    },
    {
     "de": "Der Anhalteweg ist Reaktionsweg plus Bremsweg.",
     "tr": "Зупинний шлях — це шлях реакції плюс гальмівний шлях."
    },
    {
     "de": "Bei einer Gefahrbremsung ist der Bremsweg nur halb so lang.",
     "tr": "Під час екстреного гальмування гальмівний шлях удвічі коротший."
    }
   ]
  },
  {
   "title": "Дистанція",
   "lines": [
    {
     "de": "Außerorts gilt: Abstand in Metern ist gleich halber Tacho.",
     "tr": "Поза населеним пунктом: дистанція в метрах — половина показів спідометра."
    },
    {
     "de": "Einfacher ist die Zwei-Sekunden-Regel: Zählen Sie „einundzwanzig, zweiundzwanzig“.",
     "tr": "Простіше правило двох секунд: рахуйте «двадцять один, двадцять два»."
    },
    {
     "de": "Wer den Abstand nicht einhält, riskiert Bußgeld, Punkte und Fahrverbot.",
     "tr": "Хто не тримає дистанцію, ризикує штрафом, балами й позбавленням прав."
    }
   ]
  },
  {
   "title": "Штрафи й випробувальний термін",
   "lines": [
    {
     "de": "Wer innerorts mehr als dreißig Kilometer pro Stunde schneller fährt als erlaubt, bekommt ein Fahrverbot.",
     "tr": "Хто перевищує швидкість у населеному пункті більш ніж на тридцять кілометрів на годину, тимчасово позбавляється прав."
    },
    {
     "de": "In der Probezeit ist schon eine Überschreitung ab einundzwanzig Kilometern pro Stunde ein schwerer Verstoß.",
     "tr": "У випробувальний термін уже перевищення від двадцяти одного кілометра на годину — серйозне порушення."
    },
    {
     "de": "Dann müssen Sie ein Aufbauseminar machen, und die Probezeit verlängert sich auf vier Jahre.",
     "tr": "Тоді треба пройти курс Aufbauseminar, а випробувальний термін подовжується до чотирьох років."
    },
    {
     "de": "Apps, die vor Blitzern warnen, sind beim Fahren verboten.",
     "tr": "Застосунки, що попереджають про камери контролю швидкості, за кермом заборонені."
    }
   ]
  }
 ],
