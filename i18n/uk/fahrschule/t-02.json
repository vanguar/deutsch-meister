{
 "id": "t-02",
 "kind": "theory",
 "emoji": "🚸",
 "level": "A2–B1",
 "title": "Verkehrszeichen und Ampeln",
 "titleTr": "Дорожні знаки і світлофори",
 "intro": "Які бувають знаки, що заборонено, як змінюється швидкість у населеному пункті і що означають сигнали світлофора в Німеччині — разом із червоним і жовтим та табличкою із зеленою стрілкою.",
 "sections": [
  {
   "title": "Три види знаків",
   "lines": [
    {
     "de": "Gefahrzeichen sind Dreiecke mit rotem Rand. Sie warnen vor einer Gefahr.",
     "tr": "Попереджувальні знаки — трикутники з червоною облямівкою. Вони попереджають про небезпеку.",
     "sign": "z101"
    },
    {
     "de": "Vorschriftzeichen sind meistens rund. Sie verbieten oder erlauben etwas.",
     "tr": "Знаки приписів найчастіше круглі. Вони щось забороняють або дозволяють.",
     "sign": "z267"
    },
    {
     "de": "Richtzeichen sind meistens eckig. Sie geben Hinweise, zum Beispiel zum Zebrastreifen.",
     "tr": "Інформаційні знаки найчастіше прямокутні. Вони підказують, наприклад, де пішохідний перехід.",
     "sign": "z350"
    }
   ]
  },
  {
   "title": "Заборони",
   "lines": [
    {
     "de": "In diese Straße dürfen Sie nicht hineinfahren.",
     "tr": "На цю вулицю в'їжджати не можна.",
     "sign": "z267"
    },
    {
     "de": "Hier dürfen Sie höchstens dreißig Kilometer pro Stunde fahren.",
     "tr": "Тут можна їхати не швидше тридцяти кілометрів на годину.",
     "sign": "z274"
    },
    {
     "de": "Hier dürfen Sie keine anderen Autos überholen.",
     "tr": "Тут не можна обганяти інші машини.",
     "sign": "z276"
    },
    {
     "de": "Absolutes Haltverbot: Hier dürfen Sie nicht einmal kurz halten.",
     "tr": "Зупинку заборонено повністю: тут не можна зупинитися навіть на хвилину.",
     "sign": "z283"
    },
    {
     "de": "Eingeschränktes Haltverbot: Sie dürfen höchstens drei Minuten halten oder kurz zum Ein- und Aussteigen.",
     "tr": "Стоянку заборонено: зупинитися можна не більше ніж на три хвилини або ненадовго, щоб сісти чи вийти.",
     "o": {
      "ein": "ein>einsteigen"
     },
     "sign": "z286"
    }
   ]
  },
  {
   "title": "У населеному пункті",
   "lines": [
    {
     "de": "Ab dem gelben Ortsschild gilt innerorts fünfzig Kilometer pro Stunde.",
     "tr": "Від жовтої таблички з назвою населеного пункту діє обмеження п'ятдесят кілометрів на годину.",
     "o": {
      "ab": "ab>ab"
     },
     "sign": "z310"
    },
    {
     "de": "Am Ortsende gilt außerorts höchstens hundert Kilometer pro Stunde.",
     "tr": "Після таблички кінця населеного пункту — не більше ста кілометрів на годину.",
     "sign": "z311"
    },
    {
     "de": "In einer Tempo-30-Zone gilt überall höchstens dreißig. Meistens gilt dort rechts vor links.",
     "tr": "У зоні Tempo 30 скрізь не більше тридцяти. Зазвичай там діє «правий перед лівим».",
     "sign": "z2741"
    },
    {
     "de": "Im verkehrsberuhigten Bereich fahren Sie Schrittgeschwindigkeit. Kinder dürfen überall spielen.",
     "tr": "У житловій зоні їздять зі швидкістю пішохода. Діти можуть гратися скрізь.",
     "sign": "z3251"
    },
    {
     "de": "Am Zebrastreifen haben Fußgänger Vorrang. Halten Sie an, wenn jemand über die Straße gehen will.",
     "tr": "На «зебрі» пішоходи мають перевагу. Зупиніться, якщо хтось хоче перейти дорогу.",
     "o": {
      "an": "an>anhalten",
      "halten": "halten>anhalten"
     },
     "sign": "z350"
    },
    {
     "de": "Achtung, Kinder! Fahren Sie hier besonders langsam und vorsichtig.",
     "tr": "Увага, діти! Тут їдьте особливо повільно й обережно.",
     "sign": "z136"
    }
   ]
  },
  {
   "title": "Світлофор",
   "lines": [
    {
     "de": "Rot bedeutet: Halten Sie vor der Haltlinie an.",
     "tr": "Червоний означає: зупиніться перед стоп-лінією.",
     "o": {
      "an": "an>anhalten",
      "halten": "halten>anhalten"
     }
    },
    {
     "de": "Rot und Gelb zusammen bedeutet: Gleich kommt Grün, aber Sie dürfen noch nicht fahren.",
     "tr": "Червоний і жовтий разом означають: зараз буде зелений, але їхати ще не можна."
    },
    {
     "de": "Gelb bedeutet: Halten Sie an, wenn das noch sicher möglich ist.",
     "tr": "Жовтий означає: зупиніться, якщо це ще можна зробити безпечно.",
     "o": {
      "an": "an>anhalten",
      "halten": "halten>anhalten"
     }
    },
    {
     "de": "Bei Grün dürfen Sie fahren, aber achten Sie auf Fußgänger und Radfahrer.",
     "tr": "На зелений можна їхати, але стежте за пішоходами й велосипедистами."
    },
    {
     "de": "Wer bei Rot fährt, zahlt mindestens neunzig Euro und bekommt einen Punkt in Flensburg.",
     "tr": "Хто їде на червоний, платить щонайменше дев'яносто євро й отримує штрафний бал у Фленсбурзі."
    },
    {
     "de": "Ist die Ampel ausgefallen, gelten die Verkehrszeichen.",
     "tr": "Якщо світлофор не працює, діють дорожні знаки."
    }
   ]
  },
  {
   "title": "Зелена стрілка",
   "lines": [
    {
     "de": "Der grüne Pfeil neben der Ampel ist ein Schild aus Metall, kein Licht.",
     "tr": "Зелена стрілка біля світлофора — металева табличка, а не сигнал.",
     "sign": "z720"
    },
    {
     "de": "Mit diesem Schild dürfen Sie bei Rot rechts abbiegen, aber nur nach einem vollständigen Halt.",
     "tr": "З цією табличкою на червоний можна повернути праворуч, але лише після повної зупинки."
    },
    {
     "de": "Fußgänger und Radfahrer mit Grün dürfen Sie dabei nicht behindern.",
     "tr": "Пішоходам і велосипедистам, у яких зелений, заважати при цьому не можна."
    }
   ]
  }
 ],
