{
 "id": "t-11",
 "kind": "theory",
 "emoji": "🛣️",
 "level": "B1",
 "title": "Autobahn und Kraftfahrstraße",
 "titleTr": "Автобан і дорога для автомобілів",
 "intro": "Кому можна на автобан, як в'їхати й з'їхати, що там заборонено і що робити, якщо проґавили свій з'їзд.",
 "sections": [
  {
   "title": "Кому можна на автобан",
   "lines": [
    {
     "de": "Auf der Autobahn dürfen nur Kraftfahrzeuge fahren, die schneller als 60 km/h fahren können.",
     "tr": "Автобаном можна їздити тільки транспортом, який може їхати швидше ніж 60 км/год.",
     "sign": "z3301"
    },
    {
     "de": "Fußgänger, Radfahrer und Mofas sind auf der Autobahn verboten.",
     "tr": "Пішоходам, велосипедистам і мопедам на автобані не можна."
    },
    {
     "de": "Dieses Schild zeigt eine Kraftfahrstraße. Dort gelten fast dieselben Regeln wie auf der Autobahn.",
     "tr": "Цей знак позначає дорогу для автомобілів. Там діють майже ті самі правила, що й на автобані.",
     "sign": "z3311"
    },
    {
     "de": "Hier endet die Autobahn. Danach gelten wieder die normalen Tempolimits.",
     "tr": "Тут автобан закінчується. Далі знову діють звичайні обмеження швидкості.",
     "sign": "z3302"
    }
   ]
  },
  {
   "title": "В'їзд на автобан",
   "lines": [
    {
     "de": "Auf dem Beschleunigungsstreifen beschleunigen Sie auf die Geschwindigkeit des Verkehrs.",
     "tr": "На смузі розгону розганяйтеся до швидкості потоку."
    },
    {
     "de": "Der Verkehr auf der Autobahn hat Vorfahrt.",
     "tr": "Транспорт на автобані має перевагу."
    },
    {
     "de": "Blinken Sie links und fädeln Sie in eine passende Lücke ein.",
     "tr": "Увімкніть лівий покажчик повороту й вбудуйтеся у відповідний проміжок.",
     "o": {
      "ein": "ein>einfädeln",
      "fädeln": "fädeln>einfädeln"
     }
    },
    {
     "de": "Fährt neben Ihnen ein Lkw, bremsen Sie leicht ab und fahren hinter ihm auf.",
     "tr": "Якщо поруч із вами їде вантажівка, трохи пригальмуйте й в'їжджайте за нею.",
     "o": {
      "ab": "ab>abbremsen",
      "auf": "auf>auffahren",
      "bremsen": "bremsen>abbremsen",
      "fahren": "fahren>auffahren"
     }
    }
   ]
  },
  {
   "title": "Що на автобані заборонено",
   "lines": [
    {
     "de": "Wenden und Rückwärtsfahren sind auf der Autobahn streng verboten.",
     "tr": "Розвертатися та їхати заднім ходом на автобані суворо заборонено."
    },
    {
     "de": "Haben Sie die Ausfahrt verpasst, fahren Sie bis zur nächsten Ausfahrt weiter.",
     "tr": "Якщо ви проґавили з'їзд, їдьте далі до наступного з'їзду.",
     "o": {
      "fahren": "fahren>weiterfahren",
      "weiter": "weiter>weiterfahren"
     }
    },
    {
     "de": "Halten und Parken sind verboten, auch auf dem Seitenstreifen.",
     "tr": "Зупинятися й паркуватися заборонено, зокрема на узбіччі."
    },
    {
     "de": "Nur bei einer Panne dürfen Sie auf dem Seitenstreifen halten.",
     "tr": "Тільки в разі поломки можна зупинитися на узбіччі."
    },
    {
     "de": "Dieses Schild schreibt eine Mindestgeschwindigkeit vor. Langsamer dürfen Sie hier nicht fahren.",
     "tr": "Цей знак приписує мінімальну швидкість. Повільніше тут їхати не можна.",
     "o": {
      "schreibt": "schreibt>vorschreiben",
      "vor": "vor>vorschreiben"
     },
     "sign": "z275"
    }
   ]
  },
  {
   "title": "З'їзд з автобану",
   "lines": [
    {
     "de": "Diese Baken stehen 300, 200 und 100 Meter vor der Ausfahrt.",
     "tr": "Такі покажчики стоять за 300, 200 і 100 метрів до з'їзду.",
     "sign": "z450"
    },
    {
     "de": "Wechseln Sie rechtzeitig auf den rechten Fahrstreifen und blinken Sie rechts.",
     "tr": "Заздалегідь перестройтеся в праву смугу й увімкніть правий покажчик повороту."
    },
    {
     "de": "Bremsen Sie erst auf dem Verzögerungsstreifen.",
     "tr": "Гальмуйте тільки на смузі гальмування."
    },
    {
     "de": "Dieses Schild zeigt, wo die Ausfahrt beginnt.",
     "tr": "Цей знак показує, де починається з'їзд.",
     "sign": "z333"
    },
    {
     "de": "Nach der Autobahn wirken 80 km/h oft sehr langsam. Schauen Sie auf den Tacho.",
     "tr": "Після автобану 80 км/год часто здаються дуже повільними. Дивіться на спідометр."
    }
   ]
  },
  {
   "title": "Вантажівки, затори, відпочинок",
   "lines": [
    {
     "de": "Lkw über 3,5 Tonnen dürfen auf der Autobahn höchstens 80 km/h fahren.",
     "tr": "Вантажівки, важчі за 3,5 тонни, їдуть автобаном не швидше ніж 80 км/год."
    },
    {
     "de": "Am Stauende dürfen Sie das Warnblinklicht einschalten, um den Verkehr hinter sich zu warnen.",
     "tr": "У кінці затору можна ввімкнути аварійку, щоб попередити тих, хто їде позаду."
    },
    {
     "de": "Auf langen Fahrten machen Sie Pause auf einem Rastplatz oder an einer Raststätte.",
     "tr": "У довгій поїздці відпочивайте на майданчику для відпочинку або на станції обслуговування."
    }
   ]
  }
 ],
