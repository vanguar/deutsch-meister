{
 "id": "t-09",
 "kind": "theory",
 "emoji": "🔧",
 "level": "B1",
 "title": "Technik und Fahrzeugkontrolle",
 "titleTr": "Техніка й перевірка машини",
 "intro": "Що перевірити перед поїздкою: шини, світло, масло, рідини; що обов'язково має бути в машині; що означають контрольні лампи і як часто потрібен техогляд (HU).",
 "sections": [
  {
   "title": "Шини",
   "lines": [
    {
     "de": "Das Reifenprofil muss mindestens 1,6 Millimeter tief sein.",
     "tr": "Глибина протектора має бути не менше 1,6 міліметра."
    },
    {
     "de": "Sicherer sind 3 Millimeter im Sommer und 4 Millimeter im Winter.",
     "tr": "Безпечніше 3 міліметри влітку й 4 міліметри взимку."
    },
    {
     "de": "Prüfen Sie den Reifendruck alle zwei Wochen und vor langen Fahrten.",
     "tr": "Перевіряйте тиск у шинах кожні два тижні й перед довгими поїздками."
    }
   ]
  },
  {
   "title": "Світло, масло й рідини",
   "lines": [
    {
     "de": "Vor der Fahrt kontrollieren Sie Licht, Blinker und Bremslicht.",
     "tr": "Перед поїздкою ви перевіряєте фари, поворотники й стоп-сигнали."
    },
    {
     "de": "Den Ölstand prüfen Sie mit dem Ölmessstab, bei kaltem Motor und auf ebener Straße.",
     "tr": "Рівень масла перевіряють щупом, на холодному двигуні й на рівній дорозі."
    },
    {
     "de": "Kontrollieren Sie auch Kühlwasser, Bremsflüssigkeit und Scheibenwaschwasser.",
     "tr": "Перевіряйте також охолоджувальну рідину, гальмівну рідину й воду омивача."
    },
    {
     "de": "Im Winter braucht das Scheibenwaschwasser Frostschutz.",
     "tr": "Взимку у воду омивача потрібен антифриз."
    }
   ]
  },
  {
   "title": "Контрольні лампи",
   "lines": [
    {
     "de": "Leuchtet eine rote Kontrollleuchte, halten Sie sofort an einer sicheren Stelle an.",
     "tr": "Якщо світиться червона контрольна лампа, одразу зупиніться в безпечному місці.",
     "o": {
      "an": "an>anhalten",
      "halten": "halten>anhalten"
     }
    },
    {
     "de": "Eine gelbe Kontrollleuchte bedeutet: Bald in die Werkstatt fahren.",
     "tr": "Жовта контрольна лампа означає: скоро треба до майстерні."
    },
    {
     "de": "Rot sind zum Beispiel Öldruck, Bremsanlage und Batterie.",
     "tr": "Червоні — наприклад, тиск масла, гальмо й акумулятор."
    }
   ]
  },
  {
   "title": "Обов'язково в машині",
   "lines": [
    {
     "de": "Im Auto müssen ein Warndreieck, ein Verbandkasten und eine Warnweste sein.",
     "tr": "У машині мають бути знак аварійної зупинки, аптечка і світловідбивний жилет."
    },
    {
     "de": "Die Warnweste liegt am besten griffbereit neben dem Fahrersitz.",
     "tr": "Жилет краще тримати під рукою поруч із водійським сидінням."
    },
    {
     "de": "Ladung im Auto müssen Sie sichern, damit sie beim Bremsen nicht nach vorne fliegt.",
     "tr": "Вантаж у машині треба закріпити, щоб під час гальмування він не полетів уперед."
    }
   ]
  },
  {
   "title": "Техогляд",
   "lines": [
    {
     "de": "Alle zwei Jahre muss das Auto zur Hauptuntersuchung, kurz HU.",
     "tr": "Кожні два роки машина має проходити техогляд, скорочено HU."
    },
    {
     "de": "Ein neues Auto muss erst nach drei Jahren zur HU.",
     "tr": "Нова машина вперше йде на HU лише через три роки."
    },
    {
     "de": "Die Plakette auf dem hinteren Kennzeichen zeigt, wann die nächste HU fällig ist.",
     "tr": "Наліпка на задньому номері показує, коли наступний техогляд."
    }
   ]
  }
 ],
