 "level": "B1",
 "title": "Kreisverkehr, Bahnübergang und Baustelle",
 "titleTr": "Кільце, переїзд і ремонт дороги",
 "intro": "Як в'їжджати на кільце й коли вмикати покажчик повороту, хто головний на залізничному переїзді та які лінії діють на ділянці ремонту дороги.",
 "sections": [
  {
   "title": "Круговий рух",
   "lines": [
    {
     "de": "Dieses Schild zeigt einen Kreisverkehr. Dort fahren Sie gegen den Uhrzeigersinn.",
     "tr": "Цей знак позначає круговий рух. Там їдуть проти годинникової стрілки.",
     "sign": "z215"
    },
    {
     "de": "Meistens steht davor „Vorfahrt gewähren“. Dann hat Vorfahrt, wer schon im Kreis fährt.",
     "tr": "Зазвичай перед ним стоїть «Поступіться дорогою». Тоді перевага в того, хто вже їде по колу."
    },
    {
     "de": "Beim Hineinfahren blinken Sie nicht.",
     "tr": "Під час в'їзду на кільце покажчик повороту не вмикають."
    },
    {
     "de": "Vor dem Hinausfahren blinken Sie rechts.",
     "tr": "Перед з'їздом з кільця ввімкніть правий покажчик повороту."
    },
    {
     "de": "Achten Sie an der Ausfahrt auf Fußgänger und Radfahrer.",
     "tr": "На виїзді з кільця стежте за пішоходами й велосипедистами."
    },
    {
     "de": "Im Kreisverkehr dürfen Sie nicht halten.",
     "tr": "На кільці зупинятися не можна."
    }
   ]
  },
  {
   "title": "Залізничний переїзд",
   "lines": [
    {
     "de": "Dieses Schild warnt vor einem Bahnübergang.",
     "tr": "Цей знак попереджає про залізничний переїзд.",
     "sign": "z151"
    },
    {
     "de": "Baken mit drei, zwei und einem Streifen stehen etwa 240, 160 und 80 Meter vor dem Bahnübergang.",
     "tr": "Покажчики з трьома, двома й однією смугою стоять приблизно за 240, 160 і 80 метрів до переїзду.",
     "sign": "z156"
    },
    {
     "de": "Das Andreaskreuz bedeutet: Der Zug hat immer Vorrang.",
     "tr": "Андріївський хрест означає: потяг завжди має перевагу.",
     "sign": "z201"
    },
    {
     "de": "Blinkt das rote Licht oder senken sich die Schranken, halten Sie vor dem Andreaskreuz an.",
     "tr": "Якщо блимає червоне світло або опускаються шлагбауми, зупиніться перед андріївським хрестом.",
     "o": {
      "an": "an>anhalten",
      "halten": "halten>anhalten"
     }
    },
    {
     "de": "Zwischen dem ersten Warnschild und dem Bahnübergang dürfen Sie nicht überholen.",
     "tr": "Між першим попереджувальним знаком і переїздом обганяти не можна."
    },
    {
     "de": "Bleibt Ihr Auto auf den Gleisen stehen, steigen alle sofort aus.",
     "tr": "Якщо машина заглухла на коліях, усі одразу виходять.",
     "o": {
      "aus": "aus>aussteigen",
      "bleibt": "bleibt>stehen bleiben",
      "stehen": "stehen>stehen bleiben",
      "steigen": "steigen>aussteigen"
     }
    }
   ]
  },
  {
   "title": "Ремонт дороги",
   "lines": [
    {
     "de": "Dieses Schild warnt vor einer Baustelle.",
     "tr": "Цей знак попереджає про дорожні роботи.",
     "sign": "z123"
    },
    {
     "de": "In einer Baustelle gelten die gelben Linien. Die weißen Linien gelten dann nicht.",
     "tr": "На ділянці ремонту діють жовті лінії. Білі лінії тоді не діють."
    },
    {
     "de": "Die Fahrstreifen sind dort oft schmal. Fahren Sie langsam und halten Sie Abstand.",
     "tr": "Смуги там часто вузькі. Їдьте повільно й тримайте дистанцію."
    },
    {
     "de": "An einer Engstelle bedeutet dieses Schild: Lassen Sie den Gegenverkehr zuerst durchfahren.",
     "tr": "У вузькому місці цей знак означає: спочатку пропустіть зустрічний транспорт.",
     "sign": "z208"
    }
   ]
  }
 ],
