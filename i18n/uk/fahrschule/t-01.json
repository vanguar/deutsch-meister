 "id": "t-01",
 "kind": "theory",
 "emoji": "🚦",
 "level": "A2–B1",
 "title": "Vorfahrt: Wer fährt zuerst?",
 "titleTr": "Перевага: хто їде першим?",
 "intro": "Головна тема теорії: хто проїжджає перехрестя першим. Слухайте правила, натискайте на слова й перевірте себе за знаками в кінці.",
 "sections": [
  {
   "title": "Правий перед лівим",
   "lines": [
    {
     "de": "An einer Kreuzung ohne Ampel und ohne Schilder gilt: rechts vor links.",
     "tr": "На перехресті без світлофора і без знаків діє правило: правий перед лівим."
    },
    {
     "de": "Wer von rechts kommt, darf zuerst fahren.",
     "tr": "Хто їде праворуч, той проїжджає першим."
    },
    {
     "de": "Kommt ein Fahrzeug von rechts, müssen Sie warten.",
     "tr": "Якщо праворуч їде машина, ви повинні зачекати."
    },
    {
     "de": "Dieses Schild warnt: An der nächsten Kreuzung gilt rechts vor links.",
     "tr": "Цей знак попереджає: на найближчому перехресті діє правило «правий перед лівим».",
     "sign": "z102"
    }
   ]
  },
  {
   "title": "Знаки пріоритету",
   "lines": [
    {
     "de": "Dieses Schild bedeutet: Vorfahrt gewähren. Lassen Sie die Fahrzeuge auf der anderen Straße zuerst fahren.",
     "tr": "Цей знак означає: дайте дорогу. Спочатку пропустіть машини на іншій дорозі.",
     "sign": "z205"
    },
    {
     "de": "Am Stoppschild müssen Sie immer anhalten, auch wenn die Straße frei ist.",
     "tr": "Біля знака «Стоп» треба завжди зупинятися, навіть якщо дорога вільна.",
     "sign": "z206"
    },
    {
     "de": "Dieses Schild gilt nur an der nächsten Kreuzung. Dort haben Sie Vorfahrt.",
     "tr": "Цей знак діє лише на найближчому перехресті. Там у вас перевага.",
     "sign": "z301"
    },
    {
     "de": "Auf einer Vorfahrtstraße haben Sie an allen Kreuzungen Vorfahrt.",
     "tr": "На головній дорозі у вас перевага на всіх перехрестях.",
     "sign": "z306"
    },
    {
     "de": "Hier endet die Vorfahrtstraße. Danach gilt wieder rechts vor links, wenn kein anderes Schild steht.",
     "tr": "Тут головна дорога закінчується. Далі знову діє «правий перед лівим», якщо немає іншого знака.",
     "sign": "z307"
    }
   ]
  },
  {
   "title": "Що важливіше",
   "lines": [
    {
     "de": "Die Zeichen der Polizei sind wichtiger als die Ampel.",
     "tr": "Сигнали поліції важливіші за світлофор."
    },
    {
     "de": "Die Ampel ist wichtiger als die Verkehrszeichen.",
     "tr": "Світлофор важливіший за дорожні знаки."
    },
    {
     "de": "Die Verkehrszeichen sind wichtiger als die Regel rechts vor links.",
     "tr": "Дорожні знаки важливіші за правило «правий перед лівим»."
    }
   ]
  },
  {
   "title": "Поворот ліворуч",
   "lines": [
    {
     "de": "Wer links abbiegt, muss den Gegenverkehr zuerst durchfahren lassen.",
     "tr": "Хто повертає ліворуч, має спочатку пропустити зустрічний транспорт."
    },
    {
     "de": "Blinken Sie rechtzeitig, damit die anderen wissen, wohin Sie fahren.",
     "tr": "Вмикайте поворотник заздалегідь, щоб інші знали, куди ви їдете."
    }
   ]
  }
 ],
