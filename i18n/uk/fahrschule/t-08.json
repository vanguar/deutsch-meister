 "level": "B1",
 "title": "Alkohol, Müdigkeit und Ablenkung",
 "titleTr": "Алкоголь, втома і відволікання",
 "intro": "Межі алкоголю в Німеччині (0,5 ‰ і 0,0 ‰ для новачків), канабіс і ліки, втома за кермом і телефон: що заборонено і скільки коштує.",
 "sections": [
  {
   "title": "Алкоголь: межі",
   "lines": [
    {
     "de": "Ab 0,5 Promille ist Autofahren verboten: 500 Euro Bußgeld, zwei Punkte und ein Monat Fahrverbot.",
     "tr": "Від 0,5 проміле керувати машиною заборонено: штраф 500 євро, два бали й місяць позбавлення прав."
    },
    {
     "de": "Schon ab 0,3 Promille ist es eine Straftat, wenn Sie unsicher fahren oder einen Unfall haben.",
     "tr": "Уже від 0,3 проміле це кримінальний злочин, якщо ви їдете невпевнено або потрапляєте в аварію."
    },
    {
     "de": "Ab 1,1 Promille sind Sie absolut fahruntüchtig und verlieren den Führerschein.",
     "tr": "Від 1,1 проміле ви абсолютно не здатні керувати машиною і втрачаєте права."
    },
    {
     "de": "In der Probezeit und unter 21 Jahren gilt: 0,0 Promille.",
     "tr": "У випробувальний термін і до 21 року діє 0,0 проміле."
    }
   ]
  },
  {
   "title": "Алкоголь виводиться повільно",
   "lines": [
    {
     "de": "Der Körper baut Alkohol nur langsam ab: etwa 0,1 Promille pro Stunde.",
     "tr": "Організм виводить алкоголь повільно: приблизно 0,1 проміле на годину.",
     "o": {
      "ab": "ab>abbauen",
      "baut": "baut>abbauen"
     }
    },
    {
     "de": "Kaffee oder eine kalte Dusche helfen nicht. Nur die Zeit hilft.",
     "tr": "Кава чи холодний душ не допомагають. Допомагає лише час."
    },
    {
     "de": "Auch am Morgen nach einer Party kann noch Restalkohol im Blut sein.",
     "tr": "І вранці після вечірки в крові ще може бути залишковий алкоголь."
    }
   ]
  },
  {
   "title": "Канабіс і ліки",
   "lines": [
    {
     "de": "Für Cannabis gilt ein Grenzwert von 3,5 Nanogramm THC pro Milliliter Blutserum.",
     "tr": "Для канабісу діє межа 3,5 нанограма ТГК на мілілітр сироватки крові."
    },
    {
     "de": "In der Probezeit und unter 21 Jahren ist Cannabis am Steuer ganz verboten.",
     "tr": "У випробувальний термін і до 21 року канабіс за кермом заборонено повністю."
    },
    {
     "de": "Cannabis zusammen mit Alkohol ist am Steuer streng verboten.",
     "tr": "Канабіс разом з алкоголем за кермом суворо заборонено."
    },
    {
     "de": "Manche Medikamente machen müde. Lesen Sie den Beipackzettel.",
     "tr": "Деякі ліки викликають сонливість. Читайте інструкцію до ліків."
    }
   ]
  },
  {
   "title": "Втома",
   "lines": [
    {
     "de": "Zwei Sekunden Sekundenschlaf bei 100 km/h sind über 50 Meter Blindflug.",
     "tr": "Дві секунди мікросну на швидкості 100 км/год — це понад 50 метрів «наосліп»."
    },
    {
     "de": "Machen Sie auf langen Fahrten alle zwei Stunden eine Pause.",
     "tr": "У довгих поїздках робіть перерву кожні дві години."
    },
    {
     "de": "Sind Sie müde, schlafen Sie auf einem Parkplatz 15 bis 20 Minuten.",
     "tr": "Якщо ви втомилися, поспіть на парковці 15–20 хвилин."
    },
    {
     "de": "Ein offenes Fenster oder laute Musik helfen nur kurz.",
     "tr": "Відчинене вікно чи гучна музика допомагають лише ненадовго."
    }
   ]
  },
  {
   "title": "Телефон за кермом",
   "lines": [
    {
     "de": "Beim Fahren dürfen Sie das Handy nicht in die Hand nehmen.",
     "tr": "Під час їзди брати телефон у руку не можна."
    },
    {
     "de": "Das kostet 100 Euro und einen Punkt in Flensburg.",
     "tr": "Це коштує 100 євро і один бал у Фленсбурзі."
    },
    {
     "de": "Auch an der roten Ampel mit laufendem Motor ist das Handy tabu.",
     "tr": "Навіть на червоному світлофорі з працюючим двигуном телефон під забороною."
    },
    {
     "de": "Eine Freisprecheinrichtung ist erlaubt.",
     "tr": "Гучний зв'язок (без рук) дозволено."
    }
   ]
  }
 ],
