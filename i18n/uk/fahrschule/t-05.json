{
 "id": "t-05",
 "kind": "theory",
 "emoji": "🅿️",
 "level": "A2–B1",
 "title": "Halten und Parken",
 "titleTr": "Зупинка і стоянка",
 "intro": "Чим зупинка відрізняється від стоянки, де не можна ні того, ні іншого, як користуватися диском паркування і паркувальним квитком — і що буде, якщо поставити машину неправильно.",
 "sections": [
  {
   "title": "Зупинка чи стоянка?",
   "lines": [
    {
     "de": "Wer länger als drei Minuten hält oder das Auto verlässt, parkt.",
     "tr": "Хто стоїть довше трьох хвилин або виходить з машини, той паркується."
    },
    {
     "de": "Wenn jemand nur kurz aussteigt, ist das Halten und nicht Parken.",
     "tr": "Якщо хтось лише ненадовго виходить, це зупинка, а не стоянка."
    }
   ]
  },
  {
   "title": "Де не можна зупинятися",
   "lines": [
    {
     "de": "Absolutes Haltverbot: Hier dürfen Sie gar nicht halten.",
     "tr": "Зупинку заборонено: тут не можна зупинятися взагалі.",
     "sign": "z283"
    },
    {
     "de": "Eingeschränktes Haltverbot: Sie dürfen höchstens drei Minuten halten.",
     "tr": "Стоянку заборонено: зупинитися можна не більше ніж на три хвилини.",
     "sign": "z286"
    },
    {
     "de": "Auf einem Zebrastreifen und bis 5 Meter davor dürfen Sie nicht halten.",
     "tr": "На «зебрі» і ближче ніж 5 метрів перед нею зупинятися не можна."
    },
    {
     "de": "An engen und unübersichtlichen Stellen und in scharfen Kurven ist Halten verboten.",
     "tr": "У вузьких місцях, де погано видно дорогу, і на крутих поворотах зупинятися заборонено."
    }
   ]
  },
  {
   "title": "Де не можна паркуватися",
   "lines": [
    {
     "de": "Bis 5 Meter vor und hinter Kreuzungen und Einmündungen dürfen Sie nicht parken.",
     "tr": "Ближче ніж 5 метрів до перехресть і примикань і після них паркуватися не можна."
    },
    {
     "de": "Bis 15 Meter vor und hinter einem Haltestellenschild ist Parken verboten.",
     "tr": "Ближче ніж 15 метрів до знака зупинки і після нього паркування заборонено.",
     "sign": "z224"
    },
    {
     "de": "Vor Einfahrten und vor abgesenkten Bordsteinen dürfen Sie nicht parken.",
     "tr": "Перед в'їздами і перед опущеними бордюрами паркуватися не можна."
    },
    {
     "de": "In zweiter Reihe parken ist verboten.",
     "tr": "Паркуватися в другому ряду заборонено."
    }
   ]
  },
  {
   "title": "Де і як паркуватися",
   "lines": [
    {
     "de": "Dieses Schild zeigt einen Parkplatz.",
     "tr": "Цей знак позначає місце для стоянки.",
     "sign": "z314"
    },
    {
     "de": "Parken Sie am rechten Fahrbahnrand und in Fahrtrichtung.",
     "tr": "Паркуйтеся біля правого краю проїжджої частини і за напрямком руху."
    },
    {
     "de": "Auf dem Gehweg dürfen Sie nur parken, wenn dieses Schild es erlaubt.",
     "tr": "На тротуарі можна паркуватися, лише якщо це дозволяє такий знак.",
     "sign": "z315"
    }
   ]
  },
  {
   "title": "Диск паркування і квиток",
   "lines": [
    {
     "de": "Mit der Parkscheibe stellen Sie Ihre Ankunftszeit ein.",
     "tr": "На диску паркування ви виставляєте час прибуття.",
     "o": {
      "ein": "ein>einstellen",
      "stellen": "stellen>einstellen"
     },
     "sign": "z318"
    },
    {
     "de": "Die Zeit wird auf die nächste halbe Stunde aufgerundet.",
     "tr": "Час округлюють угору до наступного півгодини."
    },
    {
     "de": "Am Parkscheinautomaten bezahlen Sie und legen den Parkschein gut sichtbar hinter die Windschutzscheibe.",
     "tr": "У паркоматі ви платите й кладете паркувальний квиток на видне місце за лобовим склом."
    },
    {
     "de": "Wer falsch parkt, zahlt ein Bußgeld oder wird abgeschleppt.",
     "tr": "Хто паркується неправильно, платить штраф, або машину забирає евакуатор."
    }
   ]
  }
 ],
