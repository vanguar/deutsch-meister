 "level": "B1",
 "title": "Unfall und Erste Hilfe",
 "titleTr": "Аварія і перша допомога",
 "intro": "Що робити після аварії: убезпечити місце, викликати допомогу за номером 112, надати першу допомогу, оформити європротокол — і як звільнити коридор для швидкої (Rettungsgasse).",
 "sections": [
  {
   "title": "Убезпечити місце аварії",
   "lines": [
    {
     "de": "Nach einem Unfall schalten Sie sofort das Warnblinklicht ein.",
     "tr": "Після аварії одразу ввімкніть аварійну сигналізацію.",
     "o": {
      "ein": "ein>einschalten",
      "schalten": "schalten>einschalten"
     }
    },
    {
     "de": "Ziehen Sie die Warnweste an, bevor Sie aussteigen.",
     "tr": "Одягніть світловідбивний жилет, перш ніж вийти з машини.",
     "o": {
      "an": "an>anziehen",
      "ziehen": "ziehen>anziehen"
     }
    },
    {
     "de": "Das Warndreieck stellen Sie innerorts etwa 50 Meter hinter die Unfallstelle.",
     "tr": "У населеному пункті знак аварійної зупинки ставлять приблизно за 50 метрів позаду місця аварії."
    },
    {
     "de": "Auf der Landstraße sind es etwa 100 Meter, auf der Autobahn 150 bis 200 Meter.",
     "tr": "На заміській дорозі — близько 100 метрів, на автобані — 150–200 метрів."
    },
    {
     "de": "Auf der Autobahn warten Sie hinter der Schutzplanke, nicht im Auto.",
     "tr": "На автобані чекайте за відбійником, а не в машині."
    }
   ]
  },
  {
   "title": "Викликати допомогу: 112",
   "lines": [
    {
     "de": "Den Notruf erreichen Sie unter 112, auch ohne Guthaben auf dem Handy.",
     "tr": "Екстрену службу можна викликати за номером 112, навіть без грошей на телефоні."
    },
    {
     "de": "Sagen Sie: Wo ist der Unfall? Was ist passiert? Wie viele Verletzte gibt es?",
     "tr": "Скажіть: де аварія? Що сталося? Скільки постраждалих?"
    },
    {
     "de": "Legen Sie nicht auf, sondern warten Sie auf Rückfragen.",
     "tr": "Не кладіть слухавку, а чекайте уточнювальних запитань.",
     "o": {
      "auf": "auf>auflegen",
      "legen": "legen>auflegen"
     }
    }
   ]
  },
  {
   "title": "Перша допомога",
   "lines": [
    {
     "de": "Erste Hilfe ist Pflicht. Wer nicht hilft, macht sich strafbar.",
     "tr": "Перша допомога обов'язкова. Хто не допомагає, вчиняє злочин."
    },
    {
     "de": "Für den Führerschein brauchen Sie einen Kurs in Erster Hilfe.",
     "tr": "Для отримання прав потрібен курс першої допомоги."
    },
    {
     "de": "Atmet ein Verletzter, aber reagiert nicht, legen Sie ihn in die stabile Seitenlage.",
     "tr": "Якщо постраждалий дихає, але не реагує, покладіть його в стабільне бокове положення."
    },
    {
     "de": "Atmet er nicht, beginnen Sie sofort mit der Herzdruckmassage.",
     "tr": "Якщо він не дихає, одразу починайте непрямий масаж серця."
    }
   ]
  },
  {
   "title": "Дрібна аварія",
   "lines": [
    {
     "de": "Bei einem kleinen Blechschaden machen Sie Fotos und fahren die Autos an den Rand.",
     "tr": "За невеликої вм'ятини зробіть фото й приберіть машини до краю дороги."
    },
    {
     "de": "Tauschen Sie Namen, Adresse, Kennzeichen und Versicherung aus.",
     "tr": "Обміняйтеся іменами, адресами, номерами машин і даними страховки.",
     "o": {
      "aus": "aus>austauschen",
      "tauschen": "tauschen>austauschen"
     }
    },
    {
     "de": "Dafür gibt es den Europäischen Unfallbericht.",
     "tr": "Для цього є європейський протокол аварії (європротокол)."
    },
    {
     "de": "Wer einfach wegfährt, begeht Unfallflucht. Das ist eine Straftat.",
     "tr": "Хто просто їде геть, утікає з місця аварії. Це кримінальний злочин."
    }
   ]
  },
  {
   "title": "Коридор для рятувальників",
   "lines": [
    {
     "de": "Stockt der Verkehr auf der Autobahn, bilden Sie sofort eine Rettungsgasse.",
     "tr": "Якщо на автобані рух зупиняється, одразу звільніть коридор для рятувальників."
    },
    {
     "de": "Wer ganz links fährt, fährt nach links. Alle anderen fahren nach rechts.",
     "tr": "Хто їде в крайньому лівому ряду, зміщується ліворуч. Усі інші — праворуч."
    },
    {
     "de": "Keine Rettungsgasse kostet mindestens 200 Euro, zwei Punkte und einen Monat Fahrverbot.",
     "tr": "Відсутність коридору коштує щонайменше 200 євро, два бали й місяць позбавлення прав."
    }
   ]
  }
 ],
