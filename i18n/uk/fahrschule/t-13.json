{
 "id": "t-13",
 "kind": "theory",
 "emoji": "🌱",
 "level": "B1",
 "title": "Umweltbewusst und sparsam fahren",
 "titleTr": "Економна й екологічна їзда",
 "intro": "Як витрачати менше пального: заздалегідь перемикатися вгору, котитися накатом, глушити мотор під час довгого очікування — і що таке екологічна зона з наліпкою.",
 "sections": [
  {
   "title": "Спокійно й економно",
   "lines": [
    {
     "de": "Wer vorausschauend fährt, bremst weniger und spart Kraftstoff.",
     "tr": "Хто їде з передбаченням, менше гальмує й заощаджує пальне."
    },
    {
     "de": "Schalten Sie früh hoch, etwa bei 2000 Umdrehungen pro Minute.",
     "tr": "Перемикайтеся вгору рано, приблизно при 2000 обертах на хвилину.",
     "o": {
      "hoch": "hoch>hochschalten",
      "schalten": "schalten>hochschalten"
     }
    },
    {
     "de": "Fahren Sie im höchsten möglichen Gang mit niedriger Drehzahl.",
     "tr": "Їдьте на найвищій можливій передачі з низькими обертами."
    },
    {
     "de": "Vor einer roten Ampel lassen Sie das Auto einfach ausrollen.",
     "tr": "Перед червоним світлофором просто дайте машині котитися накатом."
    },
    {
     "de": "Bei 130 km/h braucht ein Auto viel mehr Kraftstoff als bei 100 km/h.",
     "tr": "При 130 км/год машина витрачає набагато більше пального, ніж при 100 км/год."
    }
   ]
  },
  {
   "title": "Мотор на стоянці",
   "lines": [
    {
     "de": "Lassen Sie den Motor nicht im Stand warmlaufen. Das ist sogar verboten.",
     "tr": "Не прогрівайте мотор на місці. Це навіть заборонено."
    },
    {
     "de": "Ab etwa 20 Sekunden Wartezeit lohnt es sich, den Motor auszuschalten.",
     "tr": "Уже приблизно з 20 секунд очікування варто заглушити мотор."
    },
    {
     "de": "Zum Beispiel an einer geschlossenen Bahnschranke oder im Stau.",
     "tr": "Наприклад, біля закритого шлагбаума на переїзді або в заторі."
    },
    {
     "de": "Die Start-Stopp-Automatik macht das an der Ampel von selbst.",
     "tr": "Система старт-стоп робить це біля світлофора сама."
    }
   ]
  },
  {
   "title": "Шини, вантаж, кондиціонер",
   "lines": [
    {
     "de": "Wenig Luft in den Reifen erhöht den Verbrauch. Prüfen Sie den Reifendruck.",
     "tr": "Мало повітря в шинах — вища витрата. Перевіряйте тиск у шинах."
    },
    {
     "de": "Ein leerer Dachträger kostet viel Kraftstoff. Nehmen Sie ihn ab.",
     "tr": "Порожній багажник на даху витрачає багато пального. Зніміть його.",
     "o": {
      "ab": "ab>abnehmen",
      "nehmen": "nehmen>abnehmen"
     }
    },
    {
     "de": "Nehmen Sie kein schweres Gepäck mit, das Sie nicht brauchen.",
     "tr": "Не возіть із собою важкий багаж, який вам не потрібен.",
     "o": {
      "mit": "mit>mitnehmen",
      "nehmen": "nehmen>mitnehmen"
     }
    },
    {
     "de": "Die Klimaanlage braucht Energie. Nutzen Sie sie nur, wenn es nötig ist.",
     "tr": "Кондиціонер витрачає енергію. Вмикайте його, лише коли потрібно."
    }
   ]
  },
  {
   "title": "Екологічна зона",
   "lines": [
    {
     "de": "In eine Umweltzone dürfen Sie nur mit einer grünen Plakette fahren.",
     "tr": "В екологічну зону можна в'їжджати тільки із зеленою наліпкою.",
     "sign": "z2701"
    },
    {
     "de": "Die Plakette klebt innen an der Windschutzscheibe.",
     "tr": "Наліпка клеїться зсередини на лобове скло."
    },
    {
     "de": "Wer ohne Plakette in die Umweltzone fährt, zahlt 100 Euro.",
     "tr": "Хто в'їжджає в екологічну зону без наліпки, платить 100 євро."
    },
    {
     "de": "Hier endet die Umweltzone.",
     "tr": "Тут екологічна зона закінчується.",
     "sign": "z2702"
    }
   ]
  },
  {
   "title": "Шум",
   "lines": [
    {
     "de": "Unnötiger Lärm ist verboten, zum Beispiel lautes Türenschlagen oder Hupen ohne Grund.",
     "tr": "Непотрібний шум заборонено, наприклад гучне грюкання дверима чи сигнал без причини."
    },
    {
     "de": "Kurze Wege schaffen Sie oft auch mit dem Fahrrad.",
     "tr": "Короткі відстані часто можна подолати й велосипедом."
    }
   ]
  }
 ],
