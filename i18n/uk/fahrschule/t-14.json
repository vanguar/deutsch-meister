{
 "id": "t-14",
 "kind": "theory",
 "emoji": "🎓",
 "level": "B1",
 "title": "Die Fahrprüfung",
 "titleTr": "Іспит на права",
 "intro": "Як влаштований шлях до прав у Німеччині: обов'язкові поїздки в автошколі, теоретичний і практичний іспит, типові помилки та випробувальний термін після іспиту.",
 "sections": [
  {
   "title": "Шлях до прав",
   "lines": [
    {
     "de": "Für den Führerschein der Klasse B brauchen Sie einen Sehtest und einen Kurs in Erster Hilfe.",
     "tr": "Для прав категорії B вам потрібні перевірка зору й курс першої допомоги."
    },
    {
     "de": "Mit dem Antrag gehen Sie zur Führerscheinstelle Ihrer Stadt.",
     "tr": "Із заявою ви йдете до відділу посвідчень водія свого міста."
    },
    {
     "de": "In der Fahrschule lernen Sie die Theorie und machen Fahrstunden.",
     "tr": "В автошколі ви вчите теорію й берете уроки водіння."
    },
    {
     "de": "Pflicht sind zwölf besondere Fahrten: fünf auf der Landstraße, vier auf der Autobahn und drei bei Dunkelheit.",
     "tr": "Обов'язкові дванадцять особливих поїздок: п'ять заміською дорогою, чотири автобаном і три в темряві."
    },
    {
     "de": "Jede dieser Fahrten dauert 45 Minuten.",
     "tr": "Кожна з цих поїздок триває 45 хвилин."
    }
   ]
  },
  {
   "title": "Теоретичний іспит",
   "lines": [
    {
     "de": "Die Theorieprüfung machen Sie am Computer, zum Beispiel beim TÜV oder bei der DEKRA.",
     "tr": "Теоретичний іспит ви складаєте на комп'ютері, наприклад у TÜV або DEKRA."
    },
    {
     "de": "Sie bekommen 30 Fragen. Jede Frage hat zwei bis fünf Fehlerpunkte.",
     "tr": "Ви отримуєте 30 запитань. Кожне запитання коштує від двох до п'яти штрафних балів."
    },
    {
     "de": "Mit höchstens zehn Fehlerpunkten haben Sie bestanden.",
     "tr": "Якщо штрафних балів не більше десяти, іспит складено."
    },
    {
     "de": "Aber zwei falsche Antworten mit fünf Fehlerpunkten bedeuten: nicht bestanden.",
     "tr": "Але дві неправильні відповіді по п'ять штрафних балів означають: не складено."
    },
    {
     "de": "Nach der Theorieprüfung haben Sie zwölf Monate Zeit für die praktische Prüfung.",
     "tr": "Після теоретичного іспиту у вас є дванадцять місяців на практичний."
    }
   ]
  },
  {
   "title": "Практичний іспит",
   "lines": [
    {
     "de": "Die praktische Prüfung dauert etwa 55 Minuten.",
     "tr": "Практичний іспит триває близько 55 хвилин."
    },
    {
     "de": "Hinten sitzt der Prüfer, neben Ihnen sitzt Ihr Fahrlehrer.",
     "tr": "Позаду сидить екзаменатор, поруч із вами — ваш інструктор."
    },
    {
     "de": "Am Anfang zeigen Sie bei der Sicherheitskontrolle, wo Licht, Öl und Bremsanlage zu prüfen sind.",
     "tr": "Спочатку на перевірці безпеки ви показуєте, де перевіряють світло, оливу й гальмівну систему."
    },
    {
     "de": "Typische Aufgaben sind rückwärts Einparken, Umkehren und eine Gefahrbremsung.",
     "tr": "Типові завдання — паркування заднім ходом, розворот і екстрене гальмування."
    },
    {
     "de": "Einen Teil der Strecke fahren Sie selbstständig nach Schildern oder nach dem Navi.",
     "tr": "Частину маршруту ви їдете самостійно — за вказівниками або за навігатором."
    },
    {
     "de": "Haben Sie eine Anweisung nicht verstanden, fragen Sie einfach nach.",
     "tr": "Якщо ви не зрозуміли вказівку, просто перепитайте.",
     "o": {
      "fragen": "fragen>nachfragen",
      "nach": "nach>nachfragen"
     }
    }
   ]
  },
  {
   "title": "Типові помилки",
   "lines": [
    {
     "de": "Am Stoppschild halten Sie immer ganz an, auch wenn niemand kommt.",
     "tr": "Біля знака «Стоп» завжди зупиняйтеся повністю, навіть якщо ніхто не їде.",
     "o": {
      "an": "an>anhalten",
      "halten": "halten>anhalten"
     },
     "sign": "z206"
    },
    {
     "de": "Bei diesem Schild lassen Sie die anderen zuerst fahren.",
     "tr": "За цього знака ви спочатку пропускаєте інших.",
     "sign": "z205"
    },
    {
     "de": "Wer schneller als erlaubt fährt, fällt oft durch.",
     "tr": "Хто їде швидше, ніж дозволено, часто провалює іспит.",
     "o": {
      "durch": "durch>durchfallen",
      "fällt": "fällt>durchfallen"
     },
     "sign": "z274"
    },
    {
     "de": "Im verkehrsberuhigten Bereich fahren Sie nur Schrittgeschwindigkeit.",
     "tr": "У житловій зоні ви їдете лише зі швидкістю пішохода.",
     "sign": "z3251"
    },
    {
     "de": "Vergessen Sie den Schulterblick nicht: beim Abbiegen und beim Spurwechsel.",
     "tr": "Не забувайте дивитися через плече: під час повороту й зміни смуги."
    }
   ]
  },
  {
   "title": "Після іспиту",
   "lines": [
    {
     "de": "Nach der Prüfung bekommen Sie den Führerschein auf Probe.",
     "tr": "Після іспиту ви отримуєте права з випробувальним терміном."
    },
    {
     "de": "Die Probezeit dauert zwei Jahre.",
     "tr": "Випробувальний термін триває два роки."
    },
    {
     "de": "In der Probezeit und unter 21 Jahren gilt 0,0 Promille.",
     "tr": "Під час випробувального терміну й до 21 року діє 0,0 проміле."
    },
    {
     "de": "Nach einem schweren Verstoß dauert die Probezeit vier Jahre, und Sie müssen ein Aufbauseminar machen.",
     "tr": "Після серйозного порушення випробувальний термін триває чотири роки, і ви маєте пройти спеціальний семінар."
    },
    {
     "de": "Sind Sie durchgefallen, können Sie die Prüfung meistens nach zwei Wochen wiederholen.",
     "tr": "Якщо ви провалилися, перескласти іспит зазвичай можна через два тижні."
    }
   ]
  }
 ],
