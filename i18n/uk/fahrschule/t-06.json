{
 "id": "t-06",
 "kind": "theory",
 "emoji": "🚸",
 "level": "A2–B1",
 "title": "Fußgänger, Radfahrer und Busse",
 "titleTr": "Пішоходи, велосипедисти й автобуси",
 "intro": "Кого водій має особливо берегти: дітей і літніх людей, пішоходів на «зебрі», велосипедистів на поворотах і у Fahrradstraße, пасажирів біля автобуса на зупинці. Плюс знаки велодоріжок і тротуарів.",
 "sections": [
  {
   "title": "Пішоходи й діти",
   "lines": [
    {
     "de": "Dieses Schild warnt vor Fußgängern auf der Fahrbahn.",
     "tr": "Цей знак попереджає про пішоходів на проїжджій частині.",
     "sign": "z133"
    },
    {
     "de": "Bei Kindern, älteren und hilfsbedürftigen Menschen fahren Sie langsam und sind bremsbereit.",
     "tr": "Поруч із дітьми, літніми і безпорадними людьми ви їдете повільно й готові загальмувати.",
     "sign": "z136"
    },
    {
     "de": "Am Zebrastreifen müssen Sie Fußgängern das Überqueren ermöglichen.",
     "tr": "Біля «зебри» ви мусите дати пішоходам перейти дорогу.",
     "sign": "z350"
    },
    {
     "de": "An einem Zebrastreifen dürfen Sie nicht überholen.",
     "tr": "Біля «зебри» обганяти не можна."
    }
   ]
  },
  {
   "title": "Поворот: спершу пішоходи й велосипедисти",
   "lines": [
    {
     "de": "Beim Abbiegen haben Radfahrer, die geradeaus fahren, Vorrang.",
     "tr": "Під час повороту велосипедисти, які їдуть прямо, мають перевагу."
    },
    {
     "de": "Auf Fußgänger nehmen Sie beim Abbiegen besondere Rücksicht; wenn nötig, warten Sie.",
     "tr": "Під час повороту ви особливо уважні до пішоходів; якщо потрібно, чекаєте."
    },
    {
     "de": "Vor dem Rechtsabbiegen schauen Sie in den Spiegel und über die Schulter.",
     "tr": "Перед поворотом праворуч ви дивитеся в дзеркало і через плече."
    }
   ]
  },
  {
   "title": "Велодоріжки і тротуари",
   "lines": [
    {
     "de": "Dieses Schild zeigt einen Radweg. Radfahrer müssen ihn benutzen, Autos dürfen dort nicht fahren.",
     "tr": "Цей знак позначає велодоріжку. Велосипедисти мусять нею користуватися, автомобілям там їздити не можна.",
     "sign": "z237"
    },
    {
     "de": "Dieses Schild zeigt einen Gehweg nur für Fußgänger.",
     "tr": "Цей знак позначає доріжку тільки для пішоходів.",
     "sign": "z239"
    },
    {
     "de": "Auf diesem Weg fahren Radfahrer und gehen Fußgänger gemeinsam.",
     "tr": "Цією доріжкою велосипедисти й пішоходи рухаються разом.",
     "sign": "z240"
    },
    {
     "de": "Hier ist der Weg geteilt: links fahren Radfahrer, rechts gehen Fußgänger.",
     "tr": "Тут доріжку розділено: ліворуч їдуть велосипедисти, праворуч ідуть пішоходи.",
     "sign": "z241"
    },
    {
     "de": "Kinder bis acht Jahre fahren mit dem Fahrrad auf dem Gehweg.",
     "tr": "Діти до восьми років їздять на велосипеді тротуаром."
    },
    {
     "de": "Öffnen Sie die Autotür vorsichtig: Von hinten kann ein Radfahrer kommen.",
     "tr": "Відчиняйте двері машини обережно: ззаду може їхати велосипедист."
    }
   ]
  },
  {
   "title": "Велосипедна вулиця",
   "lines": [
    {
     "de": "Dieses Schild warnt vor Radverkehr.",
     "tr": "Цей знак попереджає про велосипедистів.",
     "sign": "z138"
    },
    {
     "de": "In einer Fahrradstraße dürfen Autos nur fahren, wenn ein Zusatzzeichen es erlaubt.",
     "tr": "У велосипедній вулиці автомобілі можуть їздити, лише якщо це дозволяє додаткова табличка.",
     "sign": "z2441"
    },
    {
     "de": "Dort gilt höchstens Tempo 30, und Radfahrer dürfen nebeneinander fahren.",
     "tr": "Там діє не більше 30 км/год, а велосипедисти можуть їхати поруч одне з одним."
    }
   ]
  },
  {
   "title": "Автобуси і шкільні автобуси",
   "lines": [
    {
     "de": "Steigen an der Haltestelle Fahrgäste aus, fahren Sie rechts nur mit Schrittgeschwindigkeit vorbei.",
     "tr": "Якщо на зупинці виходять пасажири, праворуч ви проїжджаєте повз лише зі швидкістю пішохода.",
     "o": {
      "aus": "aus>aussteigen",
      "fahren": "fahren>vorbeifahren",
      "steigen": "steigen>aussteigen",
      "vorbei": "vorbei>vorbeifahren"
     }
    },
    {
     "de": "Einen Bus mit Warnblinklicht, der sich einer Haltestelle nähert, dürfen Sie nicht überholen.",
     "tr": "Автобус з увімкненою аварійкою, який під'їжджає до зупинки, обганяти не можна."
    },
    {
     "de": "Hält ein Schulbus mit Warnblinklicht, gilt Schrittgeschwindigkeit auch für den Gegenverkehr.",
     "tr": "Якщо шкільний автобус стоїть з аварійкою, швидкість пішохода діє і для зустрічного руху."
    },
    {
     "de": "Will ein Linienbus von der Haltestelle abfahren, lassen Sie ihn fahren; wenn nötig, warten Sie.",
     "tr": "Якщо рейсовий автобус хоче від'їхати від зупинки, пропустіть його; якщо потрібно, зачекайте."
    }
   ]
  }
 ],
