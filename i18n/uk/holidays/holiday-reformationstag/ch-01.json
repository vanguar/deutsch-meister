{
  "id": "ch-01",
  "title": "Reformationstag",
  "titleRu": "День Реформації",
  "paragraphs": [
    {
      "sourceIds": [
        "sachsen"
      ],
      "s": [
        {
          "de": "Der Reformationstag ist am 31. Oktober.",
          "ru": "День Реформації припадає на 31 жовтня."
        },
        {
          "de": "In Sachsen ist er ein gesetzlicher Feiertag.",
          "ru": "У Саксонії це офіційне свято."
        }
      ]
    },
    {
      "sourceIds": [
        "wartburg"
      ],
      "s": [
        {
          "de": "Wer mehr über die Reformation erfahren möchte, kann die Wartburg in Thüringen besuchen.",
          "ru": "Щоб ближче познайомитися з Реформацією, можна відвідати замок Вартбурґ у Тюрингії."
        },
        {
          "de": "Dort übersetzte Martin Luther 1521 und 1522 das Neue Testament ins Deutsche.",
          "ru": "Там у 1521 і 1522 роках Мартін Лютер перекладав Новий Заповіт німецькою."
        }
      ]
    }
  ],
  "sourceTitle": "Джерела і перевірка фактів",
