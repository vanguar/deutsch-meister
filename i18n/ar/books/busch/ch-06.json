":"بطاقية النوم المدبّبة؛","rv":"بطاقيّةٍ مدبّبةٍ وانتعاشْ؛","g":{"3":"طاقية النوم","0-2":"بالمدبّبة"}},{"de":"Seine Augen macht er zu,","ru":"يغمض عينيه،","rv":"أغمضَ العينينِ في سلامْ،","g":{"1":"عيون","2+4":"يغمض"}},{"de":"Hüllt sich ein und schläft in Ruh.","ru":"ويلتفّ بالغطاء وينام بهدوء.","rv":"والتفَّ باللحافِ ونامْ.","g":{"4":"ينام","0-2":"يلتفّ","5-6":"بهدوء"}},{"de":"Doch die Käfer, kritze kratze!","ru":"لكنّ الخنافس — خِرْ خِرْ، خَرْ خَرْ! —","rv":"لكنَّ الخنافسَ — خِرْ، خَرْ! —","g":{"0":"لكن","2":"خنافس","3":"خِرْ","4":"خِرْ"}},{"de":"Kommen schnell aus der Matratze.","ru":"تخرج بسرعة من الفراش.","rv":"خرجتْ من الفراشِ بلا حذرْ.","g":{"0":"تخرج","1":"بسرعة","2-4":"من الفراش"}}]},{"s":[{"de":"Schon fasst einer, der voran,","ru":"وها هي واحدة في المقدّمة تمسك","rv":"وأوّلُها أجرأُ الجميعْ","g":{"0":"بالفعل / سابقًا","1+4":"يمسك","2-3":"واحدة منها"}},{"de":"Onkel Fritzens Nase an.","ru":"بأنف العمّ فريتس.","rv":"أمسكَ أنفَ العمِّ السريعْ!","g":{"2":"بالأنف","3":"","0-1":"العمّ فريتس"}},{"de":"»Bau!!« – schreit er – »Was ist das hier?!!«","ru":"«آي!!» يصيح، «ما هذا؟!!»","rv":"«آي!!» صاحَ، «ما هذا الهمّ؟!!»","g":{"0":"آي","1":"يصيح","3":"ما / أنّ","4":"","5":"هذا","6":"هنا"}},{"de":"Und erfasst das Ungetier.","ru":"ويمسك الوحش.","rv":"وأمسكَ الوحشَ في الظلامِ وضمّْ.","g":{"1":"يمسك","3":"وحش"}},{"de":"Und den Onkel, voller Grausen,","ru":"ويُرى العمّ، وهو مليء بالرعب،","rv":"وترى العمَّ في رعبٍ شديدْ","g":{"2":"عمّ","3":"مليء","4":"بالرعب"}},{"de":"Sieht man aus dem Bette sausen.","ru":"يقفز من السرير.","rv":"قفزَ من السريرِ كالطريدْ.","g":{"0":"يُرى","5":"قافزًا","2-4":"من السرير"}}]},{"s":[{"de":"»Autsch!!« – Schon wieder hat er einen","ru":"«أوتش!!» — وها هي واحدة أخرى عليه","rv":"«أوتش!!» — وها هي بلا عددْ:","g":{"0":"أوتش","1":"بالفعل / سابقًا","2":"من جديد","3":"","5":"واحدًا"}},{"de":"Im Genicke, an den Beinen;","ru":"على قفاه، وعلى ساقيه؛","rv":"على القفا وفي كلِّ الجسدْ؛","g":{"0-1":"على القفا","2-4":"على الساقين"}},{"de":"Hin und her und rund herum","ru":"ذهابًا وإيابًا وفي كل اتجاه","rv":"ذهابًا وإيابًا وفي كلِّ اتّجاهْ","g":{"0-2":"ذهابًا وإيابًا","4-5":"من كل جانب"}},{"de":"Kriecht es, fliegt es mit Gebrumm.","ru":"يزحف ويطير كل شيء بطنين.","rv":"تزحفُ وتطيرُ حولَ الجباهْ.","g":{"0":"تزحف","2":"يطير","4-5":"بطنين"}},{"de":"Onkel Fritz, in dieser Not,","ru":"والعمّ فريتس في هذه المحنة","rv":"والعمُّ فريتسُ في هذا البلاءْ","g":{"0":"عمّ / خال","1":"فريتس","2-4":"في هذه المحنة"}},{"de":"Haut und trampelt alles tot","ru":"يضرب الجميع ويدوسهم حتى الموت.","rv":"يضربُ ويدوسُ الجميعَ بلا عزاءْ.","g":{"0":"يضرب","3":"الجميع","2+4":"يدوس حتى الموت"}}]},{"s":[{"de":"Guckste wohl! Jetzt ist’s vorbei","ru":"أرأيت! الآن انتهى الأمر","rv":"أرأيتَ؟ انتهى العراكْ،","g":{"2":"الآن","0-1":"انظروا","3-4":"انتهى"}},{"de":"Mit der Käferkrabbelei!!","ru":"مع زحف الخنافس!!","rv":"لا خنافسَ بعدُ ولا اشتباكْ!!","g":{"0-2":"مع زحف الخنافس"}},{"de":"Onkel Fritz hat wieder Ruh’","ru":"والعمّ فريتس هادئ من جديد","rv":"والعمُّ عادَ إلى السكونْ","g":{"0":"عمّ / خال","1":"فريتس","2":"","3":"من جديد","4":"بهدوء"}},{"de":"Und macht seine Augen zu. –","ru":"ويغمض عينيه. –","rv":"وأغمضَ العينينِ والجفونْ. –","g":{"3":"عيون","1+4":"يغمض"}},{"de":"Dieses war der fünfte Streich,","ru":"كان هذا المقلب الخامس،","rv":"هذا خامسُ مقلبٍ حصلْ،","g":{"0":"هذا","1":"كانت","3":"الخامس","4":"مقلب"}},{"de":"Doch der sechste folgt sogleich.","ru":"والسادس يتبعه في الحال.","rv":"والسادسُ يأتي على عجلْ.","g":{"0":"لكن","2":"السادس","3":"يتبع","4":"في الحال"}}]}]}