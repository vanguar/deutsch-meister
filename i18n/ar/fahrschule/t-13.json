{
 "id": "t-13",
 "kind": "theory",
 "emoji": "🌱",
 "level": "B1",
 "title": "Umweltbewusst und sparsam fahren",
 "titleTr": "القيادة الاقتصادية والصديقة للبيئة",
 "intro": "كيف تستهلك وقودًا أقل: التبديل المبكر إلى غيار أعلى، والانسياب دون ضغط، وإطفاء المحرك عند الانتظار الطويل — وما هي المنطقة البيئية والملصق.",
 "sections": [
  {
   "title": "بهدوء وباقتصاد",
   "lines": [
    {
     "de": "Wer vorausschauend fährt, bremst weniger und spart Kraftstoff.",
     "tr": "من يقود باستباق يفرمل أقل ويوفّر الوقود."
    },
    {
     "de": "Schalten Sie früh hoch, etwa bei 2000 Umdrehungen pro Minute.",
     "tr": "بدّل إلى الغيار الأعلى مبكرًا، عند نحو 2000 دورة في الدقيقة.",
     "o": {
      "hoch": "hoch>hochschalten",
      "schalten": "schalten>hochschalten"
     }
    },
    {
     "de": "Fahren Sie im höchsten möglichen Gang mit niedriger Drehzahl.",
     "tr": "سِر بأعلى غيار ممكن وبعدد دورات منخفض."
    },
    {
     "de": "Vor einer roten Ampel lassen Sie das Auto einfach ausrollen.",
     "tr": "قبل الإشارة الحمراء دع السيارة تنساب ببساطة حتى تتوقف."
    },
    {
     "de": "Bei 130 km/h braucht ein Auto viel mehr Kraftstoff als bei 100 km/h.",
     "tr": "عند 130 كم/س تستهلك السيارة وقودًا أكثر بكثير مما تستهلكه عند 100 كم/س."
    }
   ]
  },
  {
   "title": "المحرك أثناء الوقوف",
   "lines": [
    {
     "de": "Lassen Sie den Motor nicht im Stand warmlaufen. Das ist sogar verboten.",
     "tr": "لا تترك المحرك يسخن والسيارة واقفة. هذا ممنوع أيضًا."
    },
    {
     "de": "Ab etwa 20 Sekunden Wartezeit lohnt es sich, den Motor auszuschalten.",
     "tr": "بدءًا من نحو 20 ثانية من الانتظار يستحق الأمر إطفاء المحرك."
    },
    {
     "de": "Zum Beispiel an einer geschlossenen Bahnschranke oder im Stau.",
     "tr": "مثلًا عند حاجز سكة حديدية مغلق أو في الازدحام."
    },
    {
     "de": "Die Start-Stopp-Automatik macht das an der Ampel von selbst.",
     "tr": "نظام التشغيل والإيقاف التلقائي يفعل ذلك وحده عند الإشارة."
    }
   ]
  },
  {
   "title": "الإطارات والحمولة والمكيّف",
   "lines": [
    {
     "de": "Wenig Luft in den Reifen erhöht den Verbrauch. Prüfen Sie den Reifendruck.",
     "tr": "قلة الهواء في الإطارات تزيد الاستهلاك. افحص ضغط الإطارات."
    },
    {
     "de": "Ein leerer Dachträger kostet viel Kraftstoff. Nehmen Sie ihn ab.",
     "tr": "حامل السقف الفارغ يستهلك وقودًا كثيرًا. انزعه.",
     "o": {
      "ab": "ab>abnehmen",
      "nehmen": "nehmen>abnehmen"
     }
    },
    {
     "de": "Nehmen Sie kein schweres Gepäck mit, das Sie nicht brauchen.",
     "tr": "لا تحمل معك أمتعة ثقيلة لا تحتاج إليها.",
     "o": {
      "mit": "mit>mitnehmen",
      "nehmen": "nehmen>mitnehmen"
     }
    },
    {
     "de": "Die Klimaanlage braucht Energie. Nutzen Sie sie nur, wenn es nötig ist.",
     "tr": "المكيّف يستهلك طاقة. استخدمه فقط عند الحاجة."
    }
   ]
  },
  {
   "title": "المنطقة البيئية",
   "lines": [
    {
     "de": "In eine Umweltzone dürfen Sie nur mit einer grünen Plakette fahren.",
     "tr": "لا يجوز لك دخول المنطقة البيئية إلا بملصق أخضر.",
     "sign": "z2701"
    },
    {
     "de": "Die Plakette klebt innen an der Windschutzscheibe.",
     "tr": "يُلصق الملصق من الداخل على الزجاج الأمامي."
    },
    {
     "de": "Wer ohne Plakette in die Umweltzone fährt, zahlt 100 Euro.",
     "tr": "من يدخل المنطقة البيئية دون ملصق يدفع 100 يورو."
    },
    {
     "de": "Hier endet die Umweltzone.",
     "tr": "هنا تنتهي المنطقة البيئية.",
     "sign": "z2702"
    }
   ]
  },
  {
   "title": "الضجيج",
   "lines": [
    {
     "de": "Unnötiger Lärm ist verboten, zum Beispiel lautes Türenschlagen oder Hupen ohne Grund.",
     "tr": "الضجيج غير الضروري ممنوع، مثل صفق الأبواب بقوة أو استخدام البوق بلا سبب."
    },
    {
     "de": "Kurze Wege schaffen Sie oft auch mit dem Fahrrad.",
     "tr": "المسافات القصيرة يمكنك غالبًا قطعها بالدراجة أيضًا."
    }
   ]
  }
 ],
