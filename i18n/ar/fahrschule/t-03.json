{
 "id": "t-03",
 "kind": "theory",
 "emoji": "⏱️",
 "level": "A2–B1",
 "title": "Geschwindigkeit und Abstand",
 "titleTr": "السرعة والمسافة الآمنة",
 "intro": "كم يجوز أن تقود داخل المدينة وخارجها وعلى الأوتوبان، وكيف تحسب مسافة الكبح والمسافة الآمنة، ولماذا تكون مخالفة السرعة مكلفة جدًا في فترة الاختبار.",
 "sections": [
  {
   "title": "حدود السرعة",
   "lines": [
    {
     "de": "Innerorts gilt für Autos höchstens fünfzig Kilometer pro Stunde.",
     "tr": "داخل البلدة تكون سرعة السيارات خمسين كيلومترًا في الساعة كحدّ أقصى."
    },
    {
     "de": "Außerorts gilt höchstens hundert Kilometer pro Stunde.",
     "tr": "خارج البلدات تكون السرعة مئة كيلومتر في الساعة كحدّ أقصى."
    },
    {
     "de": "Auf der Autobahn gibt es für Autos kein allgemeines Tempolimit.",
     "tr": "على الأوتوبان لا يوجد حدّ عام للسرعة للسيارات.",
     "o": {
      "es": "es>es gibt"
     },
     "sign": "z3301"
    },
    {
     "de": "Empfohlen sind aber höchstens hundertdreißig. Das ist die Richtgeschwindigkeit.",
     "tr": "لكن يُوصى بمئة وثلاثين كحدّ أقصى. هذه هي السرعة الموصى بها."
    },
    {
     "de": "Ein blaues eckiges Schild mit einer Zahl ist eine Richtgeschwindigkeit: eine Empfehlung, kein Verbot.",
     "tr": "اللافتة الزرقاء المستطيلة التي عليها رقم هي سرعة موصى بها: نصيحة لا منع.",
     "sign": "z380"
    },
    {
     "de": "Ein Verkehrszeichen kann eine andere Höchstgeschwindigkeit vorschreiben. Dann gilt das Schild.",
     "tr": "يمكن للافتة مرور أن تفرض سرعة قصوى أخرى. عندئذٍ تسري اللافتة.",
     "sign": "z274"
    },
    {
     "de": "Dieses Schild hebt alle Verbote auf, zum Beispiel ein Tempolimit oder ein Überholverbot.",
     "tr": "هذه اللافتة تلغي كل القيود، مثل حدّ السرعة أو منع التجاوز.",
     "o": {
      "auf": "auf>aufheben",
      "hebt": "hebt>aufheben"
     },
     "sign": "z282"
    }
   ]
  },
  {
   "title": "السرعة حسب الظروف",
   "lines": [
    {
     "de": "Sie müssen immer innerhalb der Strecke anhalten können, die Sie überblicken.",
     "tr": "يجب أن تتمكن دائمًا من التوقف ضمن المسافة التي تراها."
    },
    {
     "de": "Bei Nebel mit Sicht unter fünfzig Metern dürfen Sie höchstens fünfzig fahren.",
     "tr": "في الضباب حين تقل الرؤية عن خمسين مترًا يجوز لك القيادة بسرعة خمسين كحدّ أقصى."
    },
    {
     "de": "Bei Regen, Schnee und Glätte ist der Bremsweg viel länger.",
     "tr": "في المطر والثلج والجليد تكون مسافة الكبح أطول بكثير."
    }
   ]
  },
  {
   "title": "مسافة الكبح",
   "lines": [
    {
     "de": "Reaktionsweg in Metern: Geschwindigkeit geteilt durch zehn, mal drei.",
     "tr": "مسافة رد الفعل بالأمتار: السرعة مقسومة على عشرة، مضروبة في ثلاثة.",
     "o": {
      "durch": "durch>geteilt durch",
      "geteilt": "geteilt>geteilt durch"
     }
    },
    {
     "de": "Bremsweg in Metern: Geschwindigkeit geteilt durch zehn, und das Ergebnis mal sich selbst.",
     "tr": "مسافة الكبح بالأمتار: السرعة مقسومة على عشرة، ثم الناتج مضروبًا في نفسه.",
     "o": {
      "durch": "durch>geteilt durch",
      "geteilt": "geteilt>geteilt durch"
     }
    },
    {
     "de": "Der Anhalteweg ist Reaktionsweg plus Bremsweg.",
     "tr": "مسافة التوقف هي مسافة رد الفعل زائد مسافة الكبح."
    },
    {
     "de": "Bei einer Gefahrbremsung ist der Bremsweg nur halb so lang.",
     "tr": "عند الكبح الطارئ تكون مسافة الكبح نصف الطول فقط."
    }
   ]
  },
  {
   "title": "المسافة الآمنة",
   "lines": [
    {
     "de": "Außerorts gilt: Abstand in Metern ist gleich halber Tacho.",
     "tr": "خارج البلدات: المسافة بالأمتار تساوي نصف عداد السرعة."
    },
    {
     "de": "Einfacher ist die Zwei-Sekunden-Regel: Zählen Sie „einundzwanzig, zweiundzwanzig“.",
     "tr": "الأسهل قاعدة الثانيتين: عُدّ «واحد وعشرون، اثنان وعشرون»."
    },
    {
     "de": "Wer den Abstand nicht einhält, riskiert Bußgeld, Punkte und Fahrverbot.",
     "tr": "من لا يحافظ على المسافة يخاطر بغرامة ونقاط وسحب الرخصة."
    }
   ]
  },
  {
   "title": "الغرامات وفترة الاختبار",
   "lines": [
    {
     "de": "Wer innerorts mehr als dreißig Kilometer pro Stunde schneller fährt als erlaubt, bekommt ein Fahrverbot.",
     "tr": "من يتجاوز السرعة داخل البلدة بأكثر من ثلاثين كيلومترًا في الساعة يُمنع من القيادة مؤقتًا."
    },
    {
     "de": "In der Probezeit ist schon eine Überschreitung ab einundzwanzig Kilometern pro Stunde ein schwerer Verstoß.",
     "tr": "في فترة الاختبار تُعدّ الزيادة بواحد وعشرين كيلومترًا في الساعة مخالفة جسيمة."
    },
    {
     "de": "Dann müssen Sie ein Aufbauseminar machen, und die Probezeit verlängert sich auf vier Jahre.",
     "tr": "عندئذٍ يجب أن تحضر دورة Aufbauseminar، وتمتد فترة الاختبار إلى أربع سنوات."
    },
    {
     "de": "Apps, die vor Blitzern warnen, sind beim Fahren verboten.",
     "tr": "التطبيقات التي تحذّر من كاميرات السرعة ممنوعة أثناء القيادة."
    }
   ]
  }
 ],
