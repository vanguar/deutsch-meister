{
 "id": "t-09",
 "kind": "theory",
 "emoji": "🔧",
 "level": "B1",
 "title": "Technik und Fahrzeugkontrolle",
 "titleTr": "التقنية وفحص السيارة",
 "intro": "ما الذي تفحصه قبل الرحلة: الإطارات والأضواء والزيت والسوائل؛ وما الذي يجب أن يكون في السيارة؛ وماذا تعني لمبات التحذير وكم مرة يلزم الفحص الفني (HU).",
 "sections": [
  {
   "title": "الإطارات",
   "lines": [
    {
     "de": "Das Reifenprofil muss mindestens 1,6 Millimeter tief sein.",
     "tr": "يجب ألا يقل عمق نقش الإطار عن 1,6 مليمتر."
    },
    {
     "de": "Sicherer sind 3 Millimeter im Sommer und 4 Millimeter im Winter.",
     "tr": "الأكثر أمانًا 3 مليمترات في الصيف و4 مليمترات في الشتاء."
    },
    {
     "de": "Prüfen Sie den Reifendruck alle zwei Wochen und vor langen Fahrten.",
     "tr": "افحص ضغط الإطارات كل أسبوعين وقبل الرحلات الطويلة."
    }
   ]
  },
  {
   "title": "الأضواء والزيت والسوائل",
   "lines": [
    {
     "de": "Vor der Fahrt kontrollieren Sie Licht, Blinker und Bremslicht.",
     "tr": "قبل الرحلة تفحص الأضواء والإشارات الجانبية وأضواء الفرامل."
    },
    {
     "de": "Den Ölstand prüfen Sie mit dem Ölmessstab, bei kaltem Motor und auf ebener Straße.",
     "tr": "تفحص مستوى الزيت بعصا القياس والمحرك بارد والسيارة على طريق مستوٍ."
    },
    {
     "de": "Kontrollieren Sie auch Kühlwasser, Bremsflüssigkeit und Scheibenwaschwasser.",
     "tr": "افحص أيضًا ماء التبريد وسائل الفرامل وماء غسل الزجاج."
    },
    {
     "de": "Im Winter braucht das Scheibenwaschwasser Frostschutz.",
     "tr": "في الشتاء يحتاج ماء غسل الزجاج إلى مانع تجمد."
    }
   ]
  },
  {
   "title": "لمبات التحذير",
   "lines": [
    {
     "de": "Leuchtet eine rote Kontrollleuchte, halten Sie sofort an einer sicheren Stelle an.",
     "tr": "إذا أضاءت لمبة تحذير حمراء فتوقف فورًا في مكان آمن.",
     "o": {
      "an": "an>anhalten",
      "halten": "halten>anhalten"
     }
    },
    {
     "de": "Eine gelbe Kontrollleuchte bedeutet: Bald in die Werkstatt fahren.",
     "tr": "لمبة التحذير الصفراء تعني: اذهب قريبًا إلى الورشة."
    },
    {
     "de": "Rot sind zum Beispiel Öldruck, Bremsanlage und Batterie.",
     "tr": "من اللمبات الحمراء مثلًا: ضغط الزيت والفرامل والبطارية."
    }
   ]
  },
  {
   "title": "إلزامي في السيارة",
   "lines": [
    {
     "de": "Im Auto müssen ein Warndreieck, ein Verbandkasten und eine Warnweste sein.",
     "tr": "يجب أن يكون في السيارة مثلث تحذير وحقيبة إسعافات أولية وسترة عاكسة."
    },
    {
     "de": "Die Warnweste liegt am besten griffbereit neben dem Fahrersitz.",
     "tr": "من الأفضل أن تكون السترة العاكسة في متناول اليد بجانب مقعد السائق."
    },
    {
     "de": "Ladung im Auto müssen Sie sichern, damit sie beim Bremsen nicht nach vorne fliegt.",
     "tr": "يجب أن تثبّت الحمولة في السيارة كي لا تطير إلى الأمام عند الفرملة."
    }
   ]
  },
  {
   "title": "الفحص الفني",
   "lines": [
    {
     "de": "Alle zwei Jahre muss das Auto zur Hauptuntersuchung, kurz HU.",
     "tr": "كل سنتين يجب أن تخضع السيارة للفحص الفني الرئيسي، واختصاره HU."
    },
    {
     "de": "Ein neues Auto muss erst nach drei Jahren zur HU.",
     "tr": "السيارة الجديدة تخضع للفحص لأول مرة بعد ثلاث سنوات فقط."
    },
    {
     "de": "Die Plakette auf dem hinteren Kennzeichen zeigt, wann die nächste HU fällig ist.",
     "tr": "الملصق على اللوحة الخلفية يبيّن موعد الفحص التالي."
    }
   ]
  }
 ],
