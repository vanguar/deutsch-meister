 "level": "A2–B1",
 "title": "Licht, Nacht und Wetter",
 "titleTr": "الأضواء والليل والطقس",
 "intro": "متى تشغّل الأضواء القصيرة والطويلة، وماذا تفعل في الضباب والمطر والجليد، ومتى تكون إطارات الشتاء إلزامية، وكيف تتصرف إذا ظهر غزال على الطريق.",
 "sections": [
  {
   "title": "الأضواء القصيرة والطويلة",
   "lines": [
    {
     "de": "Bei Dämmerung, Dunkelheit und schlechter Sicht fahren Sie mit Abblendlicht.",
     "tr": "عند الغسق وفي الظلام وعند ضعف الرؤية تقود بالأضواء القصيرة."
    },
    {
     "de": "Tagfahrlicht reicht bei Dunkelheit nicht: Hinten bleibt das Auto oft dunkel.",
     "tr": "أضواء النهار لا تكفي في الظلام: فالسيارة غالبًا تبقى مظلمة من الخلف."
    },
    {
     "de": "Fernlicht dürfen Sie nur benutzen, wenn Sie niemanden blenden.",
     "tr": "لا يجوز لك استخدام الأضواء الطويلة إلا إذا لم تُبهر أحدًا."
    },
    {
     "de": "Sie müssen abblenden, wenn ein Auto entgegenkommt oder wenn Sie dicht hinter einem anderen Auto fahren.",
     "tr": "يجب أن تخفض الأضواء إذا جاءت سيارة من الاتجاه المقابل أو إذا كنت تسير قريبًا خلف سيارة أخرى."
    },
    {
     "de": "Auf Straßen mit durchgehend guter Beleuchtung ist Fernlicht verboten.",
     "tr": "على الشوارع المضاءة جيدًا على طولها تُمنع الأضواء الطويلة."
    },
    {
     "de": "Werden Sie geblendet, schauen Sie auf den rechten Fahrbahnrand.",
     "tr": "إذا انبهرت، فانظر إلى الحافة اليمنى للطريق."
    }
   ]
  },
  {
   "title": "الضباب والمطر والثلج",
   "lines": [
    {
     "de": "Leitpfosten stehen alle 50 Meter. So schätzen Sie die Sichtweite.",
     "tr": "أعمدة الإرشاد على جانب الطريق موضوعة كل 50 مترًا. بها تقدّر مدى الرؤية."
    },
    {
     "de": "Ist die Sichtweite durch Nebel, Schneefall oder Regen unter 50 Metern, fahren Sie höchstens 50 km/h.",
     "tr": "إذا كان مدى الرؤية بسبب الضباب أو الثلج أو المطر أقل من 50 مترًا، فلا تتجاوز 50 كم/س."
    },
    {
     "de": "Die Nebelschlussleuchte dürfen Sie nur bei Nebel und einer Sichtweite unter 50 Metern benutzen.",
     "tr": "لا يجوز لك استخدام ضوء الضباب الخلفي إلا في الضباب ومع مدى رؤية أقل من 50 مترًا."
    },
    {
     "de": "Fahren Sie auf Sicht: Sie müssen auf der Strecke halten können, die Sie überblicken.",
     "tr": "قُد حسب مدى الرؤية: يجب أن تستطيع التوقف ضمن المسافة التي تراها."
    }
   ]
  },
  {
   "title": "الطريق المبتل والزلق",
   "lines": [
    {
     "de": "Dieses Schild warnt: Die Fahrbahn kann nass oder schmutzig und rutschig sein.",
     "tr": "هذه اللافتة تحذّر: قد يكون الطريق مبتلًا أو متسخًا وزلقًا.",
     "sign": "z114"
    },
    {
     "de": "Bei Nässe wird der Bremsweg länger. Halten Sie mehr Abstand.",
     "tr": "على الطريق المبتل تطول مسافة الكبح. حافظ على مسافة أكبر."
    },
    {
     "de": "Bei Aquaplaning treten Sie die Kupplung und halten das Lenkrad gerade. Bremsen Sie nicht.",
     "tr": "عند الانزلاق المائي اضغط على القابض وأمسك المقود مستقيمًا. لا تفرمل."
    },
    {
     "de": "Dieses Schild warnt vor Schnee und Glatteis.",
     "tr": "هذه اللافتة تحذّر من الثلج والجليد.",
     "sign": "z10151"
    },
    {
     "de": "Bei Glatteis, Schnee und Schneematsch sind Winterreifen Pflicht.",
     "tr": "عند الجليد والثلج والثلج الذائب تكون إطارات الشتاء إلزامية."
    },
    {
     "de": "Auf Glätte bremsen, lenken und beschleunigen Sie ganz sanft.",
     "tr": "على الطريق الزلق فرمل ووجّه المقود وتسارع بلطف شديد."
    }
   ]
  },
  {
   "title": "الحيوانات البرية",
   "lines": [
    {
     "de": "Dieses Schild warnt vor Wildwechsel, besonders in der Dämmerung.",
     "tr": "هذه اللافتة تحذّر من عبور الحيوانات البرية، خاصة عند الغسق.",
     "sign": "z142"
    },
    {
     "de": "Steht ein Tier auf der Straße: abblenden, hupen, bremsen.",
     "tr": "إذا وقف حيوان على الطريق: خفّض الأضواء، استخدم البوق، فرمل."
    },
    {
     "de": "Weichen Sie nicht aus: Ein Unfall mit einem Baum ist oft schlimmer.",
     "tr": "لا تنحرف جانبًا: فالاصطدام بشجرة غالبًا أسوأ.",
     "o": {
      "aus": "aus>ausweichen",
      "weichen": "weichen>ausweichen"
     }
    },
    {
     "de": "Nach einem Wildunfall sichern Sie die Unfallstelle und rufen die Polizei.",
     "tr": "بعد الاصطدام بحيوان بري تؤمّن مكان الحادث وتتصل بالشرطة."
    }
   ]
  }
 ],
