{
 "id": "t-05",
 "kind": "theory",
 "emoji": "🅿️",
 "level": "A2–B1",
 "title": "Halten und Parken",
 "titleTr": "التوقف والركن",
 "intro": "ما الفرق بين التوقف والركن، وأين يُمنع كلاهما، وكيف تستخدم قرص الركن وتذكرة الموقف — وماذا يحدث إن ركنت السيارة بشكل خاطئ.",
 "sections": [
  {
   "title": "توقف أم ركن؟",
   "lines": [
    {
     "de": "Wer länger als drei Minuten hält oder das Auto verlässt, parkt.",
     "tr": "من يتوقف أكثر من ثلاث دقائق أو يترك السيارة يُعدّ راكنًا."
    },
    {
     "de": "Wenn jemand nur kurz aussteigt, ist das Halten und nicht Parken.",
     "tr": "إذا نزل أحد لوقت قصير فقط، فهذا توقف وليس ركنًا."
    }
   ]
  },
  {
   "title": "أين يُمنع التوقف",
   "lines": [
    {
     "de": "Absolutes Haltverbot: Hier dürfen Sie gar nicht halten.",
     "tr": "ممنوع التوقف: لا يجوز لك التوقف هنا إطلاقًا.",
     "sign": "z283"
    },
    {
     "de": "Eingeschränktes Haltverbot: Sie dürfen höchstens drei Minuten halten.",
     "tr": "التوقف مقيّد: يجوز لك التوقف ثلاث دقائق كحدّ أقصى.",
     "sign": "z286"
    },
    {
     "de": "Auf einem Zebrastreifen und bis 5 Meter davor dürfen Sie nicht halten.",
     "tr": "لا يجوز لك التوقف على ممر المشاة ولا على بعد 5 أمتار قبله."
    },
    {
     "de": "An engen und unübersichtlichen Stellen und in scharfen Kurven ist Halten verboten.",
     "tr": "يُمنع التوقف في الأماكن الضيقة والتي لا تُرى جيدًا وفي المنعطفات الحادة."
    }
   ]
  },
  {
   "title": "أين يُمنع الركن",
   "lines": [
    {
     "de": "Bis 5 Meter vor und hinter Kreuzungen und Einmündungen dürfen Sie nicht parken.",
     "tr": "لا يجوز لك الركن على بعد 5 أمتار قبل التقاطعات والتفرعات وبعدها."
    },
    {
     "de": "Bis 15 Meter vor und hinter einem Haltestellenschild ist Parken verboten.",
     "tr": "الركن ممنوع على بعد 15 مترًا قبل لافتة الموقف وبعدها.",
     "sign": "z224"
    },
    {
     "de": "Vor Einfahrten und vor abgesenkten Bordsteinen dürfen Sie nicht parken.",
     "tr": "لا يجوز لك الركن أمام المداخل وأمام الأرصفة المنخفضة."
    },
    {
     "de": "In zweiter Reihe parken ist verboten.",
     "tr": "الركن في الصف الثاني ممنوع."
    }
   ]
  },
  {
   "title": "أين وكيف تركن",
   "lines": [
    {
     "de": "Dieses Schild zeigt einen Parkplatz.",
     "tr": "هذه اللافتة تدل على موقف للسيارات.",
     "sign": "z314"
    },
    {
     "de": "Parken Sie am rechten Fahrbahnrand und in Fahrtrichtung.",
     "tr": "اركن على الحافة اليمنى للطريق وفي اتجاه السير."
    },
    {
     "de": "Auf dem Gehweg dürfen Sie nur parken, wenn dieses Schild es erlaubt.",
     "tr": "لا يجوز لك الركن على الرصيف إلا إذا سمحت بذلك هذه اللافتة.",
     "sign": "z315"
    }
   ]
  },
  {
   "title": "قرص الركن والتذكرة",
   "lines": [
    {
     "de": "Mit der Parkscheibe stellen Sie Ihre Ankunftszeit ein.",
     "tr": "على قرص الركن تضبط وقت وصولك.",
     "o": {
      "ein": "ein>einstellen",
      "stellen": "stellen>einstellen"
     },
     "sign": "z318"
    },
    {
     "de": "Die Zeit wird auf die nächste halbe Stunde aufgerundet.",
     "tr": "يُقرَّب الوقت إلى نصف الساعة التالي."
    },
    {
     "de": "Am Parkscheinautomaten bezahlen Sie und legen den Parkschein gut sichtbar hinter die Windschutzscheibe.",
     "tr": "في جهاز تذاكر الموقف تدفع ثم تضع التذكرة في مكان ظاهر خلف الزجاج الأمامي."
    },
    {
     "de": "Wer falsch parkt, zahlt ein Bußgeld oder wird abgeschleppt.",
     "tr": "من يركن بشكل خاطئ يدفع غرامة أو تُسحب سيارته."
    }
   ]
  }
 ],
