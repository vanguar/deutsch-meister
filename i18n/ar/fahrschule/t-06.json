{
 "id": "t-06",
 "kind": "theory",
 "emoji": "🚸",
 "level": "A2–B1",
 "title": "Fußgänger, Radfahrer und Busse",
 "titleTr": "المشاة وراكبو الدراجات والحافلات",
 "intro": "من يجب على السائق أن يحميه بشكل خاص: الأطفال وكبار السن، والمشاة على ممر المشاة، وراكبو الدراجات عند الانعطاف وفي شارع الدراجات، والركاب عند الحافلة في الموقف. بالإضافة إلى لافتات مسارات الدراجات والأرصفة.",
 "sections": [
  {
   "title": "المشاة والأطفال",
   "lines": [
    {
     "de": "Dieses Schild warnt vor Fußgängern auf der Fahrbahn.",
     "tr": "هذه اللافتة تحذّر من وجود مشاة على الطريق.",
     "sign": "z133"
    },
    {
     "de": "Bei Kindern, älteren und hilfsbedürftigen Menschen fahren Sie langsam und sind bremsbereit.",
     "tr": "قرب الأطفال وكبار السن والأشخاص المحتاجين إلى المساعدة تسير ببطء وتكون مستعدًا للفرملة.",
     "sign": "z136"
    },
    {
     "de": "Am Zebrastreifen müssen Sie Fußgängern das Überqueren ermöglichen.",
     "tr": "عند ممر المشاة يجب أن تتيح للمشاة عبور الطريق.",
     "sign": "z350"
    },
    {
     "de": "An einem Zebrastreifen dürfen Sie nicht überholen.",
     "tr": "لا يجوز لك التجاوز عند ممر المشاة."
    }
   ]
  },
  {
   "title": "الانعطاف: المشاة وراكبو الدراجات أولًا",
   "lines": [
    {
     "de": "Beim Abbiegen haben Radfahrer, die geradeaus fahren, Vorrang.",
     "tr": "عند الانعطاف تكون الأولوية لراكبي الدراجات الذين يسيرون مباشرة."
    },
    {
     "de": "Auf Fußgänger nehmen Sie beim Abbiegen besondere Rücksicht; wenn nötig, warten Sie.",
     "tr": "عند الانعطاف تراعي المشاة بشكل خاص؛ وإذا لزم الأمر تنتظر."
    },
    {
     "de": "Vor dem Rechtsabbiegen schauen Sie in den Spiegel und über die Schulter.",
     "tr": "قبل الانعطاف يمينًا تنظر في المرآة وفوق كتفك."
    }
   ]
  },
  {
   "title": "مسارات الدراجات والأرصفة",
   "lines": [
    {
     "de": "Dieses Schild zeigt einen Radweg. Radfahrer müssen ihn benutzen, Autos dürfen dort nicht fahren.",
     "tr": "هذه اللافتة تدل على مسار للدراجات. يجب على راكبي الدراجات استخدامه، ولا يجوز للسيارات السير فيه.",
     "sign": "z237"
    },
    {
     "de": "Dieses Schild zeigt einen Gehweg nur für Fußgänger.",
     "tr": "هذه اللافتة تدل على ممر للمشاة فقط.",
     "sign": "z239"
    },
    {
     "de": "Auf diesem Weg fahren Radfahrer und gehen Fußgänger gemeinsam.",
     "tr": "على هذا الممر يسير راكبو الدراجات والمشاة معًا.",
     "sign": "z240"
    },
    {
     "de": "Hier ist der Weg geteilt: links fahren Radfahrer, rechts gehen Fußgänger.",
     "tr": "هنا الممر مقسوم: على اليسار يسير راكبو الدراجات، وعلى اليمين يمشي المشاة.",
     "sign": "z241"
    },
    {
     "de": "Kinder bis acht Jahre fahren mit dem Fahrrad auf dem Gehweg.",
     "tr": "الأطفال حتى سن الثامنة يركبون الدراجة على الرصيف."
    },
    {
     "de": "Öffnen Sie die Autotür vorsichtig: Von hinten kann ein Radfahrer kommen.",
     "tr": "افتح باب السيارة بحذر: قد يأتي راكب دراجة من الخلف."
    }
   ]
  },
  {
   "title": "شارع الدراجات",
   "lines": [
    {
     "de": "Dieses Schild warnt vor Radverkehr.",
     "tr": "هذه اللافتة تحذّر من حركة الدراجات.",
     "sign": "z138"
    },
    {
     "de": "In einer Fahrradstraße dürfen Autos nur fahren, wenn ein Zusatzzeichen es erlaubt.",
     "tr": "في شارع الدراجات لا يجوز للسيارات السير إلا إذا سمحت بذلك لافتة إضافية.",
     "sign": "z2441"
    },
    {
     "de": "Dort gilt höchstens Tempo 30, und Radfahrer dürfen nebeneinander fahren.",
     "tr": "هناك السرعة 30 كم/س كحدّ أقصى، ويجوز لراكبي الدراجات السير جنبًا إلى جنب."
    }
   ]
  },
  {
   "title": "الحافلات والحافلات المدرسية",
   "lines": [
    {
     "de": "Steigen an der Haltestelle Fahrgäste aus, fahren Sie rechts nur mit Schrittgeschwindigkeit vorbei.",
     "tr": "إذا نزل ركاب في الموقف، فلا تمرّ بجانب الحافلة من اليمين إلا بسرعة المشي.",
     "o": {
      "aus": "aus>aussteigen",
      "fahren": "fahren>vorbeifahren",
      "steigen": "steigen>aussteigen",
      "vorbei": "vorbei>vorbeifahren"
     }
    },
    {
     "de": "Einen Bus mit Warnblinklicht, der sich einer Haltestelle nähert, dürfen Sie nicht überholen.",
     "tr": "لا يجوز لك تجاوز حافلة تقترب من الموقف وأضواء التحذير فيها مضاءة."
    },
    {
     "de": "Hält ein Schulbus mit Warnblinklicht, gilt Schrittgeschwindigkeit auch für den Gegenverkehr.",
     "tr": "إذا توقفت حافلة مدرسية وأضواء التحذير فيها مضاءة، فسرعة المشي تسري على الاتجاه المعاكس أيضًا."
    },
    {
     "de": "Will ein Linienbus von der Haltestelle abfahren, lassen Sie ihn fahren; wenn nötig, warten Sie.",
     "tr": "إذا أرادت حافلة نقل عام الانطلاق من الموقف، فدعها تنطلق؛ وإذا لزم الأمر انتظر."
    }
   ]
  }
 ],
