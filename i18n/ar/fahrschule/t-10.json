{
 "id": "t-10",
 "kind": "theory",
 "emoji": "🚑",
 "level": "B1",
 "title": "Unfall und Erste Hilfe",
 "titleTr": "الحادث والإسعافات الأولية",
 "intro": "ماذا تفعل بعد حادث: تأمين المكان، والاتصال بالرقم 112، وتقديم الإسعافات الأولية، وملء تقرير الحادث الأوروبي — وكيف تفتح ممرًّا لسيارة الإسعاف (Rettungsgasse).",
 "sections": [
  {
   "title": "تأمين مكان الحادث",
   "lines": [
    {
     "de": "Nach einem Unfall schalten Sie sofort das Warnblinklicht ein.",
     "tr": "بعد الحادث شغّل فورًا أضواء التحذير.",
     "o": {
      "ein": "ein>einschalten",
      "schalten": "schalten>einschalten"
     }
    },
    {
     "de": "Ziehen Sie die Warnweste an, bevor Sie aussteigen.",
     "tr": "البس السترة العاكسة قبل أن تنزل من السيارة.",
     "o": {
      "an": "an>anziehen",
      "ziehen": "ziehen>anziehen"
     }
    },
    {
     "de": "Das Warndreieck stellen Sie innerorts etwa 50 Meter hinter die Unfallstelle.",
     "tr": "داخل البلدة تضع مثلث التحذير على بعد نحو 50 مترًا خلف مكان الحادث."
    },
    {
     "de": "Auf der Landstraße sind es etwa 100 Meter, auf der Autobahn 150 bis 200 Meter.",
     "tr": "على الطريق الريفي نحو 100 متر، وعلى الطريق السريع من 150 إلى 200 متر."
    },
    {
     "de": "Auf der Autobahn warten Sie hinter der Schutzplanke, nicht im Auto.",
     "tr": "على الطريق السريع انتظر خلف الحاجز الواقي، لا داخل السيارة."
    }
   ]
  },
  {
   "title": "طلب المساعدة: 112",
   "lines": [
    {
     "de": "Den Notruf erreichen Sie unter 112, auch ohne Guthaben auf dem Handy.",
     "tr": "تصل إلى خدمة الطوارئ عبر الرقم 112، حتى من دون رصيد في الهاتف."
    },
    {
     "de": "Sagen Sie: Wo ist der Unfall? Was ist passiert? Wie viele Verletzte gibt es?",
     "tr": "قل: أين الحادث؟ ماذا حدث؟ كم عدد المصابين؟"
    },
    {
     "de": "Legen Sie nicht auf, sondern warten Sie auf Rückfragen.",
     "tr": "لا تُنهِ المكالمة، بل انتظر أسئلة الاستفسار.",
     "o": {
      "auf": "auf>auflegen",
      "legen": "legen>auflegen"
     }
    }
   ]
  },
  {
   "title": "الإسعافات الأولية",
   "lines": [
    {
     "de": "Erste Hilfe ist Pflicht. Wer nicht hilft, macht sich strafbar.",
     "tr": "الإسعافات الأولية واجب. ومن لا يساعد يرتكب جريمة."
    },
    {
     "de": "Für den Führerschein brauchen Sie einen Kurs in Erster Hilfe.",
     "tr": "للحصول على رخصة القيادة تحتاج إلى دورة في الإسعافات الأولية."
    },
    {
     "de": "Atmet ein Verletzter, aber reagiert nicht, legen Sie ihn in die stabile Seitenlage.",
     "tr": "إذا كان المصاب يتنفس لكنه لا يستجيب، فضعه في وضعية الإفاقة الجانبية."
    },
    {
     "de": "Atmet er nicht, beginnen Sie sofort mit der Herzdruckmassage.",
     "tr": "إذا لم يتنفس فابدأ فورًا بتدليك القلب."
    }
   ]
  },
  {
   "title": "حادث بسيط",
   "lines": [
    {
     "de": "Bei einem kleinen Blechschaden machen Sie Fotos und fahren die Autos an den Rand.",
     "tr": "في حادث بسيط بأضرار في الهيكل التقط صورًا وانقل السيارتين إلى حافة الطريق."
    },
    {
     "de": "Tauschen Sie Namen, Adresse, Kennzeichen und Versicherung aus.",
     "tr": "تبادلوا الأسماء والعناوين وأرقام اللوحات وبيانات التأمين.",
     "o": {
      "aus": "aus>austauschen",
      "tauschen": "tauschen>austauschen"
     }
    },
    {
     "de": "Dafür gibt es den Europäischen Unfallbericht.",
     "tr": "لهذا يوجد تقرير الحادث الأوروبي."
    },
    {
     "de": "Wer einfach wegfährt, begeht Unfallflucht. Das ist eine Straftat.",
     "tr": "من يغادر ببساطة يرتكب جريمة الفرار من مكان الحادث."
    }
   ]
  },
  {
   "title": "ممر الإنقاذ",
   "lines": [
    {
     "de": "Stockt der Verkehr auf der Autobahn, bilden Sie sofort eine Rettungsgasse.",
     "tr": "إذا تباطأت حركة السير على الطريق السريع فافتح فورًا ممر الإنقاذ."
    },
    {
     "de": "Wer ganz links fährt, fährt nach links. Alle anderen fahren nach rechts.",
     "tr": "من يسير في أقصى اليسار يتحرك إلى اليسار. والجميع الآخرون إلى اليمين."
    },
    {
     "de": "Keine Rettungsgasse kostet mindestens 200 Euro, zwei Punkte und einen Monat Fahrverbot.",
     "tr": "عدم فتح ممر الإنقاذ يكلّف 200 يورو على الأقل ونقطتين وشهرًا من منع القيادة."
    }
   ]
  }
 ],
