 "level": "A2–B1",
 "title": "Vorfahrt: Wer fährt zuerst?",
 "titleTr": "أولوية المرور: من يمرّ أولًا؟",
 "intro": "أهم موضوع في النظري: من يعبر التقاطع أولًا. استمع إلى القواعد، واضغط على الكلمات، واختبر نفسك بالإشارات في النهاية.",
 "sections": [
  {
   "title": "اليمين قبل اليسار",
   "lines": [
    {
     "de": "An einer Kreuzung ohne Ampel und ohne Schilder gilt: rechts vor links.",
     "tr": "عند تقاطع بلا إشارة ضوئية وبلا لافتات تنطبق القاعدة: اليمين قبل اليسار."
    },
    {
     "de": "Wer von rechts kommt, darf zuerst fahren.",
     "tr": "من يأتي من اليمين يحق له المرور أولًا."
    },
    {
     "de": "Kommt ein Fahrzeug von rechts, müssen Sie warten.",
     "tr": "إذا جاءت مركبة من اليمين، فعليك أن تنتظر."
    },
    {
     "de": "Dieses Schild warnt: An der nächsten Kreuzung gilt rechts vor links.",
     "tr": "هذه اللافتة تحذّر: عند التقاطع القادم تنطبق قاعدة اليمين قبل اليسار.",
     "sign": "z102"
    }
   ]
  },
  {
   "title": "لافتات الأولوية",
   "lines": [
    {
     "de": "Dieses Schild bedeutet: Vorfahrt gewähren. Lassen Sie die Fahrzeuge auf der anderen Straße zuerst fahren.",
     "tr": "هذه اللافتة تعني: أفسح الطريق. اترك المركبات على الطريق الآخر تمرّ أولًا.",
     "sign": "z205"
    },
    {
     "de": "Am Stoppschild müssen Sie immer anhalten, auch wenn die Straße frei ist.",
     "tr": "عند لافتة التوقف يجب أن تتوقف دائمًا، حتى لو كان الطريق خاليًا.",
     "sign": "z206"
    },
    {
     "de": "Dieses Schild gilt nur an der nächsten Kreuzung. Dort haben Sie Vorfahrt.",
     "tr": "هذه اللافتة سارية عند التقاطع القادم فقط. هناك لك أولوية المرور.",
     "sign": "z301"
    },
    {
     "de": "Auf einer Vorfahrtstraße haben Sie an allen Kreuzungen Vorfahrt.",
     "tr": "على الطريق ذي الأولوية لك أولوية المرور عند كل التقاطعات.",
     "sign": "z306"
    },
    {
     "de": "Hier endet die Vorfahrtstraße. Danach gilt wieder rechts vor links, wenn kein anderes Schild steht.",
     "tr": "هنا ينتهي الطريق ذو الأولوية. بعده تنطبق من جديد قاعدة اليمين قبل اليسار، إن لم توجد لافتة أخرى.",
     "sign": "z307"
    }
   ]
  },
  {
   "title": "ما الأهم",
   "lines": [
    {
     "de": "Die Zeichen der Polizei sind wichtiger als die Ampel.",
     "tr": "إشارات الشرطة أهم من الإشارة الضوئية."
    },
    {
     "de": "Die Ampel ist wichtiger als die Verkehrszeichen.",
     "tr": "الإشارة الضوئية أهم من لافتات المرور."
    },
    {
     "de": "Die Verkehrszeichen sind wichtiger als die Regel rechts vor links.",
     "tr": "لافتات المرور أهم من قاعدة اليمين قبل اليسار."
    }
   ]
  },
  {
   "title": "الانعطاف يسارًا",
   "lines": [
    {
     "de": "Wer links abbiegt, muss den Gegenverkehr zuerst durchfahren lassen.",
     "tr": "من ينعطف يسارًا عليه أن يترك حركة السير المقابلة تمرّ أولًا."
    },
    {
     "de": "Blinken Sie rechtzeitig, damit die anderen wissen, wohin Sie fahren.",
     "tr": "شغّل إشارة الانعطاف مبكرًا، حتى يعرف الآخرون إلى أين تتجه."
    }
   ]
  }
 ],
