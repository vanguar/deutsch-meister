{
 "id": "t-02",
 "kind": "theory",
 "emoji": "🚸",
 "level": "A2–B1",
 "title": "Verkehrszeichen und Ampeln",
 "titleTr": "لافتات المرور والإشارات الضوئية",
 "intro": "أنواع اللافتات، وما هو ممنوع، وكيف تتغيّر السرعة داخل المدن، وماذا تعني إشارات المرور الضوئية في ألمانيا — بما في ذلك الأحمر مع الأصفر ولوحة السهم الأخضر.",
 "sections": [
  {
   "title": "ثلاثة أنواع من اللافتات",
   "lines": [
    {
     "de": "Gefahrzeichen sind Dreiecke mit rotem Rand. Sie warnen vor einer Gefahr.",
     "tr": "لافتات الخطر مثلثات بحافة حمراء. إنها تحذّر من خطر.",
     "sign": "z101"
    },
    {
     "de": "Vorschriftzeichen sind meistens rund. Sie verbieten oder erlauben etwas.",
     "tr": "لافتات الأوامر غالبًا ما تكون دائرية. إنها تمنع شيئًا أو تسمح به.",
     "sign": "z267"
    },
    {
     "de": "Richtzeichen sind meistens eckig. Sie geben Hinweise, zum Beispiel zum Zebrastreifen.",
     "tr": "لافتات الإرشاد غالبًا ما تكون مستطيلة. إنها تعطي معلومات، مثلًا عن ممر المشاة.",
     "sign": "z350"
    }
   ]
  },
  {
   "title": "الممنوعات",
   "lines": [
    {
     "de": "In diese Straße dürfen Sie nicht hineinfahren.",
     "tr": "لا يجوز لك دخول هذا الشارع.",
     "sign": "z267"
    },
    {
     "de": "Hier dürfen Sie höchstens dreißig Kilometer pro Stunde fahren.",
     "tr": "هنا يجوز لك القيادة بسرعة ثلاثين كيلومترًا في الساعة كحدّ أقصى.",
     "sign": "z274"
    },
    {
     "de": "Hier dürfen Sie keine anderen Autos überholen.",
     "tr": "هنا لا يجوز لك تجاوز السيارات الأخرى.",
     "sign": "z276"
    },
    {
     "de": "Absolutes Haltverbot: Hier dürfen Sie nicht einmal kurz halten.",
     "tr": "ممنوع التوقف تمامًا: لا يجوز لك هنا التوقف ولو لحظة.",
     "sign": "z283"
    },
    {
     "de": "Eingeschränktes Haltverbot: Sie dürfen höchstens drei Minuten halten oder kurz zum Ein- und Aussteigen.",
     "tr": "التوقف مقيّد: يجوز لك التوقف ثلاث دقائق كحدّ أقصى أو لحظة للصعود والنزول.",
     "o": {
      "ein": "ein>einsteigen"
     },
     "sign": "z286"
    }
   ]
  },
  {
   "title": "داخل المدن والبلدات",
   "lines": [
    {
     "de": "Ab dem gelben Ortsschild gilt innerorts fünfzig Kilometer pro Stunde.",
     "tr": "ابتداءً من لوحة اسم البلدة الصفراء تكون السرعة داخل البلدة خمسين كيلومترًا في الساعة.",
     "o": {
      "ab": "ab>ab"
     },
     "sign": "z310"
    },
    {
     "de": "Am Ortsende gilt außerorts höchstens hundert Kilometer pro Stunde.",
     "tr": "بعد لوحة نهاية البلدة تكون السرعة خارجها مئة كيلومتر في الساعة كحدّ أقصى.",
     "sign": "z311"
    },
    {
     "de": "In einer Tempo-30-Zone gilt überall höchstens dreißig. Meistens gilt dort rechts vor links.",
     "tr": "في منطقة السرعة 30 تكون السرعة ثلاثين كحدّ أقصى في كل مكان. وغالبًا تنطبق هناك قاعدة اليمين قبل اليسار.",
     "sign": "z2741"
    },
    {
     "de": "Im verkehrsberuhigten Bereich fahren Sie Schrittgeschwindigkeit. Kinder dürfen überall spielen.",
     "tr": "في المنطقة الهادئة تسير بسرعة المشي. ويحق للأطفال اللعب في كل مكان.",
     "sign": "z3251"
    },
    {
     "de": "Am Zebrastreifen haben Fußgänger Vorrang. Halten Sie an, wenn jemand über die Straße gehen will.",
     "tr": "عند ممر المشاة للمشاة الأولوية. توقّف إذا أراد أحد عبور الشارع.",
     "o": {
      "an": "an>anhalten",
      "halten": "halten>anhalten"
     },
     "sign": "z350"
    },
    {
     "de": "Achtung, Kinder! Fahren Sie hier besonders langsam und vorsichtig.",
     "tr": "انتبه، أطفال! قُد هنا ببطء وحذر شديدين.",
     "sign": "z136"
    }
   ]
  },
  {
   "title": "الإشارة الضوئية",
   "lines": [
    {
     "de": "Rot bedeutet: Halten Sie vor der Haltlinie an.",
     "tr": "الأحمر يعني: توقّف قبل خط التوقف.",
     "o": {
      "an": "an>anhalten",
      "halten": "halten>anhalten"
     }
    },
    {
     "de": "Rot und Gelb zusammen bedeutet: Gleich kommt Grün, aber Sie dürfen noch nicht fahren.",
     "tr": "الأحمر والأصفر معًا يعنيان: سيأتي الأخضر حالًا، لكن لا يجوز لك التحرك بعد."
    },
    {
     "de": "Gelb bedeutet: Halten Sie an, wenn das noch sicher möglich ist.",
     "tr": "الأصفر يعني: توقّف إن كان ذلك لا يزال ممكنًا بأمان.",
     "o": {
      "an": "an>anhalten",
      "halten": "halten>anhalten"
     }
    },
    {
     "de": "Bei Grün dürfen Sie fahren, aber achten Sie auf Fußgänger und Radfahrer.",
     "tr": "عند الأخضر يجوز لك التحرك، لكن انتبه للمشاة وراكبي الدراجات."
    },
    {
     "de": "Wer bei Rot fährt, zahlt mindestens neunzig Euro und bekommt einen Punkt in Flensburg.",
     "tr": "من يقود عند الأحمر يدفع تسعين يورو على الأقل ويحصل على نقطة مخالفة في فلنسبورغ."
    },
    {
     "de": "Ist die Ampel ausgefallen, gelten die Verkehrszeichen.",
     "tr": "إذا تعطّلت الإشارة الضوئية، تسري لافتات المرور."
    }
   ]
  },
  {
   "title": "السهم الأخضر",
   "lines": [
    {
     "de": "Der grüne Pfeil neben der Ampel ist ein Schild aus Metall, kein Licht.",
     "tr": "السهم الأخضر بجانب الإشارة لوحة معدنية، وليس ضوءًا.",
     "sign": "z720"
    },
    {
     "de": "Mit diesem Schild dürfen Sie bei Rot rechts abbiegen, aber nur nach einem vollständigen Halt.",
     "tr": "مع هذه اللوحة يجوز لك الانعطاف يمينًا عند الأحمر، لكن بعد توقف تام فقط."
    },
    {
     "de": "Fußgänger und Radfahrer mit Grün dürfen Sie dabei nicht behindern.",
     "tr": "ولا يجوز لك في أثناء ذلك إعاقة المشاة وراكبي الدراجات الذين إشارتهم خضراء."
    }
   ]
  }
 ],
