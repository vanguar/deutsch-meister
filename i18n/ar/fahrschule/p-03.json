{
 "id": "p-03",
 "kind": "dialog",
 "emoji": "🌫️",
 "level": "A2–B1",
 "title": "Auf der Landstraße",
 "titleTr": "على الطريق الريفي",
 "intro": "تقود إيرينا خارج المدينة لأول مرة: المسافة بأعمدة الإرشاد، والضباب، ثم الأوتوبان مع السرعة الموصى بها.",
 "speakers": {
  "A": {
   "name": "Fahrlehrer",
   "g": "m"
  },
  "B": {
   "name": "Iryna",
   "g": "f"
  }
 },
 "lines": [
  {
   "de": "Wir verlassen jetzt den Ort. Was gilt nach dem Ortsende?",
   "tr": "نحن نغادر البلدة الآن. ما الذي يسري بعد لوحة نهاية البلدة؟",
   "s": "A"
  },
  {
   "de": "Außerorts darf ich höchstens hundert fahren.",
   "tr": "خارج البلدة يجوز لي القيادة بسرعة مئة كحدّ أقصى.",
   "s": "B"
  },
  {
   "de": "Richtig. Vor uns fährt ein Lkw. Wie groß muss der Abstand sein?",
   "tr": "صحيح. أمامنا شاحنة. كم يجب أن تكون المسافة؟",
   "s": "A"
  },
  {
   "de": "Halber Tacho, also bei achtzig ungefähr vierzig Meter.",
   "tr": "نصف العداد، أي عند ثمانين نحو أربعين مترًا.",
   "s": "B"
  },
  {
   "de": "Gut. Und wie können Sie das schätzen?",
   "tr": "جيد. وكيف يمكنكِ تقدير ذلك؟",
   "s": "A"
  },
  {
   "de": "Mit den Leitpfosten. Sie stehen alle fünfzig Meter.",
   "tr": "بأعمدة الإرشاد. إنها موضوعة كل خمسين مترًا.",
   "s": "B"
  },
  {
   "de": "Sehr gut. Achtung, da vorne kommt Nebel.",
   "tr": "جيد جدًا. انتبهي، هناك ضباب في الأمام.",
   "s": "A"
  },
  {
   "de": "Ich sehe kaum etwas. Ich fahre langsamer und mache das Abblendlicht an.",
   "tr": "لا أكاد أرى شيئًا. أخفف السرعة وأشغّل الأضواء المنخفضة.",
   "o": {
    "an": "an>anmachen",
    "mache": "mache>anmachen"
   },
   "s": "B"
  },
  {
   "de": "Richtig. Unter fünfzig Metern Sicht dürfen Sie höchstens fünfzig fahren.",
   "tr": "صحيح. حين تقل الرؤية عن خمسين مترًا يجوز لكِ خمسون كحدّ أقصى.",
   "s": "A"
  },
  {
   "de": "Jetzt ist die Sicht wieder gut. Fahren wir gleich auf die Autobahn?",
   "tr": "الرؤية جيدة مرة أخرى الآن. هل سندخل الأوتوبان قريبًا؟",
   "s": "B"
  },
  {
   "de": "Ja. Dort gibt es kein allgemeines Tempolimit, aber wir fahren nicht schneller als hundertdreißig.",
   "tr": "نعم. هناك لا يوجد حدّ عام للسرعة، لكننا لن نتجاوز مئة وثلاثين.",
   "o": {
    "es": "es>es gibt"
   },
   "s": "A"
  },
  {
   "de": "Das ist die Richtgeschwindigkeit, oder?",
   "tr": "هذه هي السرعة الموصى بها، أليس كذلك؟",
   "s": "B"
  },
  {
   "de": "Genau. Und dort steht ein Blitzer. Wie schnell fahren wir gerade?",
   "tr": "تمامًا. وهناك كاميرا سرعة. بأي سرعة نسير الآن؟",
   "s": "A"
  },
  {
   "de": "Genau hundert. Hier ist hundert erlaubt, also alles in Ordnung.",
   "tr": "مئة بالضبط. المسموح هنا مئة، إذن كل شيء على ما يرام.",
   "s": "B"
  },
  {
   "de": "Prima! Sie fahren schon sehr sicher.",
   "tr": "ممتاز! أنتِ تقودين بثقة كبيرة الآن.",
   "s": "A"
  }
 ],
