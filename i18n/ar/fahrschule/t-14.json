{
 "id": "t-14",
 "kind": "theory",
 "emoji": "🎓",
 "level": "B1",
 "title": "Die Fahrprüfung",
 "titleTr": "امتحان رخصة القيادة",
 "intro": "كيف يسير الطريق إلى رخصة القيادة في ألمانيا: الرحلات الإلزامية في مدرسة القيادة، والامتحان النظري والعملي، والأخطاء الشائعة، وفترة الاختبار بعد الامتحان.",
 "sections": [
  {
   "title": "الطريق إلى الرخصة",
   "lines": [
    {
     "de": "Für den Führerschein der Klasse B brauchen Sie einen Sehtest und einen Kurs in Erster Hilfe.",
     "tr": "للحصول على رخصة الفئة B تحتاج إلى فحص النظر ودورة في الإسعافات الأولية."
    },
    {
     "de": "Mit dem Antrag gehen Sie zur Führerscheinstelle Ihrer Stadt.",
     "tr": "تذهب بالطلب إلى مكتب رخص القيادة في مدينتك."
    },
    {
     "de": "In der Fahrschule lernen Sie die Theorie und machen Fahrstunden.",
     "tr": "في مدرسة القيادة تتعلم النظرية وتأخذ دروس القيادة."
    },
    {
     "de": "Pflicht sind zwölf besondere Fahrten: fünf auf der Landstraße, vier auf der Autobahn und drei bei Dunkelheit.",
     "tr": "هناك اثنتا عشرة رحلة خاصة إلزامية: خمس على الطريق الريفي، وأربع على الطريق السريع، وثلاث في الظلام."
    },
    {
     "de": "Jede dieser Fahrten dauert 45 Minuten.",
     "tr": "تستغرق كل رحلة من هذه الرحلات 45 دقيقة."
    }
   ]
  },
  {
   "title": "الامتحان النظري",
   "lines": [
    {
     "de": "Die Theorieprüfung machen Sie am Computer, zum Beispiel beim TÜV oder bei der DEKRA.",
     "tr": "تجري الامتحان النظري على الحاسوب، مثلًا لدى TÜV أو DEKRA."
    },
    {
     "de": "Sie bekommen 30 Fragen. Jede Frage hat zwei bis fünf Fehlerpunkte.",
     "tr": "تحصل على 30 سؤالًا. لكل سؤال من نقطتين إلى خمس نقاط خطأ."
    },
    {
     "de": "Mit höchstens zehn Fehlerpunkten haben Sie bestanden.",
     "tr": "إذا لم تتجاوز نقاط الخطأ عشر نقاط فقد نجحت."
    },
    {
     "de": "Aber zwei falsche Antworten mit fünf Fehlerpunkten bedeuten: nicht bestanden.",
     "tr": "لكن إجابتين خاطئتين بخمس نقاط لكل منهما تعنيان: رسوب."
    },
    {
     "de": "Nach der Theorieprüfung haben Sie zwölf Monate Zeit für die praktische Prüfung.",
     "tr": "بعد الامتحان النظري لديك اثنا عشر شهرًا للامتحان العملي."
    }
   ]
  },
  {
   "title": "الامتحان العملي",
   "lines": [
    {
     "de": "Die praktische Prüfung dauert etwa 55 Minuten.",
     "tr": "يستغرق الامتحان العملي نحو 55 دقيقة."
    },
    {
     "de": "Hinten sitzt der Prüfer, neben Ihnen sitzt Ihr Fahrlehrer.",
     "tr": "في الخلف يجلس الممتحن، وبجانبك يجلس مدرّبك."
    },
    {
     "de": "Am Anfang zeigen Sie bei der Sicherheitskontrolle, wo Licht, Öl und Bremsanlage zu prüfen sind.",
     "tr": "في البداية تُظهر أثناء فحص السلامة أين يُفحص الضوء والزيت ونظام المكابح."
    },
    {
     "de": "Typische Aufgaben sind rückwärts Einparken, Umkehren und eine Gefahrbremsung.",
     "tr": "من المهام المعتادة: الركن إلى الخلف، والالتفاف، والكبح الطارئ."
    },
    {
     "de": "Einen Teil der Strecke fahren Sie selbstständig nach Schildern oder nach dem Navi.",
     "tr": "تقود جزءًا من الطريق بنفسك، حسب اللافتات أو حسب جهاز الملاحة."
    },
    {
     "de": "Haben Sie eine Anweisung nicht verstanden, fragen Sie einfach nach.",
     "tr": "إذا لم تفهم تعليمة ما، فاسأل مرة أخرى ببساطة.",
     "o": {
      "fragen": "fragen>nachfragen",
      "nach": "nach>nachfragen"
     }
    }
   ]
  },
  {
   "title": "أخطاء شائعة",
   "lines": [
    {
     "de": "Am Stoppschild halten Sie immer ganz an, auch wenn niemand kommt.",
     "tr": "عند لافتة «قف» توقف دائمًا توقفًا تامًا، حتى لو لم يأتِ أحد.",
     "o": {
      "an": "an>anhalten",
      "halten": "halten>anhalten"
     },
     "sign": "z206"
    },
    {
     "de": "Bei diesem Schild lassen Sie die anderen zuerst fahren.",
     "tr": "عند هذه اللافتة تترك الآخرين يمرّون أولًا.",
     "sign": "z205"
    },
    {
     "de": "Wer schneller als erlaubt fährt, fällt oft durch.",
     "tr": "من يقود أسرع من المسموح يرسب غالبًا.",
     "o": {
      "durch": "durch>durchfallen",
      "fällt": "fällt>durchfallen"
     },
     "sign": "z274"
    },
    {
     "de": "Im verkehrsberuhigten Bereich fahren Sie nur Schrittgeschwindigkeit.",
     "tr": "في المنطقة الهادئة مروريًا تقود بسرعة المشي فقط.",
     "sign": "z3251"
    },
    {
     "de": "Vergessen Sie den Schulterblick nicht: beim Abbiegen und beim Spurwechsel.",
     "tr": "لا تنسَ النظر من فوق الكتف: عند الانعطاف وعند تغيير المسار."
    }
   ]
  },
  {
   "title": "بعد الامتحان",
   "lines": [
    {
     "de": "Nach der Prüfung bekommen Sie den Führerschein auf Probe.",
     "tr": "بعد الامتحان تحصل على رخصة القيادة تحت الاختبار."
    },
    {
     "de": "Die Probezeit dauert zwei Jahre.",
     "tr": "تستمر فترة الاختبار سنتين."
    },
    {
     "de": "In der Probezeit und unter 21 Jahren gilt 0,0 Promille.",
     "tr": "في فترة الاختبار وتحت سن 21 يسري حدّ 0,0 في الألف."
    },
    {
     "de": "Nach einem schweren Verstoß dauert die Probezeit vier Jahre, und Sie müssen ein Aufbauseminar machen.",
     "tr": "بعد مخالفة خطيرة تصبح فترة الاختبار أربع سنوات، ويجب عليك حضور ندوة تأهيلية."
    },
    {
     "de": "Sind Sie durchgefallen, können Sie die Prüfung meistens nach zwei Wochen wiederholen.",
     "tr": "إذا رسبت، يمكنك عادةً إعادة الامتحان بعد أسبوعين."
    }
   ]
  }
 ],
