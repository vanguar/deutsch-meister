 "level": "A2–B1",
 "title": "Nachtfahrt im Herbst",
 "titleTr": "قيادة ليلية في الخريف",
 "intro": "تقود أوكسانا لأول مرة في المساء: الأضواء القصيرة والطويلة، ولافتة الحيوانات البرية، وغزال على الطريق، وضباب كثيف.",
 "speakers": {
  "A": {
   "name": "Fahrlehrer",
   "g": "m"
  },
  "B": {
   "name": "Oksana",
   "g": "f"
  }
 },
 "lines": [
  {
   "de": "Heute fahren wir in der Dämmerung. Welches Licht brauchen Sie?",
   "tr": "اليوم نقود عند الغسق. أي ضوء تحتاجين؟",
   "s": "A"
  },
  {
   "de": "Abblendlicht. Das Tagfahrlicht reicht nicht.",
   "tr": "الأضواء القصيرة. أضواء النهار لا تكفي.",
   "s": "B"
  },
  {
   "de": "Richtig. Jetzt sind wir auf der Landstraße, und es ist dunkel.",
   "tr": "صحيح. نحن الآن على الطريق الريفي، والجو مظلم.",
   "s": "A"
  },
  {
   "de": "Hier darf ich Fernlicht benutzen, wenn niemand entgegenkommt.",
   "tr": "هنا يجوز لي استخدام الأضواء الطويلة إذا لم تأتِ سيارة من الاتجاه المقابل.",
   "s": "B"
  },
  {
   "de": "Da vorne kommt ein Auto.",
   "tr": "هناك في الأمام سيارة قادمة.",
   "s": "A"
  },
  {
   "de": "Dann muss ich abblenden, damit ich den Fahrer nicht blende.",
   "tr": "إذن يجب أن أخفض الأضواء كي لا أُبهر السائق.",
   "s": "B"
  },
  {
   "de": "Gut. Achtung, das Schild dort warnt vor Wildwechsel.",
   "tr": "جيد. انتبهي، تلك اللافتة تحذّر من عبور الحيوانات البرية.",
   "s": "A"
  },
  {
   "de": "Ich fahre langsamer und schaue auch auf den Rand der Straße.",
   "tr": "أقود أبطأ وأنظر أيضًا إلى حافة الطريق.",
   "s": "B"
  },
  {
   "de": "Und wenn ein Reh auf der Straße steht?",
   "tr": "وإذا وقف غزال على الطريق؟",
   "s": "A"
  },
  {
   "de": "Abblenden, hupen, bremsen. Und nicht ausweichen.",
   "tr": "أخفض الأضواء، أستخدم البوق، أفرمل. ولا أنحرف جانبًا.",
   "s": "B"
  },
  {
   "de": "Sehr gut. Jetzt kommt dichter Nebel. Sie sehen den nächsten Leitpfosten nicht mehr.",
   "tr": "جيد جدًا. الآن يأتي ضباب كثيف. لم تعودي ترين عمود الإرشاد التالي.",
   "s": "A"
  },
  {
   "de": "Dann ist die Sichtweite unter 50 Metern. Ich fahre höchstens 50.",
   "tr": "إذن مدى الرؤية أقل من 50 مترًا. أقود بسرعة 50 كحدّ أقصى.",
   "s": "B"
  },
  {
   "de": "Und welches Licht schalten Sie jetzt ein?",
   "tr": "وأي ضوء تشغّلين الآن؟",
   "o": {
    "ein": "ein>einschalten",
    "schalten": "schalten>einschalten"
   },
   "s": "A"
  },
  {
   "de": "Die Nebelschlussleuchte. Wenn die Sicht wieder gut ist, schalte ich sie aus.",
   "tr": "ضوء الضباب الخلفي. وعندما تعود الرؤية جيدة أطفئه.",
   "o": {
    "aus": "aus>ausschalten",
    "schalte": "schalte>ausschalten"
   },
   "s": "B"
  },
  {
   "de": "Perfekt. So fahren Sie sicher durch die Nacht.",
   "tr": "ممتاز. هكذا تقودين بأمان في الليل.",
   "s": "A"
  }
 ],
