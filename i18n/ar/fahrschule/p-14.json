{
 "id": "p-14",
 "kind": "dialog",
 "emoji": "📋",
 "level": "B1",
 "title": "Die Prüfungsfahrt",
 "titleTr": "رحلة الامتحان",
 "intro": "تخوض أولينا الامتحان العملي: فحص السلامة، وتعليمات الممتحن، والركن، والكبح الطارئ — والرخصة في النهاية.",
 "speakers": {
  "A": {
   "name": "Prüfer",
   "g": "m"
  },
  "B": {
   "name": "Olena",
   "g": "f"
  }
 },
 "lines": [
  {
   "de": "Guten Tag, ich bin heute Ihr Prüfer. Ihren Ausweis, bitte.",
   "tr": "مرحبًا، أنا ممتحنك اليوم. بطاقة هويتك من فضلك.",
   "s": "A"
  },
  {
   "de": "Guten Tag. Hier, bitte. Ich bin ein bisschen nervös.",
   "tr": "مرحبًا. تفضّل. أنا متوترة قليلًا.",
   "s": "B"
  },
  {
   "de": "Das ist ganz normal. Zuerst die Sicherheitskontrolle: Wo prüfen Sie den Ölstand?",
   "tr": "هذا طبيعي تمامًا. أولًا فحص السلامة: أين تفحصين مستوى الزيت؟",
   "s": "A"
  },
  {
   "de": "Unter der Motorhaube. Hier ist der Messstab für das Öl.",
   "tr": "تحت غطاء المحرك. هذا هو مقياس الزيت.",
   "s": "B"
  },
  {
   "de": "Richtig. Dann fahren wir los. An der nächsten Kreuzung biegen Sie bitte rechts ab.",
   "tr": "صحيح. إذن لننطلق. عند التقاطع القادم انعطفي يمينًا من فضلك.",
   "o": {
    "ab": "ab>abbiegen",
    "biegen": "biegen>abbiegen",
    "fahren": "fahren>losfahren",
    "los": "los>losfahren"
   },
   "s": "A"
  },
  {
   "de": "Rechts, alles klar. Ich blinke, schaue in den Spiegel und über die Schulter.",
   "tr": "يمينًا، حسنًا. أشغّل الإشارة، وأنظر في المرآة ومن فوق الكتف.",
   "s": "B"
  },
  {
   "de": "Gut. Parken Sie bitte hinter dem blauen Auto rückwärts ein.",
   "tr": "جيد. اركني من فضلك إلى الخلف خلف السيارة الزرقاء.",
   "o": {
    "ein": "ein>einparken",
    "parken": "parken>einparken"
   },
   "s": "A"
  },
  {
   "de": "Fertig. Das Auto steht jetzt parallel zum Bordstein.",
   "tr": "انتهيت. السيارة الآن موازية للرصيف.",
   "s": "B"
  },
  {
   "de": "Sehr schön. Jetzt fahren Sie bitte selbstständig nach den Schildern Richtung Bahnhof.",
   "tr": "جميل جدًا. الآن قودي بنفسك من فضلك حسب اللافتات باتجاه محطة القطار.",
   "s": "A"
  },
  {
   "de": "Darf ich hier fünfzig fahren? Ach nein, das ist eine Tempo-30-Zone.",
   "tr": "هل يجوز لي القيادة هنا بسرعة خمسين؟ آه لا، هذه منطقة السرعة 30.",
   "s": "B"
  },
  {
   "de": "Genau. Gleich kommt die Gefahrbremsung. Wenn ich «Stopp» sage, bremsen Sie so stark wie möglich.",
   "tr": "بالضبط. الآن يأتي الكبح الطارئ. عندما أقول «قف» اكبحي بأقصى قوة ممكنة.",
   "s": "A"
  },
  {
   "de": "Verstanden. Ich schaue vorher noch in den Spiegel.",
   "tr": "فهمت. سأنظر في المرآة قبل ذلك.",
   "s": "B"
  },
  {
   "de": "Stopp! … Sehr gut, das Auto stand sofort. Fahren Sie bitte zurück zur Fahrschule.",
   "tr": "قف! … جيد جدًا، توقفت السيارة فورًا. عودي من فضلك إلى مدرسة القيادة.",
   "s": "A"
  },
  {
   "de": "Und? Habe ich bestanden?",
   "tr": "وماذا؟ هل نجحت؟",
   "s": "B"
  },
  {
   "de": "Herzlichen Glückwunsch, Sie haben bestanden! Hier ist Ihr Führerschein.",
   "tr": "تهانينا، لقد نجحتِ! هذه رخصة قيادتك.",
   "s": "A"
  },
  {
   "de": "Vielen Dank! Ich weiß: zwei Jahre Probezeit und kein Alkohol am Steuer.",
   "tr": "شكرًا جزيلًا! أعرف: سنتان فترة اختبار ولا كحول أثناء القيادة.",
   "s": "B"
  }
 ],
