 "level": "A2",
 "title": "Die erste Fahrstunde",
 "titleTr": "الدرس الأول في القيادة",
 "intro": "تجلس أولينا خلف المقود لأول مرة مع المدرّب: المقعد والمرايا، ثم الانطلاق وأول انعطاف.",
 "speakers": {
  "A": {
   "name": "Fahrlehrer",
   "g": "m"
  },
  "B": {
   "name": "Olena",
   "g": "f"
  }
 },
 "lines": [
  {
   "de": "Guten Tag, Frau Kovalenko! Sind Sie bereit für Ihre erste Fahrstunde?",
   "tr": "مرحبًا يا سيدة كوفالينكو! هل أنتِ مستعدة لدرسك الأول في القيادة؟",
   "s": "A"
  },
  {
   "de": "Guten Tag! Ja, aber ich bin ein bisschen nervös.",
   "tr": "مرحبًا! نعم، لكنني متوترة قليلًا.",
   "s": "B"
  },
  {
   "de": "Das ist ganz normal. Stellen Sie zuerst den Sitz und die Spiegel ein.",
   "tr": "هذا طبيعي تمامًا. اضبطي أولًا المقعد والمرايا.",
   "o": {
    "ein": "ein>einstellen",
    "stellen": "stellen>einstellen"
   },
   "s": "A"
  },
  {
   "de": "So, jetzt sehe ich alles gut.",
   "tr": "هكذا، الآن أرى كل شيء جيدًا.",
   "s": "B"
  },
  {
   "de": "Sehr gut. Schnallen Sie sich bitte an.",
   "tr": "جيد جدًا. اربطي حزام الأمان من فضلك.",
   "o": {
    "an": "an>anschnallen"
   },
   "s": "A"
  },
  {
   "de": "Ich bin angeschnallt. Was mache ich jetzt?",
   "tr": "ربطتُ الحزام. ماذا أفعل الآن؟",
   "s": "B"
  },
  {
   "de": "Treten Sie die Kupplung und starten Sie den Motor.",
   "tr": "اضغطي على دواسة القابض وشغّلي المحرك.",
   "s": "A"
  },
  {
   "de": "Der Motor läuft. Kann ich losfahren?",
   "tr": "المحرك يعمل. هل يمكنني الانطلاق؟",
   "s": "B"
  },
  {
   "de": "Noch nicht. Schauen Sie in den Spiegel und machen Sie den Schulterblick.",
   "tr": "ليس بعد. انظري في المرآة ثم التفتي فوق كتفك.",
   "s": "A"
  },
  {
   "de": "Hinten ist alles frei. Ich blinke links.",
   "tr": "الطريق خلفي خالٍ. أشغّل إشارة اليسار.",
   "s": "B"
  },
  {
   "de": "Genau. Lassen Sie jetzt langsam die Kupplung kommen und geben Sie etwas Gas.",
   "tr": "تمامًا. الآن ارفعي قدمك عن القابض ببطء واضغطي على البنزين قليلًا.",
   "o": {
    "geben": "geben>Gas geben",
    "kommen": "kommen>kommen lassen",
    "lassen": "lassen>kommen lassen"
   },
   "s": "A"
  },
  {
   "de": "Das Auto fährt! Wie schnell darf ich hier fahren?",
   "tr": "السيارة تتحرك! ما السرعة المسموح بها هنا؟",
   "s": "B"
  },
  {
   "de": "Wir sind innerorts, also höchstens fünfzig. An der nächsten Kreuzung biegen Sie rechts ab.",
   "tr": "نحن داخل المدينة، إذن خمسون كحد أقصى. عند التقاطع القادم انعطفي يمينًا.",
   "s": "A"
  },
  {
   "de": "Ich blinke rechts, bremse und achte auf Fußgänger.",
   "tr": "أشغّل إشارة اليمين، وأخفف السرعة، وأنتبه للمشاة.",
   "s": "B"
  },
  {
   "de": "Prima! Für die erste Stunde fahren Sie schon sehr gut.",
   "tr": "ممتاز! بالنسبة للدرس الأول، تقودين جيدًا جدًا.",
   "s": "A"
  }
 ],
