{
 "id": "t-11",
 "kind": "theory",
 "emoji": "🛣️",
 "level": "B1",
 "title": "Autobahn und Kraftfahrstraße",
 "titleTr": "الطريق السريع وطريق السيارات",
 "intro": "من يُسمح له بدخول الطريق السريع، وكيف تدخله وتخرج منه، وما الممنوع عليه، وماذا تفعل إذا فاتك المخرج.",
 "sections": [
  {
   "title": "من يُسمح له بدخول الطريق السريع",
   "lines": [
    {
     "de": "Auf der Autobahn dürfen nur Kraftfahrzeuge fahren, die schneller als 60 km/h fahren können.",
     "tr": "لا يُسمح على الطريق السريع إلا للمركبات التي تستطيع السير بأسرع من 60 كم/س.",
     "sign": "z3301"
    },
    {
     "de": "Fußgänger, Radfahrer und Mofas sind auf der Autobahn verboten.",
     "tr": "يُمنع المشاة وراكبو الدراجات والدراجات النارية الصغيرة من الطريق السريع."
    },
    {
     "de": "Dieses Schild zeigt eine Kraftfahrstraße. Dort gelten fast dieselben Regeln wie auf der Autobahn.",
     "tr": "هذه اللافتة تدل على طريق مخصص للسيارات. تسري عليه تقريبًا قواعد الطريق السريع نفسها.",
     "sign": "z3311"
    },
    {
     "de": "Hier endet die Autobahn. Danach gelten wieder die normalen Tempolimits.",
     "tr": "هنا ينتهي الطريق السريع. بعده تعود حدود السرعة العادية.",
     "sign": "z3302"
    }
   ]
  },
  {
   "title": "الدخول إلى الطريق السريع",
   "lines": [
    {
     "de": "Auf dem Beschleunigungsstreifen beschleunigen Sie auf die Geschwindigkeit des Verkehrs.",
     "tr": "على مسار التسارع زِد سرعتك حتى تصل إلى سرعة حركة السير."
    },
    {
     "de": "Der Verkehr auf der Autobahn hat Vorfahrt.",
     "tr": "حركة السير على الطريق السريع لها الأولوية."
    },
    {
     "de": "Blinken Sie links und fädeln Sie in eine passende Lücke ein.",
     "tr": "شغّل إشارة اليسار وادخل في فراغ مناسب بين السيارات.",
     "o": {
      "ein": "ein>einfädeln",
      "fädeln": "fädeln>einfädeln"
     }
    },
    {
     "de": "Fährt neben Ihnen ein Lkw, bremsen Sie leicht ab und fahren hinter ihm auf.",
     "tr": "إذا كانت شاحنة تسير بجانبك فخفّف السرعة قليلًا وادخل خلفها.",
     "o": {
      "ab": "ab>abbremsen",
      "auf": "auf>auffahren",
      "bremsen": "bremsen>abbremsen",
      "fahren": "fahren>auffahren"
     }
    }
   ]
  },
  {
   "title": "ما الممنوع على الطريق السريع",
   "lines": [
    {
     "de": "Wenden und Rückwärtsfahren sind auf der Autobahn streng verboten.",
     "tr": "الالتفاف والرجوع إلى الخلف ممنوعان منعًا باتًّا على الطريق السريع."
    },
    {
     "de": "Haben Sie die Ausfahrt verpasst, fahren Sie bis zur nächsten Ausfahrt weiter.",
     "tr": "إذا فاتك المخرج فتابع القيادة حتى المخرج التالي.",
     "o": {
      "fahren": "fahren>weiterfahren",
      "weiter": "weiter>weiterfahren"
     }
    },
    {
     "de": "Halten und Parken sind verboten, auch auf dem Seitenstreifen.",
     "tr": "التوقف والركن ممنوعان، حتى على كتف الطريق."
    },
    {
     "de": "Nur bei einer Panne dürfen Sie auf dem Seitenstreifen halten.",
     "tr": "لا يجوز لك التوقف على كتف الطريق إلا عند حدوث عطل."
    },
    {
     "de": "Dieses Schild schreibt eine Mindestgeschwindigkeit vor. Langsamer dürfen Sie hier nicht fahren.",
     "tr": "هذه اللافتة تفرض حدًّا أدنى للسرعة. لا يجوز لك هنا أن تسير أبطأ منه.",
     "o": {
      "schreibt": "schreibt>vorschreiben",
      "vor": "vor>vorschreiben"
     },
     "sign": "z275"
    }
   ]
  },
  {
   "title": "الخروج من الطريق السريع",
   "lines": [
    {
     "de": "Diese Baken stehen 300, 200 und 100 Meter vor der Ausfahrt.",
     "tr": "هذه اللوحات توضع قبل المخرج بـ300 و200 و100 متر.",
     "sign": "z450"
    },
    {
     "de": "Wechseln Sie rechtzeitig auf den rechten Fahrstreifen und blinken Sie rechts.",
     "tr": "انتقل مبكرًا إلى المسار الأيمن وشغّل إشارة اليمين."
    },
    {
     "de": "Bremsen Sie erst auf dem Verzögerungsstreifen.",
     "tr": "لا تفرمل إلا على مسار التباطؤ."
    },
    {
     "de": "Dieses Schild zeigt, wo die Ausfahrt beginnt.",
     "tr": "هذه اللافتة تبيّن أين يبدأ المخرج.",
     "sign": "z333"
    },
    {
     "de": "Nach der Autobahn wirken 80 km/h oft sehr langsam. Schauen Sie auf den Tacho.",
     "tr": "بعد الطريق السريع تبدو سرعة 80 كم/س غالبًا بطيئة جدًّا. انظر إلى عداد السرعة."
    }
   ]
  },
  {
   "title": "الشاحنات والازدحام والاستراحة",
   "lines": [
    {
     "de": "Lkw über 3,5 Tonnen dürfen auf der Autobahn höchstens 80 km/h fahren.",
     "tr": "الشاحنات التي يزيد وزنها على 3,5 طن لا يجوز لها على الطريق السريع تجاوز 80 كم/س."
    },
    {
     "de": "Am Stauende dürfen Sie das Warnblinklicht einschalten, um den Verkehr hinter sich zu warnen.",
     "tr": "عند نهاية الازدحام يجوز لك تشغيل أضواء التحذير لتنبيه السيارات خلفك."
    },
    {
     "de": "Auf langen Fahrten machen Sie Pause auf einem Rastplatz oder an einer Raststätte.",
     "tr": "في الرحلات الطويلة خذ استراحة في موقف استراحة أو في محطة خدمة."
    }
   ]
  }
 ],
