 "level": "B1",
 "title": "Alkohol, Müdigkeit und Ablenkung",
 "titleTr": "الكحول والتعب وتشتت الانتباه",
 "intro": "حدود الكحول في ألمانيا (0,5 ‰ و0,0 ‰ للمبتدئين)، والقنب والأدوية، والتعب أثناء القيادة والهاتف: ما الممنوع وكم يكلّف.",
 "sections": [
  {
   "title": "الكحول: الحدود",
   "lines": [
    {
     "de": "Ab 0,5 Promille ist Autofahren verboten: 500 Euro Bußgeld, zwei Punkte und ein Monat Fahrverbot.",
     "tr": "ابتداءً من 0,5 في الألف تُمنع القيادة: غرامة 500 يورو ونقطتان وشهر من منع القيادة."
    },
    {
     "de": "Schon ab 0,3 Promille ist es eine Straftat, wenn Sie unsicher fahren oder einen Unfall haben.",
     "tr": "ابتداءً من 0,3 في الألف تُعدّ جريمة إذا قدت بشكل غير آمن أو تسببت في حادث."
    },
    {
     "de": "Ab 1,1 Promille sind Sie absolut fahruntüchtig und verlieren den Führerschein.",
     "tr": "ابتداءً من 1,1 في الألف تكون غير قادر على القيادة تمامًا وتفقد رخصتك."
    },
    {
     "de": "In der Probezeit und unter 21 Jahren gilt: 0,0 Promille.",
     "tr": "في فترة الاختبار وتحت سن 21 عامًا يسري: 0,0 في الألف."
    }
   ]
  },
  {
   "title": "الكحول يزول ببطء",
   "lines": [
    {
     "de": "Der Körper baut Alkohol nur langsam ab: etwa 0,1 Promille pro Stunde.",
     "tr": "يتخلص الجسم من الكحول ببطء: نحو 0,1 في الألف في الساعة.",
     "o": {
      "ab": "ab>abbauen",
      "baut": "baut>abbauen"
     }
    },
    {
     "de": "Kaffee oder eine kalte Dusche helfen nicht. Nur die Zeit hilft.",
     "tr": "القهوة أو الدش البارد لا يفيدان. الوقت وحده يفيد."
    },
    {
     "de": "Auch am Morgen nach einer Party kann noch Restalkohol im Blut sein.",
     "tr": "حتى في الصباح بعد حفلة قد يبقى كحول متبقٍّ في الدم."
    }
   ]
  },
  {
   "title": "القنب والأدوية",
   "lines": [
    {
     "de": "Für Cannabis gilt ein Grenzwert von 3,5 Nanogramm THC pro Milliliter Blutserum.",
     "tr": "للقنب حدّ مسموح هو 3,5 نانوغرام من THC لكل ملليلتر من مصل الدم."
    },
    {
     "de": "In der Probezeit und unter 21 Jahren ist Cannabis am Steuer ganz verboten.",
     "tr": "في فترة الاختبار وتحت سن 21 عامًا يُمنع القنب أثناء القيادة تمامًا."
    },
    {
     "de": "Cannabis zusammen mit Alkohol ist am Steuer streng verboten.",
     "tr": "القنب مع الكحول ممنوع منعًا باتًّا أثناء القيادة."
    },
    {
     "de": "Manche Medikamente machen müde. Lesen Sie den Beipackzettel.",
     "tr": "بعض الأدوية تسبب النعاس. اقرأ النشرة المرفقة بالدواء."
    }
   ]
  },
  {
   "title": "التعب",
   "lines": [
    {
     "de": "Zwei Sekunden Sekundenschlaf bei 100 km/h sind über 50 Meter Blindflug.",
     "tr": "ثانيتان من الغفوة الخاطفة بسرعة 100 كم/س تعنيان أكثر من 50 مترًا دون رؤية."
    },
    {
     "de": "Machen Sie auf langen Fahrten alle zwei Stunden eine Pause.",
     "tr": "في الرحلات الطويلة خذ استراحة كل ساعتين."
    },
    {
     "de": "Sind Sie müde, schlafen Sie auf einem Parkplatz 15 bis 20 Minuten.",
     "tr": "إذا كنت متعبًا فنم في موقف للسيارات من 15 إلى 20 دقيقة."
    },
    {
     "de": "Ein offenes Fenster oder laute Musik helfen nur kurz.",
     "tr": "النافذة المفتوحة أو الموسيقى الصاخبة تفيد لوقت قصير فقط."
    }
   ]
  },
  {
   "title": "الهاتف أثناء القيادة",
   "lines": [
    {
     "de": "Beim Fahren dürfen Sie das Handy nicht in die Hand nehmen.",
     "tr": "لا يجوز لك أثناء القيادة أن تمسك الهاتف بيدك."
    },
    {
     "de": "Das kostet 100 Euro und einen Punkt in Flensburg.",
     "tr": "هذا يكلّف 100 يورو ونقطة واحدة في فلنسبورغ."
    },
    {
     "de": "Auch an der roten Ampel mit laufendem Motor ist das Handy tabu.",
     "tr": "حتى عند الإشارة الحمراء والمحرك يعمل يُمنع الهاتف."
    },
    {
     "de": "Eine Freisprecheinrichtung ist erlaubt.",
     "tr": "جهاز التحدث دون استخدام اليدين مسموح."
    }
   ]
  }
 ],
