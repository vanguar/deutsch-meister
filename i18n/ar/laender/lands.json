     ],
     "a": 0,
     "why": "تسوغشبيتسه في جبال الألب البافارية — 2962 مترًا."
    },
    {
     "q": "منذ أي عام يُقام مهرجان أكتوبر؟",
     "opts": [
      "1516",
      "1810",
      "1949"
     ],
     "a": 1,
     "why": "بدأ بزفاف ولي العهد لودفيغ والأميرة تيريزا عام 1810."
    },
    {
     "q": "أين يشارك حزب CSU في الانتخابات؟",
     "opts": [
      "في بافاريا فقط",
      "في كل ألمانيا",
      "في بافاريا والنمسا"
     ],
     "a": 0,
     "why": "يترشح CSU في بافاريا فقط، ولا يترشح CDU في بافاريا."
    },
    {
     "q": "كيف يُكتب اسم اللهجة البافارية؟",
     "opts": [
      "Bayerisch",
      "Bairisch"
     ],
     "a": 1,
     "why": "«Bairisch» بحرف i هي اللهجة؛ «bayerisch» بحرف y هي كل ما يخص الولاية."
    },
    {
     "q": "ماذا يمكن أن تفعل في كثير من حدائق البيرة البافارية؟",
     "opts": [
      "أن تحضر طعامك معك",
      "ألا تدفع ثمن المشروبات",
      "أن تجلس بالزي الشعبي فقط"
     ],
     "a": 0,
     "why": "إحضار «Brotzeit» الخاصة بك تقليد قديم، خاصة في بافاريا العليا وفرانكونيا؛ أما المشروبات فتُشترى في المكان."
    },
    {
     "q": "ما دور بافاريا في التسوية المالية بين الولايات منذ 2008؟",
     "opts": [
      "تحصل على أكثر من الجميع",
      "تدفع أكثر من الجميع",
      "لا تشارك"
     ],
     "a": 1,
     "why": "حتى 1985 كانت بافاريا تحصل على المال، ومنذ 1987 أصبحت مانحة، ومنذ 2008 تدفع أكثر من الجميع."
    }
